  "name": "Sports Live",
  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: orange; icon-glyph: trophy;\n// ============================================================\n// Sports Live v0.3.3\n// CaseyCZ Scriptable Apps\n// Single-team live widget using the same multi-provider data layer as Sports Info.\n// Settings and widget visual system follow the CaseyCZ / Homebridge Status style.\n// ============================================================\n\nconst APP_NAME = \"Sports Live\";\nconst APP_VERSION = \"0.3.3\";\nconst SETTINGS_FILE = \"SportsLive_settings.json\";\nconst CACHE_FILE = \"SportsLive_cache.json\";\nconst API_TIMEOUT = 7;\nconst UPDATE_SOURCE_URL = \"https://raw.githubusercontent.com/CaseyCZ/Scriptable/Master/apps/Sports-Live/Sports%20Live.js\";\nconst UPDATE_MIN_BYTES = 22000;\n\nconst SPORTS = [\n  {id:\"football\",icon:\"⚽\",cs:\"Fotbal\",en:\"Football\",de:\"Fußball\",es:\"Fútbol\",leagues:[\n    {id:\"cze.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"cze.1\",fm:122,ofCompetition:159,ofSeason:39284,ccode:\"CZE\",flag:\"🇨🇿\",cs:\"Chance Liga\",en:\"Czech First League\",de:\"Tschechische Liga\",es:\"Liga Checa\"},\n    {id:\"eng.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"eng.1\",fm:47,ofCompetition:9,ofSeason:39301,ccode:\"ENG\",flag:\"🇬🇧\",cs:\"Premier League\",en:\"Premier League\",de:\"Premier League\",es:\"Premier League\"},\n    {id:\"esp.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"esp.1\",fm:87,ofCompetition:10,ofSeason:39319,ccode:\"ESP\",flag:\"🇪🇸\",cs:\"LaLiga\",en:\"LaLiga\",de:\"LaLiga\",es:\"LaLiga\"},\n    {id:\"ger.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"ger.1\",fm:54,ofCompetition:1,ofSeason:39285,ccode:\"GER\",flag:\"🇩🇪\",cs:\"Bundesliga\",en:\"Bundesliga\",de:\"Bundesliga\",es:\"Bundesliga\"},\n    {id:\"ita.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"ita.1\",fm:55,ofCompetition:13,ofSeason:39325,ccode:\"ITA\",flag:\"🇮🇹\",cs:\"Serie A\",en:\"Serie A\",de:\"Serie A\",es:\"Serie A\"},\n    {id:\"fra.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"fra.1\",fm:53,ofCompetition:23,ofSeason:39245,ccode:\"FRA\",flag:\"🇫🇷\",cs:\"Ligue 1\",en:\"Ligue 1\",de:\"Ligue 1\",es:\"Ligue 1\"},\n    {id:\"uefa.champions\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"uefa.champions\",fm:42,ofCompetition:5,ofSeason:39356,ccode:\"INT\",flag:\"🇪🇺\",cs:\"Liga mistrů\",en:\"Champions League\",de:\"Champions League\",es:\"Champions League\"},\n    {id:\"uefa.europa\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"uefa.europa\",fm:73,ofCompetition:7,ofSeason:39357,ccode:\"INT\",flag:\"🇪🇺\",cs:\"Evropská liga\",en:\"Europa League\",de:\"Europa League\",es:\"Europa League\"}\n  ]},\n  {id:\"hockey\",icon:\"🏒\",cs:\"Hokej\",en:\"Hockey\",de:\"Eishockey\",es:\"Hockey\",leagues:[\n    {id:\"nhl\",provider:\"espn\",espnSport:\"hockey\",espnLeague:\"nhl\",flag:\"🇺🇸\",cs:\"NHL\",en:\"NHL\",de:\"NHL\",es:\"NHL\"},\n    {id:\"hockey.cz\",provider:\"livesport\",lsPath:\"/hockey/czech-republic/extraliga/\",flag:\"🇨🇿\",cs:\"Tipsport Extraliga\",en:\"Czech Extraliga\",de:\"Tschechische Extraliga\",es:\"Extraliga Checa\"},\n    {id:\"hockey.se\",provider:\"livesport\",lsPath:\"/hockey/sweden/shl/\",flag:\"🇸🇪\",cs:\"SHL\",en:\"SHL\",de:\"SHL\",es:\"SHL\"},\n    {id:\"hockey.fi\",provider:\"livesport\",lsPath:\"/hockey/finland/liiga/\",flag:\"🇫🇮\",cs:\"Liiga\",en:\"Liiga\",de:\"Liiga\",es:\"Liiga\"},\n    {id:\"hockey.ch\",provider:\"livesport\",lsPath:\"/hockey/switzerland/national-league/\",flag:\"🇨🇭\",cs:\"National League\",en:\"National League\",de:\"National League\",es:\"National League\"},\n    {id:\"hockey.chl\",provider:\"livesport\",lsPath:\"/hockey/europe/champions-league/\",flag:\"🇪🇺\",cs:\"Champions Hockey League\",en:\"Champions Hockey League\",de:\"Champions Hockey League\",es:\"Champions Hockey League\"},\n    {id:\"hockey.wc\",provider:\"livesport\",lsPath:\"/hockey/world/world-championship/\",flag:\"🌍\",cs:\"Mistrovství světa\",en:\"World Championship\",de:\"Weltmeisterschaft\",es:\"Mundial\"},\n    {id:\"ncaa-hockey-men\",provider:\"espn\",espnSport:\"hockey\",espnLeague:\"mens-college-hockey\",flag:\"🇺🇸\",cs:\"NCAA muži\",en:\"NCAA Men\",de:\"NCAA Männer\",es:\"NCAA Hombres\"},\n    {id:\"ncaa-hockey-women\",provider:\"espn\",espnSport:\"hockey\",espnLeague:\"womens-college-hockey\",flag:\"🇺🇸\",cs:\"NCAA ženy\",en:\"NCAA Women\",de:\"NCAA Frauen\",es:\"NCAA Mujeres\"}\n  ]},\n  {id:\"basketball\",icon:\"🏀\",cs:\"Basketbal\",en:\"Basketball\",de:\"Basketball\",es:\"Baloncesto\",leagues:[\n    {id:\"nba\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"nba\",flag:\"🇺🇸\",cs:\"NBA\",en:\"NBA\",de:\"NBA\",es:\"NBA\"},\n    {id:\"wnba\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"wnba\",flag:\"🇺🇸\",cs:\"WNBA\",en:\"WNBA\",de:\"WNBA\",es:\"WNBA\"},\n    {id:\"basketball.euroleague\",provider:\"livesport\",lsPath:\"/basketball/europe/euroleague/\",flag:\"🇪🇺\",cs:\"EuroLeague\",en:\"EuroLeague\",de:\"EuroLeague\",es:\"EuroLeague\"},\n    {id:\"basketball.eurocup\",provider:\"livesport\",lsPath:\"/basketball/europe/eurocup/\",flag:\"🇪🇺\",cs:\"EuroCup\",en:\"EuroCup\",de:\"EuroCup\",es:\"EuroCup\"},\n    {id:\"basketball.cz\",provider:\"livesport\",lsPath:\"/basketball/czech-republic/nbl/\",flag:\"🇨🇿\",cs:\"NBL\",en:\"Czech NBL\",de:\"Tschechische NBL\",es:\"NBL Checa\"},\n    {id:\"basketball.es\",provider:\"livesport\",lsPath:\"/basketball/spain/acb/\",flag:\"🇪🇸\",cs:\"ACB\",en:\"ACB\",de:\"ACB\",es:\"ACB\"},\n    {id:\"basketball.de\",provider:\"livesport\",lsPath:\"/basketball/germany/bbl/\",flag:\"🇩🇪\",cs:\"BBL\",en:\"BBL\",de:\"BBL\",es:\"BBL\"},\n    {id:\"basketball.fr\",provider:\"livesport\",lsPath:\"/basketball/france/lnb/\",flag:\"🇫🇷\",cs:\"LNB\",en:\"LNB\",de:\"LNB\",es:\"LNB\"},\n    {id:\"ncaa-basketball-men\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"mens-college-basketball\",flag:\"🇺🇸\",cs:\"NCAA muži\",en:\"NCAA Men\",de:\"NCAA Männer\",es:\"NCAA Hombres\"},\n    {id:\"ncaa-basketball-women\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"womens-college-basketball\",flag:\"🇺🇸\",cs:\"NCAA ženy\",en:\"NCAA Women\",de:\"NCAA Frauen\",es:\"NCAA Mujeres\"}\n  ]},\n  {id:\"floorball\",icon:\"🥅\",cs:\"Florbal\",en:\"Floorball\",de:\"Floorball\",es:\"Floorball\",leagues:[\n    {id:\"floorball.cz\",provider:\"livesport\",lsPath:\"/floorball/czech-republic/livesport-superliga/\",flag:\"🇨🇿\",cs:\"Livesport Superliga\",en:\"Czech Livesport Superliga\",de:\"Tschechische Livesport Superliga\",es:\"Livesport Superliga Checa\"},\n    {id:\"floorball.se\",provider:\"livesport\",lsPath:\"/floorball/sweden/svenska-superligan/\",flag:\"🇸🇪\",cs:\"Svenska Superligan\",en:\"Swedish SSL\",de:\"Swedish SSL\",es:\"Swedish SSL\"},\n    {id:\"floorball.fi\",provider:\"livesport\",lsPath:\"/floorball/finland/f-liiga/\",flag:\"🇫🇮\",cs:\"F-liiga\",en:\"F-liiga\",de:\"F-liiga\",es:\"F-liiga\"},\n    {id:\"floorball.ch\",provider:\"livesport\",lsPath:\"/floorball/switzerland/prime-league/\",flag:\"🇨🇭\",cs:\"Swiss Prime League\",en:\"Swiss Prime League\",de:\"Swiss Prime League\",es:\"Swiss Prime League\"},\n    {id:\"floorball.wfc\",provider:\"livesport\",lsPath:\"/floorball/world/world-championship/\",flag:\"🌍\",cs:\"Mistrovství světa IFF\",en:\"IFF World Championship\",de:\"IFF Weltmeisterschaft\",es:\"Mundial IFF\"}\n  ]},\n  {id:\"baseball\",icon:\"⚾\",cs:\"Baseball\",en:\"Baseball\",de:\"Baseball\",es:\"Béisbol\",leagues:[\n    {id:\"mlb\",provider:\"espn\",espnSport:\"baseball\",espnLeague:\"mlb\",flag:\"🇺🇸\",cs:\"MLB\",en:\"MLB\",de:\"MLB\",es:\"MLB\"},\n    {id:\"baseball.cz\",provider:\"livesport\",lsPath:\"/baseball/czech-republic/extraliga/\",flag:\"🇨🇿\",cs:\"Extraliga\",en:\"Czech Extraliga\",de:\"Tschechische Extraliga\",es:\"Extraliga Checa\"},\n    {id:\"baseball.jp\",provider:\"livesport\",lsPath:\"/baseball/japan/npb/\",flag:\"🇯🇵\",cs:\"NPB\",en:\"NPB\",de:\"NPB\",es:\"NPB\"},\n    {id:\"baseball.kr\",provider:\"livesport\",lsPath:\"/baseball/south-korea/kbo/\",flag:\"🇰🇷\",cs:\"KBO\",en:\"KBO\",de:\"KBO\",es:\"KBO\"},\n    {id:\"baseball.mx\",provider:\"livesport\",lsPath:\"/baseball/mexico/lmb/\",flag:\"🇲🇽\",cs:\"LMB\",en:\"LMB\",de:\"LMB\",es:\"LMB\"},\n    {id:\"ncaa-baseball\",provider:\"espn\",espnSport:\"baseball\",espnLeague:\"college-baseball\",flag:\"🇺🇸\",cs:\"NCAA Baseball\",en:\"NCAA Baseball\",de:\"NCAA Baseball\",es:\"NCAA Baseball\"}\n  ]}\n];\n\nconst T = {\n  cs:{subtitle:\"Widget zaměřený na jeden tým – live stav, příští zápas a další program.\",settings:\"Nastavení\",saved:\"Nastavení se ukládá automaticky.\",sport:\"Sport\",competition:\"Soutěž\",team:\"Tým\",chooseTeam:\"Vyber tým\",loadTeams:\"Načíst týmy\",loading:\"Načítám…\",teamsLoaded:\"Týmy načteny.\",teamsFail:\"Týmy se nepodařilo načíst.\",preview:\"Náhled widgetu\",small:\"Small\",medium:\"Medium\",widget:\"Widget\",appearance:\"Vzhled\",behavior:\"Chování\",behaviorSub:\"Obnova widgetu a jazyk.\",data:\"Data a diagnostika\",maintenance:\"Záloha a údržba\",language:\"Jazyk\",back:\"Zpět\",live:\"Live skóre\",stats:\"Statistiky týmů\",next:\"Další zápasy\",homeFirst:\"Domácí tým vlevo\",nextCount:\"Počet dalších zápasů\",theme:\"Motiv\",auto:\"Automatický\",dark:\"Tmavý\",light:\"Světlý\",accent:\"Akcent\",background:\"Pozadí\",systemBackground:\"Podle motivu\",customColor:\"Vlastní barva\",backgroundColor:\"Barva pozadí\",backgroundImage:\"Vlastní obrázek\",pickImage:\"Vybrat obrázek\",clearImage:\"Odstranit obrázek\",refresh:\"Obnova widgetu\",minutes:\"minut\",source:\"Zdroj dat\",diagnostics:\"Diagnostika\",checking:\"Kontroluji…\",ok:\"V pořádku\",error:\"Chyba\",export:\"Uložit zálohu\",import:\"Importovat zálohu\",clearCache:\"Vymazat cache\",resetAppearance:\"Obnovit vzhled\",resetTeam:\"Obnovit sport a tým\",resetAll:\"Obnovit vše\",copied:\"Záloha byla uložena do souboru.\",imported:\"Nastavení importováno.\",invalid:\"Neplatný JSON.\",resetDone:\"Nastavení obnoveno.\",cacheCleared:\"Cache byla vymazána.\",imageSaved:\"Obrázek pozadí uložen.\",imageCleared:\"Obrázek pozadí odstraněn.\",current:\"Používáš aktuální verzi.\",available:\"Je dostupná verze\",apply:\"Aktualizovat\",cancel:\"Zrušit\",updated:\"Aktualizace byla nainstalována.\",updateFailed:\"Aktualizace se nepodařila.\",noTeam:\"Nejdřív v nastavení vyber tým.\",noGame:\"Pro vybraný tým nejsou dostupné zápasy.\",today:\"DNES\",tomorrow:\"ZÍTRA\",liveNow:\"ŽIVĚ\",rank:\"Pořadí\",wins:\"V\",draws:\"R\",losses:\"P\",nextGames:\"DALŠÍ\",sourceEspn:\"ESPN\",sourceLivesport:\"Livesport\",widgetHelp:\"Small a Medium používají stejný vizuální systém jako Homebridge Status. Large zatím není podporován.\",selectionHelp:\"Nejdřív vyber sport a soutěž, potom načti týmy a zvol jeden tým.\",appearanceHelp:\"Vzhled widgetu používá stejné karty, barvy a typografii jako Homebridge Status.\",dataHelp:\"Sports Live používá stejnou datovou vrstvu jako Sports Info: fotbal OneFootball → ESPN → FotMob, ostatní soutěže ESPN / Livesport a připravené fallbacky SofaScore / SportsAPI Pro.\",update:\"Aktualizace\"},\n  en:{subtitle:\"A single-team widget for live status, the next game and upcoming fixtures.\",settings:\"Settings\",saved:\"Settings are saved automatically.\",sport:\"Sport\",competition:\"Competition\",team:\"Team\",chooseTeam:\"Choose team\",loadTeams:\"Load teams\",loading:\"Loading…\",teamsLoaded:\"Teams loaded.\",teamsFail:\"Could not load teams.\",preview:\"Widget preview\",small:\"Small\",medium:\"Medium\",widget:\"Widget\",appearance:\"Appearance\",behavior:\"Behavior\",behaviorSub:\"Widget refresh and language.\",data:\"Data & diagnostics\",maintenance:\"Backup & maintenance\",language:\"Language\",back:\"Back\",live:\"Live score\",stats:\"Team statistics\",next:\"Upcoming games\",homeFirst:\"Home team on the left\",nextCount:\"Upcoming games count\",theme:\"Theme\",auto:\"Automatic\",dark:\"Dark\",light:\"Light\",accent:\"Accent\",background:\"Background\",systemBackground:\"Follow theme\",customColor:\"Custom color\",backgroundColor:\"Background color\",backgroundImage:\"Custom image\",pickImage:\"Choose image\",clearImage:\"Remove image\",refresh:\"Widget refresh\",minutes:\"minutes\",source:\"Data source\",diagnostics:\"Diagnostics\",checking:\"Checking…\",ok:\"OK\",error:\"Error\",export:\"Save backup\",import:\"Import backup\",clearCache:\"Clear cache\",resetAppearance:\"Reset appearance\",resetTeam:\"Reset sport & team\",resetAll:\"Reset all\",copied:\"Backup file saved.\",imported:\"Settings imported.\",invalid:\"Invalid JSON.\",resetDone:\"Settings reset.\",cacheCleared:\"Cache cleared.\",imageSaved:\"Background image saved.\",imageCleared:\"Background image removed.\",current:\"You are using the current version.\",available:\"Version available\",apply:\"Update\",cancel:\"Cancel\",updated:\"Update installed.\",updateFailed:\"Update failed.\",noTeam:\"Choose a team in Settings first.\",noGame:\"No games are available for the selected team.\",today:\"TODAY\",tomorrow:\"TOMORROW\",liveNow:\"LIVE\",rank:\"Rank\",wins:\"W\",draws:\"D\",losses:\"L\",nextGames:\"NEXT\",sourceEspn:\"ESPN\",sourceLivesport:\"Livesport\",widgetHelp:\"Small and Medium use the same visual system as Homebridge Status. Large is not supported yet.\",selectionHelp:\"Choose a sport and competition, then load the teams and select one team.\",appearanceHelp:\"The widget uses the same cards, colors and typography as Homebridge Status.\",dataHelp:\"Sports Live uses the same data layer as Sports Info: football OneFootball → ESPN → FotMob, other competitions via ESPN / Livesport, with SofaScore / SportsAPI Pro fallbacks available.\",update:\"Update\"},\n  de:{subtitle:\"Ein Team im Fokus – Live-Status, nächstes Spiel und weitere Termine.\",settings:\"Einstellungen\",saved:\"Einstellungen werden automatisch gespeichert.\",sport:\"Sport\",competition:\"Wettbewerb\",team:\"Team\",chooseTeam:\"Team wählen\",loadTeams:\"Teams laden\",loading:\"Laden…\",teamsLoaded:\"Teams geladen.\",teamsFail:\"Teams konnten nicht geladen werden.\",preview:\"Widget-Vorschau\",small:\"Small\",medium:\"Medium\",widget:\"Widget\",appearance:\"Darstellung\",behavior:\"Verhalten\",behaviorSub:\"Widget-Aktualisierung und Sprache.\",data:\"Daten & Diagnose\",maintenance:\"Backup & Wartung\",language:\"Sprache\",back:\"Zurück\",live:\"Live-Ergebnis\",stats:\"Teamstatistiken\",next:\"Weitere Spiele\",homeFirst:\"Heimteam links\",nextCount:\"Anzahl weiterer Spiele\",theme:\"Design\",auto:\"Automatisch\",dark:\"Dunkel\",light:\"Hell\",accent:\"Akzent\",background:\"Hintergrund\",systemBackground:\"Nach Design\",customColor:\"Eigene Farbe\",backgroundColor:\"Hintergrundfarbe\",backgroundImage:\"Eigenes Bild\",pickImage:\"Bild wählen\",clearImage:\"Bild entfernen\",refresh:\"Widget-Aktualisierung\",minutes:\"Minuten\",source:\"Datenquelle\",diagnostics:\"Diagnose\",checking:\"Prüfe…\",ok:\"OK\",error:\"Fehler\",export:\"Backup speichern\",import:\"Backup importieren\",clearCache:\"Cache leeren\",resetAppearance:\"Darstellung zurücksetzen\",resetTeam:\"Sport & Team zurücksetzen\",resetAll:\"Alles zurücksetzen\",copied:\"Backup-Datei gespeichert.\",imported:\"Einstellungen importiert.\",invalid:\"Ungültiges JSON.\",resetDone:\"Einstellungen zurückgesetzt.\",cacheCleared:\"Cache geleert.\",imageSaved:\"Hintergrundbild gespeichert.\",imageCleared:\"Hintergrundbild entfernt.\",current:\"Aktuelle Version wird verwendet.\",available:\"Version verfügbar\",apply:\"Aktualisieren\",cancel:\"Abbrechen\",updated:\"Update installiert.\",updateFailed:\"Update fehlgeschlagen.\",noTeam:\"Zuerst ein Team in den Einstellungen wählen.\",noGame:\"Keine Spiele für das gewählte Team verfügbar.\",today:\"HEUTE\",tomorrow:\"MORGEN\",liveNow:\"LIVE\",rank:\"Rang\",wins:\"S\",draws:\"U\",losses:\"N\",nextGames:\"NÄCHSTE\",sourceEspn:\"ESPN\",sourceLivesport:\"Livesport\",widgetHelp:\"Small und Medium verwenden dasselbe visuelle System wie Homebridge Status. Large wird noch nicht unterstützt.\",selectionHelp:\"Sport und Wettbewerb wählen, Teams laden und ein Team auswählen.\",appearanceHelp:\"Das Widget verwendet dieselben Karten, Farben und dieselbe Typografie wie Homebridge Status.\",dataHelp:\"Sports Live nutzt dieselbe Datenschicht wie Sports Info: Fußball OneFootball → ESPN → FotMob, weitere Wettbewerbe über ESPN / Livesport sowie SofaScore / SportsAPI-Pro-Fallbacks.\",update:\"Update\"},\n  es:{subtitle:\"Un equipo en el centro: directo, próximo partido y calendario cercano.\",settings:\"Ajustes\",saved:\"Los ajustes se guardan automáticamente.\",sport:\"Deporte\",competition:\"Competición\",team:\"Equipo\",chooseTeam:\"Elegir equipo\",loadTeams:\"Cargar equipos\",loading:\"Cargando…\",teamsLoaded:\"Equipos cargados.\",teamsFail:\"No se pudieron cargar los equipos.\",preview:\"Vista previa\",small:\"Small\",medium:\"Medium\",widget:\"Widget\",appearance:\"Apariencia\",behavior:\"Comportamiento\",behaviorSub:\"Actualización del widget e idioma.\",data:\"Datos y diagnóstico\",maintenance:\"Copia y mantenimiento\",language:\"Idioma\",back:\"Atrás\",live:\"Marcador en directo\",stats:\"Estadísticas\",next:\"Próximos partidos\",homeFirst:\"Local a la izquierda\",nextCount:\"Número de próximos partidos\",theme:\"Tema\",auto:\"Automático\",dark:\"Oscuro\",light:\"Claro\",accent:\"Acento\",background:\"Fondo\",systemBackground:\"Según tema\",customColor:\"Color personalizado\",backgroundColor:\"Color de fondo\",backgroundImage:\"Imagen propia\",pickImage:\"Elegir imagen\",clearImage:\"Eliminar imagen\",refresh:\"Actualización\",minutes:\"minutos\",source:\"Fuente de datos\",diagnostics:\"Diagnóstico\",checking:\"Comprobando…\",ok:\"OK\",error:\"Error\",export:\"Guardar copia\",import:\"Importar copia\",clearCache:\"Borrar caché\",resetAppearance:\"Restablecer apariencia\",resetTeam:\"Restablecer deporte y equipo\",resetAll:\"Restablecer todo\",copied:\"Archivo de copia guardado.\",imported:\"Ajustes importados.\",invalid:\"JSON no válido.\",resetDone:\"Ajustes restablecidos.\",cacheCleared:\"Caché borrada.\",imageSaved:\"Imagen de fondo guardada.\",imageCleared:\"Imagen de fondo eliminada.\",current:\"Estás usando la versión actual.\",available:\"Versión disponible\",apply:\"Actualizar\",cancel:\"Cancelar\",updated:\"Actualización instalada.\",updateFailed:\"Error al actualizar.\",noTeam:\"Primero elige un equipo en Ajustes.\",noGame:\"No hay partidos para el equipo seleccionado.\",today:\"HOY\",tomorrow:\"MAÑANA\",liveNow:\"DIRECTO\",rank:\"Posición\",wins:\"V\",draws:\"E\",losses:\"D\",nextGames:\"SIGUIENTES\",sourceEspn:\"ESPN\",sourceLivesport:\"Livesport\",widgetHelp:\"Small y Medium usan el mismo sistema visual que Homebridge Status. Large todavía no está soportado.\",selectionHelp:\"Elige deporte y competición, carga los equipos y selecciona uno.\",appearanceHelp:\"El widget usa las mismas tarjetas, colores y tipografía que Homebridge Status.\",dataHelp:\"Sports Live usa la misma capa de datos que Sports Info: fútbol OneFootball → ESPN → FotMob, otras competiciones con ESPN / Livesport y fallbacks SofaScore / SportsAPI Pro.\",update:\"Actualizar\"}\n};\n\nconst UX = {\n  cs:{\n    previewHint:\"Náhled používá aktuálně uložený sport, soutěž a tým.\",widgetSub:\"Obsah a pořadí informací ve widgetu.\",\n    appearanceTitle:\"Vzhled widgetu\",appearanceSub:\"Název, barvy a zobrazované údaje. Bez vlastních obrázků.\",\n    widgetTitle:\"Název widgetu\",visibility:\"Viditelnost\",customColors:\"Vlastní barvy\",useCustomColors:\"Použít vlastní barvy\",\n    panelColor:\"Barva karet\",textColor:\"Barva textu\",mutedColor:\"Barva vedlejšího textu\",accentColor:\"Barva akcentu\",\n    liveColor:\"Barva Live / OK\",failColor:\"Barva chyby\",tools:\"Nástroje\",api:\"API a zdroje\",\n    apiSub:\"Stejná nabídka zdrojů jako ve Sports Info. Pole jsou dostupná vždy bez ohledu na vybranou soutěž.\",\n    provider:\"Aktivní cesta\",customEndpoints:\"API endpointy\",apiHint:\"Výchozí adresy