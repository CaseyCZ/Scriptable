nóstico\",diagnosticsSub:\"Estado de permisos y fuentes online al abrir los ajustes.\",maintenance:\"Copia y mantenimiento\",whatSub:\"Puedes activar o desactivar cada módulo por separado.\",orderSub:\"El orden determina dónde aparece cada módulo en el fondo.\",display:\"Visualización\",days:\"Días a mostrar\",maxItems:\"Máximo de elementos por día\",hidePast:\"Ocultar eventos pasados\",undatedToday:\"Mostrar hoy tareas sin fecha\",calendars:\"Calendarios\",reminderLists:\"Listas de recordatorios\",noneCalendars:\"No se encontraron calendarios.\",noneReminders:\"No se encontraron listas de recordatorios.\",responsiveInfo:\"El diseño automático adapta posiciones, fuentes, iconos y espacios a la resolución del iPhone.\",automation:\"Automático\",adapt:\"Adaptar a otros iPhone\",compact:\"Modo compacto\",compactD:\"Menos espacio para mostrar más contenido\",autoFit:\"Ajustar contenido automáticamente\",autoFitD:\"Si el contenido se desborda, reduce texto y espacios automáticamente.\",minScale:\"Escala mínima de Auto Fit\",scale:\"Escala general\",position:\"Posición\",alignment:\"Alineación\",left:\"Izquierda\",center:\"Centro\",right:\"Derecha\",contentStart:\"Inicio del contenido Y\",sideMargin:\"Margen lateral\",spacing:\"Espaciado\",lineSpacing:\"Espacio entre líneas\",blockSpacing:\"Espacio entre bloques\",iconSize:\"Tamaño de iconos\",styleSub:\"Cada tipo de contenido puede tener su propio color y tamaño.\",styles:\"Estilos\",dayHeader:\"Encabezado del día\",language:\"Idioma\",dateFormat:\"Formato de fecha\",customText:\"Textos personalizados\",today:\"Hoy\",tomorrow:\"Mañana\",noEventsText:\"Texto sin eventos\",nameDayLabel:\"Etiqueta de santoral\",nameDays:\"Santoral\",country:\"País\",autoLanguage:\"Automático según idioma\",forecast:\"Pronóstico\",forecastDays:\"Días de pronóstico\",showWeatherIcon:\"Mostrar icono del tiempo\",units:\"Unidades\",league:\"Liga\",team:\"Equipo / filtro\",stocks:\"Acciones, separadas por comas\",crypto:\"Criptomonedas\",currencies:\"Monedas frente a EUR\",note:\"Nota\",custom:\"Texto personalizado\",countdown:\"Cuenta atrás\",title:\"Título\",date:\"Fecha\",stepGoal:\"Objetivo diario de pasos\",fitnessInfo:\"Los pasos reales deben ser escritos por un Atajo en LockScreenGenerator_steps.txt. Sin ese archivo el módulo Fitness permanece oculto.\",newsTime:\"Noticias y hora\",rss:\"Fuente RSS\",cities:\"Ciudades, separadas por comas\",permissions:\"Faltan permisos\",calendarPermission:\"Permite acceso al Calendario para Scriptable.\",reminderPermission:\"Permite acceso a Recordatorios para Scriptable.\",locationPermission:\"Permite acceso a la ubicación para el tiempo.\",testedOpen:\"Prueba realizada al abrir los ajustes.\",statusOK:\"OK\",statusOff:\"Desactivado\",statusError:\"Error\",exportImport:\"Exportar / importar ajustes\",jsonHint:\"Copia el JSON como respaldo o pega aquí una configuración exportada.\",exportSettings:\"Exportar actual\",importSettings:\"Aplicar importación\",resetAppearance:\"Restablecer apariencia\",resetModules:\"Restablecer módulos\",resetAll:\"Restablecer todo\",confirmReset:\"¿Restablecer los ajustes seleccionados?\",copied:\"Ajustes copiados.\",imported:\"Importación aplicada. Se guardará al cerrar.\",invalidJson:\"JSON no válido.\"}\n};\n\nconst API_UI={\n  cs:{title:\"Volitelná API\",sub:\"Všechno funguje i bez vlastních API klíčů. Vlastní klíč použij jen pokud chceš jiného poskytovatele.\",privacy:\"Klíče se ukládají pouze do tvého nastavení Scriptable/iCloud. Export JSON je automaticky vynechá.\",provider:\"Poskytovatel\",key:\"API klíč\",getKey:\"Získat API klíč\",docs:\"Dokumentace\",free:\"Zdarma bez API klíče\",weatherFree:\"Open-Meteo – zdarma bez klíče\",weatherOwn:\"OpenWeatherMap – vlastní API klíč\",yahoo:\"Yahoo Finance – zdarma bez klíče\",alpha:\"Alpha Vantage – vlastní API klíč\",exchangeOpen:\"Open ER API – zdarma bez klíče\",exchangeKey:\"ExchangeRate-API – vlastní API klíč\"},\n  en:{title:\"Optional APIs\",sub:\"Everything works without your own API keys. Use a personal key only if you prefer another provider.\",privacy:\"Keys are stored only in your Scriptable/iCloud settings. JSON export automatically omits them.\",provider:\"Provider\",key:\"API key\",getKey:\"Get API key\",docs:\"Documentation\",free:\"Free without API key\",weatherFree:\"Open-Meteo – free, no key\",weatherOwn:\"OpenWeatherMap – own API key\",yahoo:\"Yahoo Finance – free, no key\",alpha:\"Alpha Vantage – own API key\",exchangeOpen:\"Open ER API – free, no key\",exchangeKey:\"ExchangeRate-API – own API key\"},\n  de:{title:\"Optionale APIs\",sub:\"Alles funktioniert ohne eigene API-Schlüssel. Einen eigenen Schlüssel brauchst du nur für einen anderen Anbieter.\",privacy:\"Schlüssel werden nur in deinen Scriptable/iCloud-Einstellungen gespeichert. JSON-Export lässt sie automatisch weg.\",provider:\"Anbieter\",key:\"API-Schlüssel\",getKey:\"API-Schlüssel holen\",docs:\"Dokumentation\",free:\"Kostenlos ohne API-Schlüssel\",weatherFree:\"Open-Meteo – kostenlos ohne Schlüssel\",weatherOwn:\"OpenWeatherMap – eigener API-Schlüssel\",yahoo:\"Yahoo Finance – kostenlos ohne Schlüssel\",alpha:\"Alpha Vantage – eigener API-Schlüssel\",exchangeOpen:\"Open ER API – kostenlos ohne Schlüssel\",exchangeKey:\"ExchangeRate-API – eigener API-Schlüssel\"},\n  es:{title:\"APIs opcionales\",sub:\"Todo funciona sin claves API propias. Usa una clave personal solo si prefieres otro proveedor.\",privacy:\"Las claves solo se guardan en tus ajustes de Scriptable/iCloud. La exportación JSON las omite automáticamente.\",provider:\"Proveedor\",key:\"Clave API\",getKey:\"Obtener clave API\",docs:\"Documentación\",free:\"Gratis sin clave API\",weatherFree:\"Open-Meteo – gratis sin clave\",weatherOwn:\"OpenWeatherMap – clave API propia\",yahoo:\"Yahoo Finance – gratis sin clave\",alpha:\"Alpha Vantage – clave API propia\",exchangeOpen:\"Open ER API – gratis sin clave\",exchangeKey:\"ExchangeRate-API – clave API propia\"}\n};\n\nconst UPDATE_UI={\n  cs:{update:\"Aktualizace\",checking:\"Kontroluji…\",current:\"Aktuální verze\",available:\"Nová verze\",install:\"Aktualizovat na\",installing:\"Aktualizuji…\",installed:\"Aktualizováno\",restart:\"Zavři nastavení a spusť skript znovu.\",failed:\"Aktualizaci se nepodařilo zkontrolovat.\",invalid:\"Stažený soubor není platná verze LockScreen Generatoru.\",backup:\"Předchozí verze byla uložena jako LockScreenGenerator_backup.js.\"},\n  en:{update:\"Update\",checking:\"Checking…\",current:\"Up to date\",available:\"New version\",install:\"Update to\",installing:\"Updating…\",installed:\"Updated\",restart:\"Close settings and run the script again.\",failed:\"Could not check for updates.\",invalid:\"The downloaded file is not a valid LockScreen Generator version.\",backup:\"The previous version was saved as LockScreenGenerator_backup.js.\"},\n  de:{update:\"Update\",checking:\"Prüfe…\",current:\"Aktuell\",available:\"Neue Version\",install:\"Aktualisieren auf\",installing:\"Aktualisiere…\",installed:\"Aktualisiert\",restart:\"Einstellungen schließen und das Skript erneut starten.\",failed:\"Update konnte nicht geprüft werden.\",invalid:\"Die heruntergeladene Datei ist keine gültige LockScreen-Generator-Version.\",backup:\"Die vorherige Version wurde als LockScreenGenerator_backup.js gespeichert.\"},\n  es:{update:\"Actualizar\",checking:\"Comprobando…\",current:\"Versión actual\",available:\"Nueva versión\",install:\"Actualizar a\",installing:\"Actualizando…\",installed:\"Actualizado\",restart:\"Cierra los ajustes y vuelve a ejecutar el script.\",failed:\"No se pudo comprobar la actualización.\",invalid:\"El archivo descargado no es una versión válida de LockScreen Generator.\",backup:\"La versión anterior se guardó como LockScreenGenerator_backup.js.\"}\n};\n\nconst DEFAULT_STYLE={header:{color:\"#B8B8BE\",size:34},events:{color:\"#FFFFFF\",size:30},reminders:{color:\"#818CF8\",size:30},weather:{color:\"#38BDF8\",size:26},weatherForecast:{color:\"#38BDF8\",size:26},nameday:{color:\"#A1A1AA\",size:24},f1:{color:\"#F87171\",size:28},sports:{color:\"#FCA5A5\",size:28},quotes:{color:\"#93C5FD\",size:24},stocks:{color:\"#6EE7B7\",size:26},crypto:{color:\"#FDE047\",size:26},exchange:{color:\"#C084FC\",size:26},notes:{color:\"#F1F5F9\",size:28},countdown:{color:\"#F472B6\",size:28},fitness:{color:\"#5EEAD4\",size:26},news:{color:\"#94A3B8\",size:24},moon:{color:\"#CBD5E1\",size:26},worldclock:{color:\"#60A5FA\",size:26},battery:{color:\"#D1D5DB\",size:26},system:{color:\"#A1A1AA\",size:24}};\nconst DEFAULT_SETTINGS={settingsVersion:7,language:\"cs\",weatherProvider:\"openmeteo\",openWeatherApiKey:\"\",apiOpenWeatherBase:\"https://api.openweathermap.org/data/2.5\",calendars:[],reminderLists:[],calendarsConfigured:false,showEvents:true,showReminders:true,showWeather:true,showWeatherForecast:true,showNameDay:true,showF1:true,showF1Practice:false,showF1Qualifying:true,showF1Sprint:true,showF1Race:true,showSports:true,showQuotes:true,showStocks:true,showCrypto:true,showExchangeRates:true,showCustomNotes:true,showCountdowns:true,showFitness:true,showNews:true,showMoonPhase:true,showWorldClocks:true,showBattery:true,showSystemMetrics:true,sectionOrder:Object.keys(MODULES),sectionStyle:DEFAULT_STYLE,daysToShow:2,maxEventsPerDay:5,hidePastEvents:false,remindersWithoutDateOnToday:true,labelToday:\"\",labelTomorrow:\"\",noEventsText:\"\",customDateFormat:\"EEEE, d. M.\",nameDayCountry:\"\",nameDayLabel:\"\",weatherForecastDays:4,showWeatherIcon:true,weatherUnit:\"celsius\",sportsLeague:\"NHL\",sportsTeam:\"\",stockSymbols:\"\",cryptoCoins:\"\",exchangeCurrencies:\"\",customNotesText:\"\",countdownTitle:\"\",countdownDate:\"\",stepsGoal:10000,newsFeedUrl:\"https://servis.idnes.cz/rss.aspx?c=zpravodaj\",worldClockCities:\"\",layoutStyle:\"left\",remindersAlign:\"right\",startY:950,marginX:60,responsiveLayout:true,contentScale:1,lineSpacing:10,blockSpacing:40,iconSize:28,compactMode:false,autoFitContent:true,minContentScale:.72,apiWeatherBase:\"https://api.open-meteo.com/v1/forecast\",apiNameDayCzBase:\"https://svatkyapi.netlify.app/api/day\",apiNameDayGlobalBase:\"https://nameday.abalin.net\",apiF1Base:\"https://api.jolpi.ca/ergast/f1\",apiSportsBase:\"https://site.api.espn.com/apis/site/v2/sports\",stockProvider:\"yahoo\",apiYahooBase:\"https://query1.finance.yahoo.com\",apiAlphaVantageBase:\"https://www.alphavantage.co\",alphaVantageKey:\"\",apiCoinbaseBase:\"https://api.coinbase.com\",exchangeProvider:\"open\",apiExchangeOpenBase:\"https://open.er-api.com/v6\",apiExchangeKeyedBase:\"https://v6.exchangerate-api.com/v6\",exchangeApiKey:\"\",lastWeather:null,lastNameDays:{},lastF1:[]};\n\nasync function main(){let settings=await loadSettings();if(config.runsInApp){const fm=FileManager.iCloud(),settingsPath=fm.joinPath(fm.documentsDirectory(),SETTINGS_FILE),firstRun=!fm.fileExists(settingsPath);if(firstRun){settings.language=await chooseFirstRunLanguage(settings.language);saveSettings(settings)}settings=await openSettingsScreen(settings)}const size=resolveResolution();const image=await buildImage(size,settings);const fm=FileManager.iCloud();const path=fm.joinPath(fm.documentsDirectory(),OUTPUT_FILE);fm.writeImage(path,image);if(config.runsInApp)await QuickLook.present(image);Script.setShortcutOutput(path);Script.complete()}\nasync function chooseFirstRunLanguage(current){\n  const a=new Alert();\n  a.title=\"🌐 Language / Jazyk\";\n  a.message=\"Choose your language • Vyberte jazyk • Sprache wählen • Elige idioma\";\n  const langs=[[\"cs\",\"🇨🇿 Čeština\"],[\"en\",\"🇬🇧 English\"],[\"de\",\"🇩🇪 Deutsch\"],[\"es\",\"🇪🇸 Español\"]];\n  langs.forEach(([,label])=>a.addAction(label));\n  const i=await a.presentSheet();\n  return langs[i]?.[0]||current||\"cs\";\n}\n\nfunction deepMergeStyle(saved){const out={};for(const key of Object.keys(DEFAULT_STYLE))out[key]={...DEFAULT_STYLE[key],...((saved||{})[key]||{})};return out}\nasync function loadSettings(){const fm=FileManager.iCloud(),path=fm.joinPath(fm.documentsDirectory(),SETTINGS_FILE);let saved={};try{if(fm.fileExists(path)){if(!fm.isFileDownloaded(path))await fm.downloadFileFromiCloud(path);saved=JSON.parse(fm.readString(path))}}catch(_){saved={}}const merged={...DEFAULT_SETTINGS,...saved};merged.sectionStyle=deepMergeStyle(saved.sectionStyle);merged.lastNameDays=saved.lastNameDays||{};merged.lastF1=saved.lastF1||[];let order=Array.isArray(saved.sectionOrder)?[...saved.sectionOrder]:[...DEFAULT_SETTINGS.sectionOrder];for(const key of Object.keys(MODULES))if(!order.includes(key))order.push(key);merged.sectionOrder=order.filter(key=>MODULES[key]);merged.settingsVersion=7;return merged}\nfunction saveSettings(s){const copy={...s};delete copy.__preview;const fm=FileManager.iCloud();fm.writeString(fm.joinPath(fm.documentsDirectory(),SETTINGS_FILE),JSON.stringify(copy,null,2))}\nfunction tr(lang,key){return (UI[lang]||UI.en)[key]||UI.en[key]||key}\nfunction timedRequest(url){const r=new Request(url);r.timeoutInterval=API_TIMEOUT;return r}\nfunction apiBase(value,fallback){return String(value||fallback).replace(/\\/+$/,\"\")}\nfunction compareVersions(a,b){const pa=String(a||\"0\").split(\".\").map(n=>parseInt(n,10)||0),pb=String(b||\"0\").split(\".\").map(n=>parseInt(n,10)||0);for(let i=0;i<3;i++){if((pa[i]||0)>(pb[i]||0))return 1;if((pa[i]||0)<(pb[i]||0))return-1}return 0}\nasync function fetchScriptUpdate(){const code=await timedRequest(UPDATE_SOURCE_URL).loadString();if(!code||code.length<UPDATE_MIN_BYTES)throw new Error(\"Update file too small\");const m=code.match(/const APP_VERSION\\s*=\\s*[\"']([^\"']+)[\"']/);if(!m||!m[1]||!code.includes(\"LockScreenGenerator.js\")||!code.includes(\"await main();\"))throw new Error(\"Invalid update file\");return{version:m[1],code}}\nasync function installScriptUpdate(code){const path=module.filename;if(!path)throw new Error(\"Current script path unavailable\");const cloud=FileManager.iCloud(),local=FileManager.local();let fm=local;try{if(cloud.fileExists(path))fm=cloud;else if(local.fileExists(path))fm=local;else throw new Error(\"Current script file not found\")}catch(e){if(local.fileExists(path))fm=local;else throw e}try{if(fm===cloud&&!fm.isFileDownloaded(path))await fm.downloadFileFromiCloud(path)}catch(_){}const current=fm.readString(path),backup=/\\.js$/i.test(path)?path.replace(/\\.js$/i,\"_backup.js\"):path+\"_backup.js\";fm.writeString(backup,current);fm.writeString(path,code);return backup}\nasync function checkPermissions(settings){const lang=settings.language||\"cs\",p=[];if(settings.showEvents){try{await Calendar.forEvents()}catch(_){p.push(\"📅 \"+tr(lang,\"calendarPermission\"))}}if(settings.showReminders){try{await Calendar.forReminders()}catch(_){p.push(\"✅ \"+tr(lang,\"reminderPermission\"))}}if(settings.showWeather&&CONFIG.latitude===null){try{Location.setAccuracyToThreeKilometers();await Location.current()}catch(_){p.push(\"📍 \"+tr(lang,\"locationPermission\"))}}if(p.length){const a=new Alert();a.title=tr(lang,\"permissions\");a.message=p.join(\"\\n\\n\");a.addAction(\"OK\");await a.presentAlert()}}\nfunction moduleLabel(key,t){return `${MODULES[key].icon} ${t[key]||key}`}\n\nfunction diagnosticPlaceholders(settings){const t=LOCALIZATION[settings.language]||LOCALIZATION.en,stock=(settings.stockSymbols||\"\").split(\",\")[0]?.trim(),coin=(settings.cryptoCoins||\"\").split(\",\")[0]?.trim();return[\n  {label:`📅 ${t.events}`,state:settings.showEvents?\"checking\":\"off\",detail:\"\"},\n  {label:`✅ ${t.reminders}`,state:settings.showReminders?\"checking\":\"off\",detail:\"\"},\n  {label:\"🌤 Open-Meteo\",state:(settings.showWeather||settings.showWeatherForecast)?\"checking\":\"off\",detail:\"\"},\n  {label:\"🏎 Formula 1\",state:settings.showF1?\"checking\":\"off\",detail:\"\"},\n  {label:`🏆 ${t.sports}`,state:settings.showSports?\"checking\":\"off\",detail:\"\"},\n  {label:\"📈 Yahoo Finance\",state:(settings.showStocks&&!!stock)?\"checking\":\"off\",detail:\"\"},\n  {label:\"🪙 Coinbase\",state:(settings.showCrypto&&!!coin)?\"checking\":\"off\",detail:\"\"},\n  {label:\"💱 Exchange Rate\",state:settings.showExchangeRates?\"checking\":\"off\",detail:\"\"},\n  {label:\"📰 RSS\",state:(settings.showNews&&!!settings.newsFeedUrl)?\"checking\":\"off\",detail:\"\"}\n]}\nasync function probe(label,enabled,fn){if(!enabled)return{label,state:\"off\",detail:\"\"};try{await fn();return{label,state:\"ok\",detail:\"\"}}catch(e){return{label,state:\"error\",detail:String(e&&e.message?e.message:e).slice(0,90)}}}\nasync function collectDiagnostics(settings){const t=LOCALIZATION[settings.language]||LOCALIZATION.en,rows=[];rows.push(probe(`📅 ${t.events}`,settings.showEvents,async()=>{await Calendar.forEvents()}));rows.push(probe(`✅ ${t.reminders}`,settings.showReminders,async()=>{await Calendar.forReminders()}));rows.push(probe(settings.weatherProvider===\"openweathermap\"?\"🌤 OpenWeatherMap\":\"🌤 Open-Meteo\",settings.showWeather||settings.showWeatherForecast,async()=>{const loc=await resolveLocation();if(settings.weatherProvider===\"openweathermap\"){const key=String(settings.openWeatherApiKey||\"\").trim();if(!key)throw new Error(\"API key missing\");await timedRequest(`${apiBase(settings.apiOpenWeatherBase,\"https://api.openweathermap.org/data/2.5\")}/forecast?lat=${loc.latitude}&lon=${loc.longitude}&appid=${encodeURIComponent(key)}&units=metric`).loadJSON()}else await timedRequest(`${apiBase(settings.apiWeatherBase,\"https://api.open-meteo.com/v1/forecast\")}?latitude=${loc.latitude}&longitude=${loc.longitude}&daily=temperature_2m_max&timezone=auto&forecast_days=1`).loadJSON()}));rows.push(probe(\"🏎 Formula 1\",settings.showF1,async()=>{await timedRequest(`${apiBase(settings.apiF1Base,\"https://api.jolpi.ca/ergast/f1\")}/current/next.json`).loadJSON()}));rows.push(probe(`🏆 ${t.sports}`,settings.showSports,async()=>{const league=(settings.sportsLeague||\"NHL\").toLowerCase(),sport=league===\"nba\"?\"basketball\":league===\"nfl\"?\"football\":league===\"mlb\"?\"baseball\":\"hockey\";await timedRequest(`${apiBase(settings.apiSportsBase,\"https://site.api.espn.com/apis/site/v2/sports\")}/${sport}/${league}/scoreboard`).loadJSON()}));const stock=(settings.stockSymbols||\"\").split(\",\")[0]?.trim().toUpperCase();rows.push(probe(\"📈 Yahoo Finance\",settings.showStocks&&!!stock,async()=>{await (settings.stockProvider===\"alphavantage\"?timedRequest(`${apiBase(settings.apiAlphaVantageBase,\"https://www.alphavantage.co\")}/query?function=GLOBAL_QUOTE&symbol=${encodeURIComponent(stock)}&apikey=${encodeURIComponent(settings.alphaVantageKey||\"\")}`):timedRequest(`${apiBase(settings.apiYahooBase,\"https://query1.finance.yahoo.com\")}/v8/finance/chart/${encodeURIComponent(stock)}?interval=1d&range=1d`)).loadJSON()}));const coin=(settings.cryptoCoins||\"\").split(\",\")[0]?.trim().toUpperCase();rows.push(probe(\"🪙 Coinbase\",settings.showCrypto&&!!coin,async()=>{await timedRequest(`${apiBase(settings.apiCoinbaseBase,\"https://api.coinbase.com\")}/v2/prices/${coin}-USD/spot`).loadJSON()}));rows.push(probe(\"💱 Exchange Rate\",settings.showExchangeRates,async()=>{await (settings.exchangeProvider===\"keyed\"?timedRequest(`${apiBase(settings.apiExchangeKeyedBase,\"https://v6.exchangerate-api.com/v6\")}/${encodeURIComponent(settings.exchangeApiKey||\"\")}/latest/EUR`):timedRequest(`${apiBase(settings.apiExchangeOpenBase,\"https://open.er-api.com/v6\")}/latest/EUR`)).loadJSON()}));rows.push(probe(\"📰 RSS\",settings.showNews&&!!settings.newsFeedUrl,async()=>{await timedRequest(settings.newsFeedUrl).loadString()}));return await Promise.all(rows)}\n\nasync function openSettingsScreen(settings){\n  const lang=settings.language||\"cs\",t=LOCALIZATION[lang]||LOCALIZATION.en,u=key=>tr(lang,key),a=API_UI[lang]||API_UI.en,up=UPDATE_UI[lang]||UPDATE_UI.en,diagnostics=diagnosticPlaceholders(settings);\n  const calendarNames=[],reminderNames=[],esc=v=>String(v??\"\").replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\");\n  const phoneText=({cs:{load:\"🔄 Načíst z tohoto iPhonu\",hint:\"Kalendáře a Připomínky se načtou pouze z tohoto zařízení. Vyber si, co chceš zobrazovat.\",loading:\"Načítám kalendáře a Připomínky…\",denied:\"Přístup není povolený. Povol Scriptable přístup ke Kalendáři a Připomínkám v Nastavení iOS.\",none:\"Nic nebylo nalezeno.\",saved:\"Uložený výběr\"},en:{load:\"🔄 Load from this iPhone\",hint:\"Calendars and Reminders are loaded only from this device. Choose what you want to display.\",loading:\"Loading Calendars and Reminders…\",denied:\"Access is not allowed. Enable Calendar and Reminders access for Scriptable in iOS Settings.\",none:\"Nothing found.\",saved:\"Saved selection\"},de:{load:\"🔄 Von diesem iPhone laden\",hint:\"Kalender und Erinnerungen werden nur von diesem Gerät geladen. Wähle aus, was angezeigt werden soll.\",loading:\"Kalender und Erinnerungen werden geladen…\",denied:\"Zugriff nicht erlaubt. Erlaube Scriptable den Zugriff auf Kalender und Erinnerungen in iOS Einstellungen.\",none:\"Nichts gefunden.\",saved:\"Gespeicherte Auswahl\"},es:{load:\"🔄 Cargar desde este iPhone\",hint:\"Los calendarios y recordatorios se cargan solo desde este dispositivo. Elige qué quieres mostrar.\",loading:\"Cargando calendarios y recordatorios…\",denied:\"Acceso no permitido. Activa el acceso de Scriptable a Calendario y Recordatorios en Ajustes de iOS.\",none:\"No se encontró nada.\",saved:\"Selección guardada\"}}[lang]||{});\n  const sw=(id,label,value,detail=\"\")=>`<label class=\"settingRow\"><div class=\"rowText\"><div class=\"rowTitle\">${label}</div>${detail?`<div class=\"rowDetail\">${detail}</div>`:\"\"}</div><span class=\"switch\"><input id=\"${id}\" type=\"checkbox\" ${value?\"checked\":\"\"}><span class=\"slider\"></span></span></label>`;\n  const nav=(screen,icon,title,detail=\"\")=>`<div class=\"navRow\" onclick=\"showScreen('${screen}')\"><div class=\"navLeft\"><span class=\"navIcon\">${icon}</span><span>${title}</span></div><div class=\"navRight\"><span class=\"navDetail\">${detail}</span><span class=\"chevron\">›</span></div></div>`;\n  const field=(id,label,value,type=\"text\",attrs=\"\")=>`<div class=\"field\"><label for=\"${id}\">${label}</label><input id=\"${id}\" type=\"${type}\" value=\"${esc(value)}\" ${attrs}></div>`;\n  const back=`<div class=\"topbar\"><button class=\"back\" onclick=\"showScreen('home')\">‹ ${u(\"settings\")}</button><span class=\"brandDot\"></span></div>`;\n  const moduleRows=Object.keys(MODULES).map(k=>sw(MODULES[k].showKey,moduleLabel(k,t),!!settings[MODULES[k].showKey])).join(\"\");\n  const orderMeta={};for(const k of Object.keys(MODULES))orderMeta[k]=moduleLabel(k,t);\n  const styleKeys=[\"header\",...Object.keys(MODULES)],styleRows=styleKeys.map(k=>{const st=settings.sectionStyle[k]||DEFAULT_STYLE[k]||{color:\"#fff\",size:26},label=k===\"header\"?`📆 ${u(\"dayHeader\")}`:moduleLabel(k,t);return `<div class=\"styleRow\"><div class=\"styleLabel\">${label}</div><input class=\"styleColor\" data-key=\"${k}\" type=\"color\" value=\"${st.color}\"><input class=\"styleSize\" data-key=\"${k}\" type=\"number\" min=\"10\" max=\"80\" value=\"${st.size}\"></div>`}).join(\"\");\n  const savedCalRows=(settings.calendars||[]).map((n,i)=>`<label class=\"settingRow\"><div class=\"rowText\"><div class=\"rowTitle\">${esc(n)}</div><div class=\"rowDetail\">${phoneText.saved}</div></div><span class=\"switch\"><input type=\"checkbox\" data-source-kind=\"calendar\" data-source-name=\"${esc(n)}\" checked><span class=\"slider\"></span></span></label>`).join(\"\");\n  const savedRemRows=(settings.reminderLists||[]).map((n,i)=>`<label class=\"settingRow\"><div class=\"rowText\"><div class=\"rowTitle\">${esc(n)}</div><div class=\"rowDetail\">${phoneText.saved}</div></div><span class=\"switch\"><input type=\"checkbox\" data-source-kind=\"reminder\" data-source-name=\"${esc(n)}\" checked><span class=\"slider\"></span></span></label>`).join(\"\");\n  const countryOptions=[[\"\",`🌐 ${u(\"autoLanguage\")}`],[\"cz\",\"🇨🇿 Czechia\"],[\"sk\",\"🇸🇰 Slovakia\"],[\"de\",\"🇩🇪 Germany\"],[\"es\",\"🇪🇸 Spain\"],[\"us\",\"🇺🇸 USA\"],[\"fr\",\"🇫🇷 France\"],[\"it\",\"🇮🇹 Italy\"],[\"pl\",\"🇵🇱 Poland\"]].map(([v,l])=>`<option value=\"${v}\" ${settings.nameDayCountry===v?\"selected\":\"\"}>${l}</option>`).join(\"\");\n  const diagRows=diagnostics.map(d=>`<div class=\"diagRow\"><div><div class=\"diagTitle\">${d.label}</div>${d.detail?`<div class=\"diagDetail\">${esc(d.detail)}</div>`:\"\"}</div><span class=\"diagState ${d.state}\">${d.state===\"checking\"?\"⏳\":d.state===\"ok\"?\"● \"+u(\"statusOK\"):d.state===\"off\"?\"● \"+u(\"statusOff\"):\"● \"+u(\"statusError\")}</span></div>`).join(\"\");\n\n  const html=`<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>\n  :root{color-scheme:dark;--bg:#0b1020;--panel:#111827;--panel2:#172033;--border:#2a3850;--text:#f8fafc;--muted:#94a3b8;--accent:#38bdf8;--accent2:#0284c7;--ok:#86efac;--danger:#fb7185;--shadow:0 24px 70px rgba(0,0,0,.45)}\n  *{box-sizing:border-box}html,body{margin:0;min-height:100%;color:var(--text);font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;-webkit-tap-highlight-color:transparent}html{background:#070b14}body{padding:calc(14px + env(safe-area-inset-top)) 14px calc(36px + env(safe-area-inset-bottom));max-width:680px;margin:auto;background:radial-gradient(circle at top,#172554 0,#0b1020 42%,#070b14 100%);background-attachment:fixed}.screen{display:none}.screen.active{display:block}.topbar{display:flex;align-items:center;justify-content:space-between;min-height:42px;margin:0 2px 8px}.brandDot{width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 18px rgba(56,189,248,.75)}.back{border:0;background:transparent;color:var(--accent);font:inherit;font-size:16px;font-weight:750;padding:7px 0;cursor:pointer}.hero{background:rgba(17,24,39,.96);border:1px solid var(--border);border-radius:22px;padding:22px;margin-bottom:14px;box-shadow:var(--shadow)}.eyebrow{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid #1d4ed8;border-radius:999px;background:#0f1f46;color:#bfdbfe;font-size:.78rem;font-weight:700}.heroTop{display:flex;align-items:center;justify-content:space-between;gap:10px}.updateBtn{border:1px solid #1d4ed8;border-radius:999px;background:#0f1f46;color:#bfdbfe;padding:6px 10px;font:inherit;font-size:.78rem;font-weight:800;cursor:pointer;white-space:nowrap}.updateBtn:disabled{opacity:.55}.updateStatus{min-height:17px;margin-top:8px;color:var(--muted);font-size:11px}.updateStatus.ok{color:var(--ok)}.updateStatus.warn{color:#facc15}.updateStatus.error{color:var(--danger)}.hero h1,.screenTitle{font-size:27px;line-height:1.15;margin:14px 0 6px;font-weight:800;letter-spacing:-.45px}.screenTitle{margin:5px 2px 6px}.hero p,.screenSub{color:var(--muted);font-size:14px;line-height:1.5;margin:0}.screenSub{margin:0 2px 14px}.sectionTitle{font-size:11px;color:#9fb3ce;text-transform:uppercase;letter-spacing:.1em;font-weight:800;margin:19px 9px 8px}.card{background:rgba(17,24,39,.96);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:13px;box-shadow:0 12px 34px rgba(0,0,0,.24)}.navRow,.settingRow{min-height:54px;display:flex;align-items:center;justify-content:space-between;padding:9px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.navRow:last-child,.settingRow:last-child{border-bottom:0}.navRow{cursor:pointer;transition:.15s ease}.navRow:active{background:var(--panel2)}.navLeft{display:flex;gap:11px;align-items:center;font-size:15px;font-weight:700}.navIcon{width:26px;text-align:center}.navRight{display:flex;align-items:center;gap:8px}.navDetail,.rowDetail{font-size:12px;color:var(--muted)}.chevron{font-size:23px;color:#64748b;line-height:1}.rowText{min-width:0;padding-right:11px}.rowTitle{font-size:15px;font-weight:650}.info{margin:14px 0;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--panel2);color:#cbd5e1;font-size:.86rem;line-height:1.45}.warning{border-color:#6b4b1e;background:#291e0d;color:#fcd34d}.field{padding:12px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.field:last-child{border-bottom:0}.field label{display:block;margin-bottom:7px;color:#dbeafe;font-size:.82rem;font-weight:650}input[type=text],input[type=password],input[type=number],input[type=date],select,textarea{width:100%;min-height:46px;border:1px solid var(--border);border-radius:12px;background:#0b1220;color:var(--text);padding:0 13px;font:inherit;font-size:15px;outline:none}textarea{min-height:180px;padding:12px;resize:vertical;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.4}input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(56,189,248,.12)}select{-webkit-appearance:none}.switch{position:relative;width:50px;height:30px;flex:0 0 50px}.switch input{display:none}.slider{position:absolute;inset:0;background:#243149;border:1px solid var(--border);border-radius:999px;transition:.18s}.slider:before{content:\"\";position:absolute;width:24px;height:24px;left:2px;top:2px;background:#fff;border-radius:50%;transition:.18s;box-shadow:0 2px 6px rgba(0,0,0,.45)}.switch input:checked+.slider{background:var(--accent2);border-color:var(--accent)}.switch input:checked+.slider:before{transform:translateX(20px)}.presetGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-bottom:13px}.preset{border:1px solid var(--border);border-radius:14px;background:rgba(17,24,39,.96);color:#fff;padding:15px;text-align:left;font:inherit;font-size:14px;font-weight:750;cursor:pointer;transition:.15s ease;box-shadow:0 10px 25px rgba(0,0,0,.2)}.preset small{display:block;color:var(--muted);font-size:11px;font-weight:500;margin-top:4px;line-height:1.35}.preset:active{transform:scale(.985);background:var(--panel2)}.preset.active{border-color:var(--accent);background:#0f2b45;box-shadow:0 0 0 2px rgba(56,189,248,.12),0 10px 25px rgba(0,0,0,.2)}.quickStatus{min-height:22px;color:var(--ok);font-size:12px;text-align:center;margin:2px 0 12px}.previewBtn{width:100%;min-height:49px;border:1px solid #1d4ed8;border-radius:14px;background:linear-gradient(135deg,#0369a1,#0284c7);color:#fff;font:inherit;font-weight:800;font-size:15px;cursor:pointer;box-shadow:0 12px 28px rgba(2,132,199,.22)}.previewMeta{color:var(--muted);font-size:11px;text-align:center;margin:7px 0 0}.styleRow{display:grid;grid-template-columns:1fr 40px 64px;gap:9px;align-items:center;min-height:54px;padding:9px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.styleRow:last-child{border-bottom:0}.styleLabel{font-size:14px;font-weight:650}.styleColor{width:34px;height:34px;border:0;padding:0;background:transparent}.styleSize{padding:0 7px!important;text-align:center!important;min-height:38px!important}.orderItem,.diagRow{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:54px;padding:9px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.orderItem:last-child,.diagRow:last-child{border-bottom:0}.orderActions{display:flex;gap:7px}.orderBtn{width:34px;height:34px;border:1px solid var(--border);border-radius:10px;background:#243149;color:var(--accent);font-size:14px;font-weight:750;cursor:pointer}.orderBtn:disabled{opacity:.24}.diagTitle{font-size:14px;font-weight:650}.diagDetail{font-size:11px;color:var(--muted);margin-top:3px;max-width:330px}.diagState{font-size:11px;font-weight:800;white-space:nowrap}.diagState.ok{color:var(--ok)}.diagState.off{color:#64748b}.diagState.error{color:var(--danger)}.diagState.checking{color:#facc15}.actionGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px}.actionBtn{min-height:44px;border:0;border-radius:12px;background:var(--accent2);color:#fff;font:inherit;font-weight:750;padding:10px 12px;cursor:pointer}.actionBtn.secondary{background:#243149;border:1px solid var(--border)}.actionBtn.danger{background:#3a1720;border:1px solid #6b2738;color:#fecdd3}.apiActions{display:flex;gap:8px;flex-wrap:wrap;padding:0 14px 13px}.apiLink{border:1px solid #1d4ed8;border-radius:10px;background:#0f1f46;color:#bfdbfe;padding:9px 11px;font:inherit;font-size:12px;font-weight:750;cursor:pointer}.status{min-height:20px;color:var(--ok);font-size:12px;padding:0 14px 12px}.empty{padding:16px;color:var(--muted);font-size:13px}.footer{color:#64748b;text-align:center;font-size:.76rem;margin:16px 4px 0}.langBadge{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid #1d4ed8;border-radius:999px;background:#0f1f46;color:#bfdbfe;font-size:.78rem;font-weight:700}.previewOverlay{position:fixed;z-index:99999;inset:0;background:rgba(3,7,18,.94);backdrop-filter:blur(16px);display:none;flex-direction:column;padding:calc(10px + env(safe-area-inset-top)) 10px calc(10px + env(safe-area-inset-bottom))}.previewOverlay.show{display:flex}.previewTop{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:4px 4px 10px}.previewTitle{font-size:15px;font-weight:800}.previewClose{border:1px solid var(--border);background:#243149;color:#fff;border-radius:10px;padding:8px 12px;font:inherit;font-weight:700}.previewFrame{flex:1;min-height:0;display:grid;place-items:center;overflow:auto}.previewFrame img{display:block;max-width:100%;max-height:100%;object-fit:contain;border-radius:18px;box-shadow:0 20px 70px rgba(0,0,0,.55)}\n  @media(max-width:520px){body{padding-left:14px;padding-right:14px}.hero{padding:20px}.hero h1,.screenTitle{font-size:25px}.navRow,.settingRow{padding-left:12px;padding-right:12px}.presetGrid{gap:7px}}\n  @media(max-width:360px){.presetGrid,.actionGrid{grid-template-columns:1fr}.navDetail{display:none}.styleRow{grid-template-columns:1fr 36px 58px}}\n  </style></head><body>\n  <div class=\"screen active\" id=\"home\"><div class=\"hero\"><div class=\"heroTop\"><div class=\"eyebrow\">📱 Scriptable • v${APP_VERSION}</div><button type=\"button\" id=\"updateBtn\" class=\"updateBtn\" onclick=\"requestUpdate()\">↻ ${up.update}</button></div><div id=\"updateStatus\" class=\"updateStatus\"></div><h1>LockScreen Generator</h1><p>${u(\"subtitle\")}</p></div><button id=\"previewBtn\" class=\"previewBtn\" onclick=\"nativeAction('preview')\">👁 ${u(\"preview\")}</button><div id=\"previewMeta\" class=\"previewMeta\">${u(\"previewHint\")}</div><div class=\"info\">${u(\"saveHint\")}</div><div class=\"sectionTitle\">${u(\"quick\")}</div><div class=\"presetGrid\"><button type=\"button\" class=\"preset\" data-preset=\"minimal\" onclick=\"applyPreset('minimal')\">✨ ${u(\"minimal\")}<small>${u(\"minimalD\")}</small></button><button type=\"button\" class=\"preset\" data-preset=\"productivity\" onclick=\"applyPreset('productivity')\">✅ ${u(\"productivity\")}<small>${u(\"productivityD\")}</small></button><button type=\"button\" class=\"preset\" data-preset=\"info\" onclick=\"applyPreset('info')\">📊 ${u(\"info\")}<small>${u(\"infoD\")}</small></button><button type=\"button\" class=\"preset\" data-preset=\"all\" onclick=\"applyPreset('all')\">🧩 ${u(\"all\")}<small>${u(\"allD\")}</small></button></div><div id=\"quickStatus\" class=\"quickStatus\"></div><div class=\"sectionTitle\">${u(\"content\")}</div><div class=\"card\">${nav(\"content\",\"👁\",u(\"what\"),u(\"modules\"))}${nav(\"order\",\"🔀\",u(\"order\"))}${nav(\"calendar\",\"📅\",u(\"calendarReminders\"))}</div><div class=\"sectionTitle\">${u(\"appearance\")}</div><div class=\"card\">${nav(\"layout\",\"📐\",u(\"layout\"),settings.responsiveLayout?u(\"automatic\"):u(\"manual\"))}${nav(\"style\",\"🎨\",u(\"colorsFonts\"))}${nav(\"texts\",\"🌐\",u(\"textsLocalization\"),settings.language.toUpperCase())}</div><div class=\"sectionTitle\">${u(\"modules\")}</div><div class=\"card\">${nav(\"weather\",\"🌤\",u(\"weather\"))}${nav(\"f1\",\"🏎\",u(\"f1\"))}${nav(\"sports\",\"🏆\",u(\"sport\"))}${nav(\"finance\",\"📈\",u(\"finance\"))}${nav(\"other\",\"🧩\",u(\"otherModules\"))}</div><div class=\"sectionTitle\">${u(\"tools\")}</div><div class=\"card\">${nav(\"api\",\"🔑\",a.title)}${nav(\"diagnostics\",\"🧪\",u(\"diagnostics\"))}${nav(\"maintenance\",\"💾\",u(\"maintenance\"))}</div><div class=\"footer\"><span class=\"langBadge\">${settings.language.toUpperCase()} • LockScreen Generator ${APP_VERSION}</span></div></div>\n  <div class=\"screen\" id=\"content\">${back}<div class=\"screenTitle\">${u(\"what\")}</div><div class=\"screenSub\">${u(\"whatSub\")}</div><div class=\"sectionTitle\">${u(\"modules\")}</div><div class=\"card\">${moduleRows}</div></div>\n  <div class=\"screen\" id=\"order\">${back}<div class=\"screenTitle\">${u(\"order\")}</div><div class=\"screenSub\">${u(\"orderSub\")}</div><div class=\"sectionTitle\">${u(\"modules\")}</div><div class=\"card\" id=\"orderList\"></div></div>\n  <div class=\"screen\" id=\"calendar\">${back}<div class=\"screenTitle\">${u(\"calendarReminders\")}</div><div class=\"info\">${phoneText.hint}</div><button type=\"button\" class=\"previewBtn\" id=\"loadPhoneSources\" onclick=\"loadPhoneSources()\">${phoneText.load}</button><div id=\"phoneSourcesStatus\" class=\"previewMeta\"></div><div class=\"sectionTitle\">${u(\"display\")}</div><div class=\"card\">${field(\"daysToShow\",u(\"days\"),settings.daysToShow,\"number\",'min=\"1\" max=\"7\"')}${field(\"maxEventsPerDay\",u(\"maxItems\"),settings.maxEventsPerDay,\"number\",'min=\"1\" max=\"20\"')}${sw(\"hidePastEvents\",u(\"hidePast\"),settings.hidePastEvents)}${sw(\"remindersWithoutDateOnToday\",u(\"undatedToday\"),settings.remindersWithoutDateOnToday)}</div><div class=\"sectionTitle\">${u(\"calendars\")}</div><div class=\"card\" id=\"calendarSourceList\">${savedCalRows||`<div class=\"empty\">${phoneText.load}</div>`}</div><div class=\"sectionTitle\">${u(\"reminderLists\")}</div><div class=\"card\" id=\"reminderSourceList\">${savedRemRows||`<div class=\"empty\">${phoneText.load}</div>`}</div></div>\n  <div class=\"screen\" id=\"layout\">${back}<div class=\"screenTitle\">${u(\"layout\")}</div><div class=\"info\">${u(\"responsiveInfo\")}</div><div class=\"sectionTitle\">${u(\"automation\")}</div><div class=\"card\">${sw(\"responsiveLayout\",u(\"adapt\"),settings.responsiveLayout)}${sw(\"compactMode\",u(\"compact\"),settings.compactMode,u(\"compactD\"))}${sw(\"autoFitContent\",u(\"autoFit\"),settings.autoFitContent,u(\"autoFitD\"))}${field(\"minContentScale\",u(\"minScale\"),settings.minContentScale,\"number\",'min=\"0.5\" max=\"1\" step=\"0.02\"')}${field(\"contentScale\",u(\"scale\"),settings.contentScale,\"number\",'min=\"0.6\" max=\"1.4\" step=\"0.05\"')}</div><div class=\"sectionTitle\">${u(\"position\")}</div><div class=\"card\"><div class=\"field\"><label>${u(\"alignment\")}</label><select id=\"layoutStyle\"><option value=\"left\" ${settings.layoutStyle===\"left\"?\"selected\":\"\"}>⬅️ ${u(\"left\")}</option><option value=\"center\" ${settings.layoutStyle===\"center\"?\"selected\":\"\"}>🎯 ${u(\"center\")}</option></select></div><div class=\"field\"><label>${t.reminders}</label><select id=\"remindersAlign\"><option value=\"left\" ${settings.remindersAlign===\"left\"?\"selected\":\"\"}>⬅️ ${u(\"left\")}</option><option value=\"right\" ${settings.remindersAlign===\"right\"?\"selected\":\"\"}>➡️ ${u(\"right\")}</option></select></div>${field(\"startY\",u(\"contentStart\"),settings.startY,\"number\")}${field(\"marginX\",u(\"sideMargin\"),settings.marginX,\"number\")}</div><div class=\"sectionTitle\">${u(\"spacing\")}</div><div class=\"card\">${field(\"lineSpacing\",u(\"lineSpacing\"),settings.lineSpacing,\"number\",'min=\"0\" max=\"60\"')}${field(\"blockSpacing\",u(\"blockSpacing\"),settings.blockSpacing,\"number\",'min=\"0\" max=\"120\"')}${field(\"iconSize\",u(\"iconSize\"),settings.iconSize,\"number\",'min=\"12\" max=\"80\"')}</div></div>\n  <div class=\"screen\" id=\"style\">${back}<div class=\"screenTitle\">${u(\"colorsFonts\")}</div><div class=\"screenSub\">${u(\"styleSub\")}</div><div class=\"sectionTitle\">${u(\"styles\")}</div><div class=\"card\">${styleRows}</div></div>\n  <div class=\"screen\" id=\"texts\">${back}<div class=\"screenTitle\">${u(\"textsLocalization\")}</div><div class=\"sectionTitle\">${u(\"language\")}</div><div class=\"card\"><div class=\"field\"><label>${u(\"language\")}</label><select id=\"language\"><option value=\"cs\" ${settings.language===\"cs\"?\"selected\":\"\"}>🇨🇿 Čeština</option><option value=\"en\" ${settings.language===\"en\"?\"selected\":\"\"}>🇬🇧 English</option><option value=\"de\" ${settings.language===\"de\"?\"selected\":\"\"}>🇩🇪 Deutsch</option><option value=\"es\" ${settings.language===\"es\"?\"selected\":\"\"}>🇪🇸 Español</option></select></div>${field(\"customDateFormat\",u(\"dateFormat\"),settings.customDateFormat)}</div><div class=\"sectionTitle\">${u(\"customText\")}</div><div class=\"card\">${field(\"labelToday\",u(\"today\"),settings.labelToday)}${field(\"labelTomorrow\",u(\"tomorrow\"),settings.labelTomorrow)}${field(\"noEventsText\",u(\"noEventsText\"),settings.noEventsText)}${field(\"nameDayLabel\",u(\"nameDayLabel\"),settings.nameDayLabel)}</div><div class=\"sectionTitle\">${u(\"nameDays\")}</div><div class=\"card\"><div class=\"field\"><label>${u(\"country\")}</label><select id=\"nameDayCountry\">${countryOptions}</select></div></div></div>\n  <div class=\"screen\" id=\"weather\">${back}<div class=\"screenTitle\">${u(\"weather\")}</div><div class=\"sectionTitle\">${u(\"forecast\")}</div><div class=\"card\">${field(\"weatherForecastDays\",u(\"forecastDays\"),settings.weatherForecastDays,\"number\",'min=\"1\" max=\"7\"')}${sw(\"showWeatherIcon\",u(\"showWeatherIcon\"),settings.showWeatherIcon)}<div class=\"field\"><label>${u(\"units\")}</label><select id=\"weatherUnit\"><option value=\"celsius\" ${settings.weatherUnit===\"celsius\"?\"selected\":\"\"}>Celsius °C</option><option value=\"fahrenheit\" ${settings.weatherUnit===\"fahrenheit\"?\"selected\":\"\"}>Fahrenheit °F</option></select></div></div></div>\n  <div class=\"screen\" id=\"f1\">${back}<div class=\"screenTitle\">${u(\"f1\")}</div><div class=\"screenSub\">${u(\"f1Sub\")}</div><div class=\"sectionTitle\">${u(\"display\")}</div><div class=\"card\">${sw(\"showF1\",u(\"f1\"),settings.showF1)}${sw(\"showF1Practice\",u(\"f1Practice\"),settings.showF1Practice)}${sw(\"showF1Qualifying\",u(\"f1Qualifying\"),settings.showF1Qualifying)}${sw(\"showF1Sprint\",u(\"f1Sprint\"),settings.showF1Sprint)}${sw(\"showF1Race\",u(\"f1Race\"),settings.showF1Race)}</div></div>\n  <div class=\"screen\" id=\"sports\">${back}<div class=\"screenTitle\">${u(\"sport\")}</div><div class=\"card\"><div class=\"field\"><label>${u(\"league\")}</label><select id=\"sportsLeague\"><option value=\"NHL\" ${settings.sportsLeague===\"NHL\"?\"selected\":\"\"}>🏒 NHL</option><option value=\"NBA\" ${settings.sportsLeague===\"NBA\"?\"selected\":\"\"}>🏀 NBA</option><option value=\"NFL\" ${settings.sportsLeague===\"NFL\"?\"selected\":\"\"}>🏈 NFL</option><option value=\"MLB\" ${settings.sportsLeague===\"MLB\"?\"selected\":\"\"}>⚾ MLB</option></select></div>${field(\"sportsTeam\",u(\"team\"),settings.sportsTeam)}</div></div>\n  <div class=\"screen\" id=\"finance\">${back}<div class=\"screenTitle\">${u(\"finance\")}</div><div class=\"card\">${field(\"stockSymbols\",u(\"stocks\"),settings.stockSymbols)}${field(\"cryptoCoins\",u(\"crypto\"),settings.cryptoCoins)}${field(\"exchangeCurrencies\",u(\"currencies\"),settings.exchangeCurrencies)}</div></div>\n  <div class=\"screen\" id=\"other\">${back}<div class=\"screenTitle\">${u(\"otherModules\")}</div><div class=\"sectionTitle\">${u(\"note\")}</div><div class=\"card\">${field(\"customNotesText\",u(\"custom\"),settings.customNotesText)}</div><div class=\"sectionTitle\">${u(\"countdown\")}</div><div class=\"card\">${field(\"countdownTitle\",u(\"title\"),settings.countdownTitle)}${field(\"countdownDate\",u(\"date\"),settings.countdownDate,\"date\")}</div><div class=\"sectionTitle\">Fitness</div><div class=\"card\">${field(\"stepsGoal\",u(\"stepGoal\"),settings.stepsGoal,\"number\",'min=\"1\"')}<div class=\"info warning\">${u(\"fitnessInfo\")}</div></div><div class=\"sectionTitle\">${u(\"newsTime\")}</div><div class=\"card\">${field(\"newsFeedUrl\",u(\"rss\"),settings.newsFeedUrl)}${field(\"worldClockCities\",u(\"cities\"),settings.worldClockCities)}</div></div>\n  <div class=\"screen\" id=\"api\">${back}<div class=\"screenTitle\">🔑 ${a.title}</div><div class=\"screenSub\">${a.sub}</div><div class=\"info\">🔐 ${a.privacy}</div>\n  <div class=\"sectionTitle\">🌤 ${u(\"weather\")}</div><div class=\"card\"><div class=\"field\"><label>${a.provider}</label><select id=\"weatherProvider\"><option value=\"openmeteo\" ${settings.weatherProvider!==\"openweathermap\"?\"selected\":\"\"}>${a.weatherFree}</option><option value=\"openweathermap\" ${settings.weatherProvider===\"openweathermap\"?\"selected\":\"\"}>${a.weatherOwn}</option></select></div>${field(\"openWeatherApiKey\",a.key,settings.openWeatherApiKey||\"\",\"password\",'autocomplete=\"off\"')}<div class=\"apiActions\"><button type=\"button\" class=\"apiLink\" onclick=\"openExternal('https://home.openweathermap.org/users/sign_up')\">🔑 ${a.getKey}</button><button type=\"button\" class=\"apiLink\" onclick=\"openExternal('https://openweathermap.org/api')\">↗ ${a.docs}</button></div></div>\n  <div class=\"sectionTitle\">📈 ${u(\"stocks\")}</div><div class=\"card\"><div class=\"field\"><label>${a.provider}</label><select id=\"stockProvider\"><option value=\"yahoo\" ${settings.stockProvider!==\"alphavantage\"?\"selected\":\"\"}>${a.yahoo}</option><option value=\"alphavantage\" ${settings.stockProvider===\"alphavantage\"?\"selected\":\"\"}>${a.alpha}</option></select></div>${field(\"alphaVantageKey\",a.key,settings.alphaVantageKey||\"\",\"password\",'autocomplete=\"off\"')}<div class=\"apiActions\"><button type=\"button\" class=\"apiLink\" onclick=\"openExternal('https://www.alphavantage.co/support/#api-key')\">🔑 ${a.getKey}</button><button type=\"button\" class=\"apiLink\" onclick=\"openExternal('https://www.alphavantage.co/documentation/')\">↗ ${a.docs}</button></div></div>\n  <div class=\"sectionTitle\">💱 ${u(\"exchange\")}</div><div class=\"card\"><div class=\"field\"><label>${a.provider}</label><select id=\"exchangeProvider\"><option value=\"open\" ${settings.exchangeProvider!==\"keyed\"?\"selected\":\"\"}>${a.exchangeOpen}</option><option value=\"keyed\" ${settings.exchangeProvider===\"keyed\"?\"selected\":\"\"}>${a.exchangeKey}</option></select></div>${field(\"exchangeApiKey\",a.key,settings.exchangeApiKey||\"\",\"password\",'autocomplete=\"off\"')}<div class=\"apiActions\"><button type=\"button\" class=\"apiLink\" onclick=\"openExternal('https://www.exchangerate-api.com/')\">🔑 ${a.getKey}</button><button type=\"button\" class=\"apiLink\" onclick=\"openExternal('https://www.exchangerate-api.com/docs/overview')\">↗ ${a.docs}</button></div></div>\n  <div class=\"info\">✓ ${a.free}</div></div>\n  <div class=\"screen\" id=\"diagnostics\">${back}<div class=\"screenTitle\">${u(\"diagnostics\")}</div><div class=\"screenSub\">${u(\"diagnosticsSub\")}</div><div class=\"info\">${u(\"testedOpen\")}</div><div class=\"card\" id=\"diagList\">${diagRows}</div></div>\n  <div class=\"screen\" id=\"maintenance\">${back}<div class=\"screenTitle\">${u(\"maintenance\")}</div><div class=\"screenSub\">${u(\"jsonHint\")}</div><div class=\"sectionTitle\">${u(\"exportImport\")}</div><div class=\"card\"><div class=\"field\"><textarea id=\"jsonBox\" spellcheck=\"false\"></textarea></div><div class=\"actionGrid\"><button class=\"actionBtn\" onclick=\"exportJSON()\">${u(\"exportSettings\")}</button><button class=\"actionBtn secondary\" onclick=\"importJSON()\">${u(\"importSettings\")}</button></div><div id=\"toolStatus\" class=\"status\"></div></div><div class=\"sectionTitle\">Reset</div><div class=\"card\"><div class=\"actionGrid\"><button class=\"actionBtn secondary\" onclick=\"resetPart('appearance')\">${u(\"resetAppearance\")}</button><button class=\"actionBtn secondary\" onclick=\"resetPart('modules')\">${u(\"resetModules\")}</button><button class=\"actionBtn danger\" onclick=\"resetPart('all')\">${u(\"resetAll\")}</button></div></div></div>\n  <div id=\"previewOverlay\" class=\"previewOverlay\"><div class=\"previewTop\"><div class=\"previewTitle\">👁 ${u(\"preview\")}</div><button class=\"previewClose\" onclick=\"hidePreview()\">${u(\"closePreview\")}</button></div><div class=\"previewFrame\"><img id=\"previewImage\" alt=\"Preview\"></div></div>\n  <script>\n  const ORDER_META=${JSON.stringify(orderMeta)},DEFAULTS=${JSON.stringify(DEFAULT_SETTINGS)},CAL_NAMES=[],REM_NAMES=[],SHOW_KEYS=${JSON.stringify(Object.values(MODULES).map(v=>v.showKey))},PHONE_TEXT=${JSON.stringify(phoneText)};let sectionOrder=${JSON.stringify(settings.sectionOrder)};window.__nativeQueue=[];window.__sourcesLoaded=false;window.__updateReady=false;\n  function showScreen(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}\n  function renderOrder(){const root=document.getElementById('orderList');root.innerHTML='';sectionOrder.forEach((key,i)=>{const row=document.createElement('div');row.className='orderItem';row.innerHTML='<span>'+ORDER_META[key]+'</span><div class=\"orderActions\"><button class=\"orderBtn\" '+(i===0?'disabled':'')+' onclick=\"moveOrder('+i+',-1)\">▲</button><button class=\"orderBtn\" '+(i===sectionOrder.length-1?'disabled':'')+' onclick=\"moveOrder('+i+',1)\">▼</button></div>';root.appendChild(row)})}function moveOrder(i,d){const n=i+d;if(n<0||n>=sectionOrder.length)return;[sectionOrder[i],sectionOrder[n]]=[sectionOrder[n],sectionOrder[i]];renderOrder()}renderOrder();\n  function setCheck(id,value){document.querySelectorAll('[id=\"'+id+'\"]').forEach(el=>{if(el.type==='checkbox')el.checked=!!value})}\n  document.addEventListener('change',e=>{if(e.target?.type==='checkbox'&&e.target.id)document.querySelectorAll('[id=\"'+e.target.id+'\"]').forEach(el=>{if(el!==e.target&&el.type==='checkbox')el.checked=e.target.checked})});\n  function applyPreset(name){SHOW_KEYS.forEach(id=>setCheck(id,false));if(name==='minimal')['showEvents','showWeather','showWeatherForecast','showBattery'].forEach(id=>setCheck(id,true));if(name==='productivity')['showEvents','showReminders','showWeather','showWeatherForecast','showNameDay','showBattery'].forEach(id=>setCheck(id,true));if(name==='info')['showEvents','showReminders','showWeather','showWeatherForecast','showNameDay','showStocks','showCrypto','showExchangeRates','showNews','showBattery','showSystemMetrics'].forEach(id=>setCheck(id,true));if(name==='all')SHOW_KEYS.forEach(id=>setCheck(id,true));document.querySelectorAll('[data-preset]').forEach(b=>b.classList.toggle('active',b.dataset.preset===name));const count=SHOW_KEYS.filter(id=>!!document.getElementById(id)?.checked).length;document.getElementById('quickStatus').textContent='✓ '+count+' / '+SHOW_KEYS.length}\n  function collectSettings(){const cals=[],rems=[];document.querySelectorAll('[data-source-kind=\"calendar\"]').forEach(e=>{if(e.checked)cals.push(e.dataset.sourceName)});document.querySelectorAll('[data-source-kind=\"reminder\"]').forEach(e=>{if(e.checked)rems.push(e.dataset.sourceName)});const sectionStyle={};document.querySelectorAll('.styleColor').forEach(e=>sectionStyle[e.dataset.key]={color:e.value,size:26});document.querySelectorAll('.styleSize').forEach(e=>{if(sectionStyle[e.dataset.key])sectionStyle[e.dataset.key].size=parseInt(e.value)||26});const v=id=>document.getElementById(id)?.value,c=id=>!!document.getElementById(id)?.checked;return JSON.stringify({calendars:cals,reminderLists:rems,sectionOrder,sectionStyle,language:v('language'),showEvents:c('showEvents'),showReminders:c('showReminders'),showWeather:c('showWeather'),showWeatherForecast:c('showWeatherForecast'),showNameDay:c('showNameDay'),showF1:c('showF1'),showF1Practice:c('showF1Practice'),showF1Qualifying:c('showF1Qualifying'),showF1Sprint:c('showF1Sprint'),showF1Race:c('showF1Race'),showSports:c('showSports'),showQuotes:c('showQuotes'),showStocks:c('showStocks'),showCrypto:c('showCrypto'),showExchangeRates:c('showExchangeRates'),showCustomNotes:c('showCustomNotes'),showCountdowns:c('showCountdowns'),showFitness:c('showFitness'),showNews:c('showNews'),showMoonPhase:c('showMoonPhase'),showWorldClocks:c('showWorldClocks'),showBattery:c('showBattery'),showSystemMetrics:c('showSystemMetrics'),hidePastEvents:c('hidePastEvents'),remindersWithoutDateOnToday:c('remindersWithoutDateOnToday'),responsiveLayout:c('responsiveLayout'),compactMode:c('compactMode'),autoFitContent:c('autoFitContent'),showWeatherIcon:c('showWeatherIcon'),daysToShow:Math.min(7,Math.max(1,parseInt(v('daysToShow'))||2)),maxEventsPerDay:Math.max(1,parseInt(v('maxEventsPerDay'))||5),labelToday:v('labelToday')||'',labelTomorrow:v('labelTomorrow')||'',noEventsText:v('noEventsText')||'',customDateFormat:v('customDateFormat')||'EEEE, d. M.',nameDayLabel:v('nameDayLabel')||'',nameDayCountry:v('nameDayCountry')||'',layoutStyle:v('layoutStyle')||'left',remindersAlign:v('remindersAlign')||'right',startY:parseFloat(v('startY'))||950,marginX:parseFloat(v('marginX'))||60,contentScale:Math.min(1.4,Math.max(.6,parseFloat(v('contentScale'))||1)),minContentScale:Math.min(1,Math.max(.5,parseFloat(v('minContentScale'))||.72)),lineSpacing:Math.max(0,parseFloat(v('lineSpacing'))||0),blockSpacing:Math.max(0,parseFloat(v('blockSpacing'))||0),iconSize:Math.max(12,parseFloat(v('iconSize'))||28),weatherForecastDays:Math.min(7,Math.max(1,parseInt(v('weatherForecastDays'))||4)),weatherUnit:v('weatherUnit')||'celsius',weatherProvider:v('weatherProvider')||'openmeteo',openWeatherApiKey:v('openWeatherApiKey')||'',sportsLeague:v('sportsLeague')||'NHL',sportsTeam:v('sportsTeam')||'',stockSymbols:v('stockSymbols')||'',cryptoCoins:v('cryptoCoins')||'',exchangeCurrencies:v('exchangeCurrencies')||'',customNotesText:v('customNotesText')||'',countdownTitle:v('countdownTitle')||'',countdownDate:v('countdownDate')||'',stepsGoal:Math.max(1,parseInt(v('stepsGoal'))||10000),newsFeedUrl:v('newsFeedUrl')||'',worldClockCities:v('worldClockCities')||'',apiWeatherBase:v('apiWeatherBase')||DEFAULTS.apiWeatherBase,apiNameDayCzBase:v('apiNameDayCzBase')||DEFAULTS.apiNameDayCzBase,apiNameDayGlobalBase:v('apiNameDayGlobalBase')||DEFAULTS.apiNameDayGlobalBase,apiF1Base:v('apiF1Base')||DEFAULTS.apiF1Base,apiSportsBase:v('apiSportsBase')||DEFAULTS.apiSportsBase,stockProvider:v('stockProvider')||'yahoo',apiYahooBase:v('apiYahooBase')||DEFAULTS.apiYahooBase,apiAlphaVantageBase:v('apiAlphaVantageBase')||DEFAULTS.apiAlphaVantageBase,alphaVantageKey:v('alphaVantageKey')||'',apiCoinbaseBase:v('apiCoinbaseBase')||DEFAULTS.apiCoinbaseBase,exchangeProvider:v('exchangeProvider')||'open',apiExchangeOpenBase:v('apiExchangeOpenBase')||DEFAULTS.apiExchangeOpenBase,apiExchangeKeyedBase:v('apiExchangeKeyedBase')||DEFAULTS.apiExchangeKeyedBase,exchangeApiKey:v('exchangeApiKey')||''})}\n  function applyObject(o){if(!o||typeof o!=='object')return;if(Array.isArray(o.sectionOrder)){sectionOrder=o.sectionOrder.filter(k=>ORDER_META[k]);Object.keys(ORDER_META).forEach(k=>{if(!sectionOrder.includes(k))sectionOrder.push(k)});renderOrder()}if(o.sectionStyle){document.querySelectorAll('.styleColor').forEach(e=>{if(o.sectionStyle[e.dataset.key]?.color)e.value=o.sectionStyle[e.dataset.key].color});document.querySelectorAll('.styleSize').forEach(e=>{if(o.sectionStyle[e.dataset.key]?.size)e.value=o.sectionStyle[e.dataset.key].size})}for(const [k,val] of Object.entries(o)){const el=document.getElementById(k);if(!el)continue;if(el.type==='checkbox')el.checked=!!val;else if(k!=='jsonBox'&&val!==null&&typeof val!=='object')el.value=val}if(Array.isArray(o.calendars))document.querySelectorAll('[data-source-kind=\"calendar\"]').forEach(e=>e.checked=o.calendars.includes(e.dataset.sourceName));if(Array.isArray(o.reminderLists))document.querySelectorAll('[data-source-kind=\"reminder\"]').forEach(e=>e.checked=o.reminderLists.includes(e.dataset.sourceName))}\n  async function copyBox(){const box=document.getElementById('jsonBox');try{await navigator.clipboard.writeText(box.value)}catch(_){box.focus();box.select();try{document.execCommand('copy')}catch(_){}}}\n  async function exportJSON(){const box=document.getElementById('jsonBox'),status=document.getElementById('toolStatus'),safe=JSON.parse(collectSettings());delete safe.openWeatherApiKey;delete safe.alphaVantageKey;delete safe.exchangeApiKey;box.value=JSON.stringify(safe,null,2);await copyBox();status.textContent=${JSON.stringify(u(\"copied\"))}}\n  function importJSON(){const box=document.getElementById('jsonBox'),status=document.getElementById('toolStatus');try{const obj=JSON.parse(box.value);applyObject(obj);status.textContent=${JSON.stringify(u(\"imported\"))}}catch(_){status.textContent=${JSON.stringify(u(\"invalidJson\"))}}}\n  function resetPart(part){if(!confirm(${JSON.stringify(u(\"confirmReset\"))}))return;if(part==='all'){applyObject(DEFAULTS);return}if(part==='modules'){const o={sectionOrder:DEFAULTS.sectionOrder};SHOW_KEYS.forEach(k=>o[k]=DEFAULTS[k]);o.showF1Practice=DEFAULTS.showF1Practice;o.showF1Qualifying=DEFAULTS.showF1Qualifying;o.showF1Sprint=DEFAULTS.showF1Sprint;o.showF1Race=DEFAULTS.showF1Race;applyObject(o);return}const keys=['responsiveLayout','compactMode','autoFitContent','minContentScale','contentScale','layoutStyle','remindersAlign','startY','marginX','lineSpacing','blockSpacing','iconSize','sectionStyle'];const o={};keys.forEach(k=>o[k]=DEFAULTS[k]);applyObject(o)}\n  function nativeAction(action){const btn=document.getElementById('previewBtn');if(action==='preview'){btn.disabled=true;btn.textContent='⏳ '+${JSON.stringify(u(\"previewWorking\"))};document.getElementById('previewMeta').textContent=${JSON.stringify(u(\"previewWorking\"))}}window.__nativeQueue.push({action,settings:collectSettings(),nonce:Date.now()+Math.random()})}\n  function requestUpdate(){const b=document.getElementById('updateBtn'),st=document.getElementById('updateStatus');b.disabled=true;if(window.__updateReady){b.textContent='⏳ '+${JSON.stringify(up.installing)};st.className='updateStatus warn';st.textContent='';nativeAction('installUpdate')}else{b.textContent='⏳ '+${JSON.stringify(up.checking)};st.className='updateStatus';st.textContent='';nativeAction('checkUpdate')}}\n  function updateCheckResult(r){const b=document.getElementById('updateBtn'),st=document.getElementById('updateStatus');b.disabled=false;if(!r||r.error){window.__updateReady=false;b.textContent='↻ '+${JSON.stringify(up.update)};st.className='updateStatus error';st.textContent='⚠️ '+${JSON.stringify(up.failed)};return}if(r.available){window.__updateReady=true;b.textContent='⬇️ '+${JSON.stringify(up.install)}+' v'+r.version;st.className='updateStatus warn';st.textContent='● '+${JSON.stringify(up.available)}+' v'+r.version}else{window.__updateReady=false;b.textContent='✓ '+${JSON.stringify(up.current)};st.className='updateStatus ok';st.textContent='v'+${JSON.stringify(APP_VERSION)}}}\n  function updateInstalled(r){const b=document.getElementById('updateBtn'),st=document.getElementById('updateStatus');window.__updateReady=false;b.disabled=true;b.textContent='✅ '+${JSON.stringify(up.installed)}+' v'+(r?.version||'');st.className='updateStatus ok';st.textContent='✓ '+${JSON.stringify(up.restart+\" \"+up.backup)}}\n  function updateInstallFailed(){const b=document.getElementById('updateBtn'),st=document.getElementById('updateStatus');b.disabled=false;window.__updateReady=false;b.textContent='↻ '+${JSON.stringify(up.update)};st.className='updateStatus error';st.textContent='⚠️ '+${JSON.stringify(up.failed)}}\n  function showPreview(src){const btn=document.getElementById('previewBtn');btn.disabled=false;btn.textContent='👁 '+${JSON.stringify(u(\"preview\"))};document.getElementById('previewMeta').textContent=${JSON.stringify(u(\"previewHint\"))};document.getElementById('previewImage').src=src;document.getElementById('previewOverlay').classList.add('show')}\n  function previewFailed(){const btn=document.getElementById('previewBtn');btn.disabled=false;btn.textContent='👁 '+${JSON.stringify(u(\"preview\"))};document.getElementById('previewMeta').textContent=${JSON.stringify(u(\"previewHint\"))}}\n  function hidePreview(){document.getElementById('previewOverlay').classList.remove('show')}\n  function sourceRow(kind,name,checked){const safe=String(name);const row=document.createElement('label');row.className='settingRow';const text=document.createElement('div');text.className='rowText';const title=document.createElement('div');title.className='rowTitle';title.textContent=safe;text.appendChild(title);const sw=document.createElement('span');sw.className='switch';const input=document.createElement('input');input.type='checkbox';input.dataset.sourceKind=kind;input.dataset.sourceName=safe;input.checked=checked;const slider=document.createElement('span');slider.className='slider';sw.appendChild(input);sw.appendChild(slider);row.appendChild(text);row.appendChild(sw);return row}\n  function loadPhoneSources(){const b=document.getElementById('loadPhoneSources');b.disabled=true;document.getElementById('phoneSourcesStatus').textContent=PHONE_TEXT.loading;nativeAction('calendarSources')}\n  function renderPhoneSources(data){const b=document.getElementById('loadPhoneSources'),status=document.getElementById('phoneSourcesStatus');b.disabled=false;status.textContent='';if(!data||data.error){status.textContent=PHONE_TEXT.denied;return}const current=JSON.parse(collectSettings()),cal=document.getElementById('calendarSourceList'),rem=document.getElementById('reminderSourceList');cal.innerHTML='';rem.innerHTML='';const cals=data.calendars||[],rems=data.reminders||[];if(!cals.length)cal.innerHTML='<div class=\"empty\">'+PHONE_TEXT.none+'</div>';else cals.forEach(n=>cal.appendChild(sourceRow('calendar',n,current.calendars.includes(n))));if(!rems.length)rem.innerHTML='<div class=\"empty\">'+PHONE_TEXT.none+'</div>';else rems.forEach(n=>rem.appendChild(sourceRow('reminder',n,current.reminderLists.includes(n))));window.__sourcesLoaded=true}\n  function openExternal(url){window.__nativeQueue.push({action:\"openURL\",url,nonce:Date.now()+Math.random()})}\n  function renderDiagnostics(rows){const root=document.getElementById('diagList');if(!root)return;root.innerHTML='';rows.forEach(d=>{const row=document.createElement('div');row.className='diagRow';const left=document.createElement('div');const title=document.createElement('div');title.className='diagTitle';title.textContent=d.label||'';left.appendChild(title);if(d.detail){const detail=document.createElement('div');detail.className='diagDetail';detail.textContent=d.detail;left.appendChild(detail)}const state=document.createElement('span');state.className='diagState '+(d.state||'error');state.textContent=d.state==='ok'?'● '+${JSON.stringify(u(\"statusOK\"))}:d.state==='off'?'● '+${JSON.stringify(u(\"statusOff\"))}:d.state==='checking'?'⏳':'● '+${JSON.stringify(u(\"statusError\"))};row.appendChild(left);row.appendChild(state);root.appendChild(row)})}\n  </script></body></html>`;\n\n  const wv=new WebView();await wv.loadHTML(html);\n  let dismissed=false;const presentPromise=wv.present(false).then(()=>{dismissed=true;return\"__closed__\"});\n  collectDiagnostics(settings).then(async rows=>{if(!dismissed){try{await wv.evaluateJavaScript(`renderDiagnostics(${JSON.stringify(rows)})`)}catch(_){}}}).catch(()=>{});\n  let pendingUpdateCode=null,pendingUpdateVersion=null;\n  const sleep=ms=>new Promise(resolve=>Timer.schedule(ms,false,resolve));\n  while(!dismissed){\n    await sleep(180);\n    if(dismissed)break;\n    let raw=null;try{raw=await wv.evaluateJavaScript(\"JSON.stringify(window.__nativeQueue.shift()||null)\")}catch(_){if(dismissed)break;continue}\n    if(!raw||raw===\"null\")continue;\n    try{const msg=JSON.parse(raw);if(msg.action===\"preview\"){const draft={...settings,...JSON.parse(msg.settings),settingsVersion:7,__preview:true};const image=await buildImage(resolveResolution(),draft);const dataUrl=\"data:image/png;base64,\"+Data.fromPNG(image).toBase64String();await wv.evaluateJavaScript(`showPreview(${JSON.stringify(dataUrl)})`)}else if(msg.action===\"checkUpdate\"){try{const r=await fetchScriptUpdate(),available=compareVersions(r.version,APP_VERSION)>0;if(available){pendingUpdateCode=r.code;pendingUpdateVersion=r.version}else{pendingUpdateCode=null;pendingUpdateVersion=null}await wv.evaluateJavaScript(`updateCheckResult(${JSON.stringify({available,version:r.version})})`)}catch(e){console.error(\"Update check failed: \"+e);pendingUpdateCode=null;pendingUpdateVersion=null;try{await wv.evaluateJavaScript(`updateCheckResult(${JSON.stringify({error:true})})`)}catch(_){}}}else if(msg.action===\"installUpdate\"){try{if(!pendingUpdateCode||!pendingUpdateVersion)throw new Error(\"No pending update\");await installScriptUpdate(pendingUpdateCode);const doneVersion=pendingUpdateVersion;pendingUpdateCode=null;pendingUpdateVersion=null;await wv.evaluateJavaScript(`updateInstalled(${JSON.stringify({version:doneVersion})})`)}catch(e){console.error(\"Update install failed: \"+e);try{await wv.evaluateJavaScript(\"updateInstallFailed()\") }catch(_){}}}else if(msg.action===\"openURL\"&&msg.url){Safari.open(msg.url)}else if(msg.action===\"calendarSources\"){let out={calendars:[],reminders:[],error:false};try{out.calendars=(await Calendar.forEvents()).map(x=>x.title).filter(Boolean).sort((a,b)=>a.localeCompare(b));out.reminders=(await Calendar.forReminders()).map(x=>x.title).filter(Boolean).sort((a,b)=>a.localeCompare(b))}catch(e){out.error=true;out.detail=String(e)}try{await wv.evaluateJavaScript(`renderPhoneSources(${JSON.stringify(out)})`)}catch(_){}}}catch(e){console.error(\"Settings action failed: \"+e);try{await wv.evaluateJavaScript(\"previewFailed()\") }catch(_){}}\n  }\n  await presentPromise;\n  try{const data=JSON.parse(await wv.evaluateJavaScript(\"collectSettings()\"));const sourcesLoaded=await wv.evaluateJavaScript(\"!!window.__sourcesLoaded\");settings={...settings,...data,calendarsConfigured:sourcesLoaded?true:settings.calendarsConfigured,settingsVersion:7};saveSettings(settings)}catch(e){console.error(\"Settings save failed: \"+e)}return settings\n}\n\nfunction resolveResolution(){if(CONFIG.width!==null&&CONFIG.height!==null)return{width:CONFIG.width,height:CONFIG.height};const r=Device.screenResolution();return{width:Math.min(r.width,r.height),height:Math.max(r.width,r.height)}}\nfunction layoutMetrics(size,settings){const sx=settings.responsiveLayout?size.width/REFERENCE.width:1,sy=settings.responsiveLayout?size.height/REFERENCE.height:1,deviceScale=Math.min(sx,sy),contentScale=Math.min(1.4,Math.max(.5,Number(settings.contentScale)||1)),scale=deviceScale*contentScale,compact=settings.compactMode?0.72:1;return{scale,x:n=>n*sx,y:n=>n*sy,font:n=>Math.max(10,Math.round(n*scale)),icon:Math.max(12,Math.round((settings.iconSize||28)*scale)),line:Math.round((settings.lineSpacing??10)*scale*compact),block:Math.round((settings.blockSpacing??40)*scale*compact)}}\nasync function resolveLocation(){if(CONFIG.latitude!==null&&CONFIG.longitude!==null)return{latitude:CONFIG.latitude,longitude:CONFIG.longitude};Location.setAccuracyToThreeKilometers();return await Location.current()}\nasync function fetchWeather(settings){try{const loc=await resolveLocation(),days=Math.min(7,Math.max(settings.daysToShow||2,(settings.weatherForecastDays||4)+1));let out=[];if(settings.weatherProvider===\"openweathermap\"){const key=String(settings.openWeatherApiKey||\"\").trim();if(!key)throw new Error(\"OpenWeatherMap API key missing\");const base=apiBase(settings.apiOpenWeatherBase,\"https://api.openweathermap.org/data/2.5\"),data=await timedRequest(`${base}/forecast?lat=${loc.latitude}&lon=${loc.longitude}&appid=${encodeURIComponent(key)}&units=metric`).loadJSON(),groups={};for(const row of(data.list||[])){const d=String(row.dt_txt||\"\").slice(0,10);if(!d)continue;(groups[d]||(groups[d]=[])).push(row)}out=Object.keys(groups).sort().slice(0,days).map(d=>{const rows=groups[d],temps=rows.flatMap(r=>[Number(r.main?.temp_min),Number(r.main?.temp_max)]).filter(Number.isFinite),code=openWeatherCode(rows[Math.floor(rows.length/2)]?.weather?.[0]?.id);return{min:Math.round(Math.min(...temps)),max:Math.round(Math.max(...temps)),code}})}else{const url=`${apiBase(settings.apiWeatherBase,\"https://api.open-meteo.com/v1/forecast\")}?latitude=${loc.latitude}&longitude=${loc.longitude}&daily=temperature_2m_max,temperature_2m_min,weathercode&timezone=auto&forecast_days=${days}`,data=await timedRequest(url).loadJSON();out=data.daily.time.map((_,i)=>({min:Math.round(data.daily.temperature_2m_min[i]),max:Math.round(data.daily.temperature_2m_max[i]),code:data.daily.weathercode[i]}))}settings.lastWeather=out;if(!settings.__preview)saveSettings(settings);return out}catch(_){return settings.lastWeather||[]}}\nfunction openWeatherCode(id){id=Number(id)||0;if(id===800)return 0;if(id>=801&&id<=804)return 3;if(id>=200&&id<300)return 95;if(id>=300&&id<600)return 61;if(id>=600&&id<700)return 71;if(id>=700&&id<800)return 45;return 3}\nfunction weatherIcon(code){if(code===0)return{symbol:\"sun.max.fill\",color:new Color(\"#FFB800\")};if([1,2,3].includes(code))return{symbol:\"cloud.sun.fill\",color:new Color(\"#B0B4BA\")};if([45,48].includes(code))return{symbol:\"cloud.fog.fill\",color:new Color(\"#9AA0A6\")};if([51,53,55,56,57,61,63,65,66,67,80,81,82].includes(code))return{symbol:\"cloud.rain.fill\",color:new Color(\"#4A90D9\")};if([71,73,75,77,85,86].includes(code))return{symbol:\"cloud.snow.fill\",color:new Color(\"#C6D8F0\")};if([95,96,99].includes(code))return{symbol:\"cloud.bolt.rain.fill\",color:new Color(\"#FFCC00\")};return{symbol:\"cloud.fill\",color:new Color(\"#9AA0A6\")}}\nconst NAMEDAY_COUNTRY_BY_LANG={cs:\"cz\",en:\"us\",de:\"de\",es:\"es\"};async function fetchNameDay(date,settings,cacheKey,offset){const country=settings.nameDayCountry||NAMEDAY_COUNTRY_BY_LANG[settings.language]||\"cz\";try{let name=\"\";if(country===\"cz\"){const d=`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,\"0\")}-${String(date.getDate()).padStart(2,\"0\")}`;name=(await timedRequest(`${apiBase(settings.apiNameDayCzBase,\"https://svatkyapi.netlify.app/api/day\")}/${d}`).loadJSON()).name||\"\"}else{const req=timedRequest(offset<2?`${apiBase(settings.apiNameDayGlobalBase,\"https://nameday.abalin.net\")}/${offset===0?\"today\":\"tomorrow\"}`:`${apiBase(settings.apiNameDayGlobalBase,\"https://nameday.abalin.net\")}/date`);req.method=\"POST\";req.headers={\"Content-Type\":\"application/json\",\"Accept\":\"application/json\"};req.body=JSON.stringify(offset<2?{country}:{country,month:date.getMonth()+1,day:date.getDate()});const data=await req.loadJSON();name=data?.data?.namedays?.[country]||\"\"}settings.lastNameDays[cacheKey]=name;if(!settings.__preview)saveSettings(settings);return name}catch(_){return settings.lastNameDays[cacheKey]||\"\"}}\nfunction f1SessionLabel(lang,key){const m={cs:{p1:\"Trénink 1\",p2:\"Trénink 2\",p3:\"Trénink 3\",q:\"Kvalifikace\",s:\"Sprint\",r:\"Závod\"},en:{p1:\"Practice 1\",p2:\"Practice 2\",p3:\"Practice 3\",q:\"Qualifying\",s:\"Sprint\",r:\"Race\"},de:{p1:\"Training 1\",p2:\"Training 2\",p3:\"Training 3\",q:\"Qualifying\",s:\"Sprint\",r:\"Rennen\"},es:{p1:\"Entrenamiento 1\",p2:\"Entrenamiento 2\",p3:\"Entrenamiento 3\",q:\"Clasificación\",s:\"Sprint\",r:\"Carrera\"}};return(m[lang]||m.en)[key]}\nasync function fetchF1Next(settings){try{const data=await timedRequest(`${apiBase(settings.apiF1Base,\"https://api.jolpi.ca/ergast/f1\")}/current/next.json`).loadJSON(),race=data?.MRData?.RaceTable?.Races?.[0];if(!race)return[];const out=[],add=(key,obj)=>{if(obj?.date)out.push({title:`🏎 ${race.raceName} · ${f1SessionLabel(settings.language,key)}`,date:new Date(obj.date+\"T\"+(obj.time||\"00:00:00Z\")),isF1:true})};if(settings.showF1Practice){add(\"p1\",race.FirstPractice);add(\"p2\",race.SecondPractice);add(\"p3\",race.ThirdPractice)}if(settings.showF1Qualifying)add(\"q\",race.Qualifying);if(settings.showF1Sprint)add(\"s\",race.Sprint);if(settings.showF1Race)add(\"r\",{date:race.date,time:race.time});settings.lastF1=out;if(!settings.__preview)saveSettings(settings);return out}catch(_){return(settings.lastF1||[]).map(x=>({...x,date:new Date(x.date)}))}}\nasync function fetchEvents(start,end,settings,isToday){try{if(!settings.calendarsConfigured)return[];let rows=await CalendarEvent.between(start,end);rows=rows.filter(e=>settings.calendars.includes(e.calendar.title));rows=rows.filter(e=>!/počasí|svátk|jmenin|weather|namedays?/i.test(e.calendar.title)&&!/°C|°F/.test(e.title));if(isToday&&settings.hidePastEvents){const now=new Date();rows=rows.filter(e=>e.endDate>=now)}return rows}catch(_){return[]}}\nasync function fetchReminders(start,end,settings,isToday){try{if(!settings.calendarsConfigured)return[];let cals=await Calendar.forReminders();cals=cals.filter(c=>settings.reminderLists.includes(c.title));let rows=(await Reminder.allIncomplete(cals)).filter(r=>r.dueDate?(r.dueDate>=start&&r.dueDate<end):(isToday&&settings.remindersWithoutDateOnToday));rows.sort((a,b)=>(a.dueDate?.getTime()||Infinity)-(b.dueDate?.getTime()||Infinity));return rows.slice(0,settings.maxEventsPerDay)}catch(_){return[]}}\nasync function fetchSports(settings,targetDate){try{const league=(settings.sportsLeague||\"NHL\").toLowerCase(),sport=league===\"nba\"?\"basketball\":league===\"nfl\"?\"football\":league===\"mlb\"?\"baseball\":\"hockey\",date=`${targetDate.getFullYear()}${String(targetDate.getMonth()+1).padStart(2,\"0\")}${String(targetDate.getDate()).padStart(2,\"0\")}`,data=await timedRequest(`${apiBase(settings.apiSportsBase,\"https://site.api.espn.com/apis/site/v2/sports\")}/${sport}/${league}/scoreboard?dates=${date}`).loadJSON(),team=(settings.sportsTeam||\"\").toLowerCase(),match=(data.events||[]).find(e=>{const d=new Date(e.date),same=d.getFullYear()===targetDate.getFullYear()&&d.getMonth()===targetDate.getMonth()&&d.getDate()===targetDate.getDate();return same&&(!team||String(e.name||\"\").toLowerCase().includes(team))});return match?`🏆 ${match.shortName||match.name} (${match.status?.type?.detail||\"\"})`:\"\"}catch(_){return\"\"}}\nfunction getRandomQuote(lang){const q={cs:[\"Všechno se zdá nemožné, dokud to není hotové. — Nelson Mandela\",\"Věř, že můžeš, a jsi na půli cesty. — Theodore Roosevelt\"],en:[\"It always seems impossible until it's done. — Nelson Mandela\",\"Believe you can and you're halfway there. — Theodore Roosevelt\"],de:[\"Es scheint immer unmöglich, bis es getan ist. — Nelson Mandela\"],es:[\"Todo parece imposible hasta que se hace. — Nelson Mandela\"]},list=q[lang]||q.en;return`💬 ${list[new Date().getDate()%list.length]}`}\nasync function fetchStocks(settings,value){const out=[];for(const raw of(value||\"\").split(\",\")){const sym=raw.trim().toUpperCase();if(!sym)continue;try{if(settings.stockProvider===\"alphavantage\"){const key=String(settings.alphaVantageKey||\"\").trim();if(!key)continue;const base=apiBase(settings.apiAlphaVantageBase,\"https://www.alphavantage.co\"),d=await timedRequest(`${base}/query?function=GLOBAL_QUOTE&symbol=${encodeURIComponent(sym)}&apikey=${encodeURIComponent(key)}`).loadJSON(),q=d?.[\"Global Quote\"]||{},p=Number(q[\"05. price\"]),pct=String(q[\"10. change percent\"]||\"\");if(Number.isFinite(p))out.push(`${sym}: $${p.toFixed(2)}${pct?` (${pct})`:\"\"}`)}else{const base=apiBase(settings.apiYahooBase,\"https://query1.finance.yahoo.com\"),d=await timedRequest(`${base}/v8/finance/chart/${encodeURIComponent(sym)}?interval=1d&range=1d`).loadJSON(),m=d.chart.result[0].meta,p=Number(m.regularMarketPrice),prev=Number(m.chartPreviousClose),pct=(p-prev)/prev*100;out.push(`${sym}: $${p.toFixed(2)} (${pct>=0?\"+\":\"\"}${pct.toFixed(2)}%)`)}}catch(_){}}return out.join(\" | \")}\nasync function fetchCrypto(settings,value){const out=[];for(const raw of(value||\"\").split(\",\")){const c=raw.trim().toUpperCase();if(!c)continue;try{const d=await timedRequest(`${apiBase(settings.apiCoinbaseBase,\"https://api.coinbase.com\")}/v2/prices/${c}-USD/spot`).loadJSON();out.push(`🪙 ${c}: $${Number(d.data.amount).toLocaleString(undefined,{maximumFractionDigits:2})}`)}catch(_){}}return out.join(\" | \")}\nasync function fetchExchangeRates(settings,value){try{let rates={};if(settings.exchangeProvider===\"keyed\"){const key=String(settings.exchangeApiKey||\"\").trim();if(!key)return\"\";const base=apiBase(settings.apiExchangeKeyedBase,\"https://v6.exchangerate-api.com/v6\"),d=await timedRequest(`${base}/${encodeURIComponent(key)}/latest/EUR`).loadJSON();rates=d.conversion_rates||{}}else{const base=apiBase(settings.apiExchangeOpenBase,\"https://open.er-api.com/v6\"),d=await timedRequest(`${base}/latest/EUR`).loadJSON();rates=d.rates||{}}const out=[];for(const raw of(value||\"\").split(\",\")){const c=raw.trim().toUpperCase();if(c&&c!==\"EUR\"&&rates[c])out.push(`1 EUR = ${Number(rates[c]).toFixed(2)} ${c}`)}return out.length?\"💱 \"+out.join(\" | \"):\"\"}catch(_){return\"\"}}\nasync function fetchFitness(settings){const fm=FileManager.iCloud(),p=fm.joinPath(fm.documentsDirectory(),STEPS_FILE);if(!fm.fileExists(p))return\"\";try{if(!fm.isFileDownloaded(p))await fm.downloadFileFromiCloud(p);const steps=parseInt(fm.readString(p).trim());if(isNaN(steps))return\"\";const goal=settings.stepsGoal||10000,pct=Math.min(100,Math.round(steps/goal*100)),n=Math.round(pct/10);return`🏃 ${(LOCALIZATION[settings.language]||LOCALIZATION.cs).fitness}: ${steps.toLocaleString()} / ${goal.toLocaleString()} (${pct}%) [${\"█\".repeat(n)}${\"░\".repeat(10-n)}]`}catch(_){return\"\"}}\nasync function fetchNews(feed){try{const xml=await timedRequest(feed).loadString(),titles=[];for(const m of xml.matchAll(/<title>(.*?)<\\/title>/g)){const s=m[1].replace(/<!\\[CDATA\\[(.*?)\\]\\]>/g,\"$1\").replace(/&amp;/g,\"&\");if(!/RSS|iDNES/i.test(s)){titles.push(s);if(titles.length===2)break}}return titles}catch(_){return[]}}\nfunction getMoonPhase(lang){const lp=2551443,age=(((Date.now()-new Date(1970,0,7,20,35).getTime())/1000)%lp)/(24*3600),names={cs:[\"🌑 Nov\",\"🌒 Dorůstající srp\",\"🌓 První čtvrť\",\"🌔 Dorůstající měsíc\",\"🌕 Úplněk\",\"🌖 Couvající měsíc\",\"🌗 Poslední čtvrť\",\"🌘 Couvající srp\"],en:[\"🌑 New Moon\",\"🌒 Waxing Crescent\",\"🌓 First Quarter\",\"🌔 Waxing Gibbous\",\"🌕 Full Moon\",\"🌖 Waning Gibbous\",\"🌗 Third Quarter\",\"🌘 Waning Crescent\"],de:[\"🌑 Neumond\",\"🌒 Zunehmende Sichel\",\"🌓 Erstes Viertel\",\"🌔 Zunehmender Mond\",\"🌕 Vollmond\",\"🌖 Abnehmender Mond\",\"🌗 Letztes Viertel\",\"🌘 Abnehmende Sichel\"],es:[\"🌑 Luna nueva\",\"🌒 Creciente\",\"🌓 Cuarto creciente\",\"🌔 Gibosa creciente\",\"🌕 Luna llena\",\"🌖 Gibosa menguante\",\"🌗 Cuarto menguante\",\"🌘 Menguante\"]},i=age<1.84?0:age<5.53?1:age<9.22?2:age<12.91?3:age<16.61?4:age<20.3?5:age<23.99?6:7;return(names[lang]||names.en)[i]}\nfunction getWorldClocks(value){const zones={\"new york\":\"America/New_York\",\"london\":\"Europe/London\",\"tokyo\":\"Asia/Tokyo\",\"prague\":\"Europe/Prague\",\"praha\":\"Europe/Prague\",\"berlin\":\"Europe/Berlin\",\"sydney\":\"Australia/Sydney\"},out=[];for(const raw of(value||\"\").split(\",\")){const city=raw.trim();if(!city)continue;const zone=zones[city.toLowerCase()]||(city.includes(\"/\")?city:\"\");if(!zone)continue;try{const s=new Intl.DateTimeFormat(\"en-GB\",{timeZone:zone,hour:\"2-digit\",minute:\"2-digit\",hour12:false}).format(new Date());out.push(`${city}: ${s}`)}catch(_){}}return out}\nfunction batteryInfo(lang){const n=Math.round(Device.batteryLevel()*100),symbol=n<=10?\"battery.0\":n<=40?\"battery.25\":n<=65?\"battery.50\":n<=90?\"battery.75\":\"battery.100\";return{text:`${(LOCALIZATION[lang]||LOCALIZATION.cs).battery}: ${n}%`,symbol,color:new Color(n<=20?\"#FF453A\":\"#8E8E93\")}}\nfunction getSystemMetrics(){return`⚙️ ${Device.model()} | ${Device.isCharging()?\"⚡\":\"🔋\"} ${Math.round(Device.batteryLevel()*100)}%`}\nfunction formatSessionDate(date,lang){const f=new DateFormatter();f.locale=lang||\"en\";f.dateFormat=\"EEE d.M. HH:mm\";return f.string(date)}\n\nasync function buildImage(size,settings){const base=Math.min(1.4,Math.max(.5,Number(settings.contentScale)||1)),first=await renderWallpaper(size,{...settings,contentScale:base});if(!settings.autoFitContent)return first.image;const metrics=layoutMetrics(size,{...settings,contentScale:base}),limit=size.height-Math.max(70,metrics.y(120));if(first.endY<=limit)return first.image;const min=Math.min(base,Math.max(.5,Math.min(1,Number(settings.minContentScale)||.72))),ratio=Math.max(.2,limit/Math.max(1,first.endY)),next=Math.max(min,Math.min(base,base*ratio*.96));if(next>=base-.01)return first.image;const second=await renderWallpaper(size,{...settings,contentScale:next,compactMode:settings.compactMode||next<=min+.01});return second.image}\nasync function renderWallpaper(size,settings){const t=LOCALIZATION[settings.language]||LOCALIZATION.cs,m=layoutMetrics(size,settings),ctx=new DrawContext();ctx.size=new Size(size.width,size.height);ctx.opaque=false;ctx.respectScreenScale=true;const align=settings.layoutStyle===\"center\"?\"center\":\"left\",margin=m.x(settings.marginX),style=k=>settings.sectionStyle[k]||DEFAULT_STYLE[k]||{color:\"#fff\",size:26},color=k=>new Color(style(k).color),font=k=>m.font(style(k).size);let y=m.y(settings.startY);const weather=settings.showWeather||settings.showWeatherForecast?await fetchWeather(settings):[],f1=settings.showF1?await fetchF1Next(settings):[],formatter=new DateFormatter();formatter.locale=settings.language||\"cs\";formatter.dateFormat=settings.customDateFormat||\"EEEE, d. M.\";const dayKeys=[\"events\",\"reminders\",\"weather\",\"nameday\",\"sports\"];let daysRendered=false;for(const key of settings.sectionOrder){if(!MODULES[key]||!settings[MODULES[key].showKey])continue;const isDay=dayKeys.includes(key);if(isDay){if(daysRendered)continue;daysRendered=true;const enabledDayKeys=settings.sectionOrder.filter(k=>dayKeys.includes(k)&&settings[MODULES[k]?.showKey]);for(let offset=0;offset<Math.min(7,Math.max(1,settings.daysToShow));offset++){const start=new Date();start.setDate(start.getDate()+offset);start.setHours(0,0,0,0);const end=new Date(start);end.setDate(end.getDate()+1);const label=offset===0?(settings.labelToday||t.today):offset===1?(settings.labelTomorrow||t.tomorrow):formatter.string(start).toUpperCase();y=drawText(ctx,label,y,size,font(\"header\"),color(\"header\"),true,align,margin);y+=m.line;for(const sub of enabledDayKeys){try{if(sub===\"events\"){const events=await fetchEvents(start,end,settings,offset===0),rows=events.slice(0,settings.maxEventsPerDay);if(!rows.length&&settings.noEventsText){y=drawText(ctx,settings.noEventsText,y,size,font(\"events\"),color(\"events\"),false,align,margin);y+=m.line}for(const item of rows){y=drawText(ctx,item.title,y,size,font(\"events\"),color(\"events\"),false,align,margin);if(!item.isAllDay)y=drawText(ctx,`[${formatTime(item.startDate)} - ${formatTime(item.endDate)}]`,y,size,Math.max(10,font(\"events\")-m.font(4)),color(\"events\"),true,align,margin);y+=m.line}}if(sub===\"reminders\"){const rows=await fetchReminders(start,end,settings,offset===0),a=settings.remindersAlign===\"right\"&&settings.layoutStyle===\"left\"?\"right\":align;for(const r of rows){y=drawText(ctx,(r.dueDate?\"⏰ \":\"📌 \")+r.title,y,size,font(\"reminders\"),color(\"reminders\"),false,a,margin);y+=m.line}}if(sub===\"weather\"&&weather[offset]){const w=weather[offset],f=settings.weatherUnit===\"fahrenheit\",min=f?Math.round(w.min*1.8+32):w.min,max=f?Math.round(w.max*1.8+32):w.max,text=`${min}${f?\"°F\":\"°C\"} / ${max}${f?\"°F\":\"°C\"}`;if(settings.showWeatherIcon){const ic=weatherIcon(w.code);y=drawIconLine(ctx,ic.symbol,ic.color,text,y,size,font(\"weather\"),color(\"weather\"),align,margin,m.icon)}else y=drawText(ctx,text,y,size,font(\"weather\"),color(\"weather\"),false,align,margin);y+=m.line}if(sub===\"nameday\"){const n=await fetchNameDay(start,settings,String(offset),offset);if(n){const prefix=settings.nameDayLabel?settings.nameDayLabel+\": \":t.nameDay+\": \";y=drawText(ctx,prefix+n,y,size,font(\"nameday\"),color(\"nameday\"),false,align,margin);y+=m.line}}if(sub===\"sports\"){const s=await fetchSports(settings,start);if(s){y=drawText(ctx,s,y,size,font(\"sports\"),color(\"sports\"),false,align,margin);y+=m.line}}}catch(e){console.error(`Module ${sub}: ${e}`)}}y+=m.block}continue}try{if(key===\"f1\"){if(f1.length){for(const e of f1){y=drawText(ctx,e.title,y,size,font(\"f1\"),color(\"f1\"),false,align,margin);y=drawText(ctx,formatSessionDate(e.date,settings.language),y,size,Math.max(10,font(\"f1\")-m.font(5)),color(\"f1\"),true,align,margin);y+=m.line}y+=m.block}}else if(key===\"weatherForecast\"){y=drawWeatherForecast(ctx,weather,y,size,font(key),color(key),margin,settings.weatherForecastDays,settings,m);y+=m.block}else if(key===\"quotes\"){y=drawText(ctx,getRandomQuote(settings.language),y,size,font(key),color(key),false,align,margin);y+=m.block}else if(key===\"stocks\"){const s=await fetchStocks(settings,settings.stockSymbols);if(s){y=drawText(ctx,s,y,size,font(key),color(key),false,align,margin);y+=m.block}}else if(key===\"crypto\"){const s=await fetchCrypto(settings,settings.cryptoCoins);if(s){y=drawText(ctx,s,y,size,font(key),color(key),false,align,margin);y+=m.block}}else if(key===\"exchange\"){const s=await fetchExchangeRates(settings,settings.exchangeCurrencies);if(s){y=drawText(ctx,s,y,size,font(key),color(key),false,align,margin);y+=m.block}}else if(key===\"notes\"&&settings.customNotesText){y=drawText(ctx,settings.customNotesText,y,size,font(key),color(key),false,align,margin);y+=m.block}else if(key===\"countdown\"&&settings.countdownDate){const target=new Date(settings.countdownDate+\"T00:00:00\"),days=Math.ceil((target-Date.now())/86400000),word=settings.language===\"cs\"?\"dní\":settings.language===\"de\"?\"Tage\":settings.language===\"es\"?\"días\":\"days\",txt=days>=0?`⏳ ${settings.countdownTitle||t.countdown}: ${days} ${word}`:`✅ ${settings.countdownTitle||t.countdown}`;y=drawText(ctx,txt,y,size,font(key),color(key),false,align,margin);y+=m.block}else if(key===\"fitness\"){const s=await fetchFitness(settings);if(s){y=drawText(ctx,s,y,size,font(key),color(key),false,align,margin);y+=m.block}}else if(key===\"news\"){for(const s of await fetchNews(settings.newsFeedUrl)){y=drawText(ctx,\"📰 \"+s,y,size,font(key),color(key),false,align,margin);y+=m.line}y+=m.block}else if(key===\"moon\"){y=drawText(ctx,getMoonPhase(settings.language),y,size,font(key),color(key),false,align,margin);y+=m.block}else if(key===\"worldclock\"){const s=getWorldClocks(settings.worldClockCities);if(s.length){y=drawText(ctx,\"🌐 \"+s.join(\" | \"),y,size,font(key),color(key),false,align,margin);y+=m.block}}else if(key===\"battery\"){const b=batteryInfo(settings.language);y=drawIconLine(ctx,b.symbol,b.color,b.text,y,size,font(key),color(key),align,margin,m.icon,true);y+=m.block}else if(key===\"system\"){y=drawText(ctx,getSystemMetrics(),y,size,font(key),color(key),false,align,margin);y+=m.block}}catch(e){console.error(`Module ${key}: ${e}`)}}return{image:ctx.getImage(),endY:y}}\nfunction drawText(ctx,text,y,size,fontSize,color,bold,align,marginX){ctx.setFont(bold?Font.boldSystemFont(fontSize):Font.systemFont(fontSize));ctx.setTextColor(color);if(align===\"left\")ctx.setTextAlignedLeft();else if(align===\"right\")ctx.setTextAlignedRight();else ctx.setTextAlignedCenter();const h=fontSize+Math.max(8,Math.round(fontSize*.45));ctx.drawTextInRect(String(text),new Rect(marginX,y,size.width-marginX*2,h));return y+h}\nfunction drawIconLine(ctx,symbolName,iconColor,text,y,size,fontSize,textColor,align,marginX,iconSize,isBattery=false){const sf=SFSymbol.named(symbolName);sf.applyFont(Font.systemFont(fontSize));const iconH=iconSize,iconW=isBattery?iconSize*1.7:iconSize,estimated=Math.min(size.width-marginX*2,String(text).length*fontSize*.55),total=iconW+8+estimated,x=align===\"left\"?marginX:align===\"right\"?size.width-marginX-total:(size.width-total)/2;ctx.setFillColor(iconColor);ctx.drawImageInRect(sf.image,new Rect(x,y,iconW,iconH));ctx.setFont(Font.systemFont(fontSize));ctx.setTextColor(textColor);ctx.setTextAlignedLeft();ctx.drawTextInRect(String(text),new Rect(x+iconW+8,y,size.width-(x+iconW+8)-marginX,Math.max(iconH,fontSize+10)));return y+Math.max(iconH,fontSize+10)}\nfunction formatTime(date){const f=new DateFormatter();f.dateFormat=\"HH:mm\";return f.string(date)}\nfunction drawWeatherForecast(ctx,data,y,size,fontSize,color,marginX,count,settings,m){const n=Math.min(count,Math.max(0,data.length-1));if(!n)return y;const w=(size.width-marginX*2)/n,item=Math.max(11,Math.round(fontSize*.7)),icon=Math.max(14,Math.round(fontSize*.85));ctx.setFont(Font.systemFont(item));ctx.setTextColor(color);ctx.setTextAlignedCenter();for(let i=0;i<n;i++){const row=data[i+1],x=marginX+i*w;ctx.drawTextInRect(`+${i+1}d`,new Rect(x,y,w,item+4));const ic=weatherIcon(row.code),sf=SFSymbol.named(ic.symbol);sf.applyFont(Font.systemFont(item));ctx.setFillColor(ic.color);ctx.drawImageInRect(sf.image,new Rect(x+(w-icon)/2,y+item+4,icon,icon));const f=settings.weatherUnit===\"fahrenheit\",min=f?Math.round(row.min*1.8+32):row.min,max=f?Math.round(row.max*1.8+32):row.max;ctx.setTextColor(color);ctx.drawTextInRect(`${min}/${max}${f?\"°F\":\"°C\"}`,new Rect(x,y+item+icon+8,w,item+4))}return y+item*2+icon+14}\n\nawait main();\n",
