{
  "always_run_in_app": false,
  "icon": {
    "color": "deep-blue",
    "glyph": "magic"
  },
  "name": "CaseyCZ Template",
  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: deep-blue; icon-glyph: magic;\n// ============================================================\n// CaseyCZ Template v1.0.0\n// CaseyCZ Scriptable Apps\n// Shared starter for new CaseyCZ Scriptable apps.\n// ============================================================\n\nconst APP_NAME = \"CaseyCZ Template\";\nconst APP_VERSION = \"1.0.0\";\nconst SETTINGS_VERSION = 1;\nconst APP_SLUG = \"CaseyCZTemplate\";\nconst STORAGE = \"local\"; // \"local\" or \"icloud\"\n\nconst FEATURES = {\n  preview: [\"small\", \"medium\", \"large\"],\n  appearance: true,\n  behavior: true,\n  api: true,\n  diagnostics: true,\n  backup: true,\n  help: true,\n};\n\nconst SECRET_KEYS = [\"apiKey\"];\nconst SETTINGS_FILE = `${APP_SLUG}_settings.json`;\nconst CACHE_FILE = `${APP_SLUG}_cache.json`;\nconst UPDATE = {\n  versionUrl: \"https://raw.githubusercontent.com/CaseyCZ/Scriptable/Master/apps/_Template/version.json\",\n  sourceUrl: \"https://raw.githubusercontent.com/CaseyCZ/Scriptable/Master/apps/_Template/CaseyCZ%20Template.js\",\n  minBytes: 10000,\n  fingerprint: 'const APP_NAME = \"CaseyCZ Template\"',\n};\n\nconst DEFAULTS = {\n  settingsVersion: SETTINGS_VERSION,\n  language: null,\n  widgetTitle: \"CaseyCZ Template\",\n  subtitle: \"Ready for your app\",\n  showSubtitle: true,\n  useCustomColors: false,\n  backgroundColor: \"#0B1020\",\n  panelColor: \"#111827\",\n  textColor: \"#F8FAFC\",\n  mutedColor: \"#94A3B8\",\n  accentColor: \"#38BDF8\",\n  okColor: \"#34C759\",\n  warningColor: \"#FF9F0A\",\n  failColor: \"#FF453A\",\n  refreshMinutes: 30,\n  endpoint: \"\",\n};\n\nconst T = {\n  cs: {\n    settings:\"Nastavení\", subtitle:\"Společný základ pro nové CaseyCZ Scriptable aplikace.\", saved:\"Změny se ukládají automaticky.\",\n    update:\"Aktualizace\", checking:\"Kontroluji…\", current:\"Používáš aktuální verzi.\", available:\"Je dostupná verze\", apply:\"Aktualizovat\", cancel:\"Zrušit\", updated:\"Aktualizace byla nainstalována. Spusť skript znovu.\", updateFail:\"Kontrola aktualizace selhala.\",\n    preview:\"Náhled widgetu\", small:\"Small\", medium:\"Medium\", large:\"Large\",\n    app:\"Aplikace\", appSub:\"Sem patří vlastní nastavení konkrétní aplikace.\", example:\"Ukázkové nastavení\", widgetTitle:\"Název widgetu\", subtitleLabel:\"Podtitulek\", showSubtitle:\"Zobrazit podtitulek\",\n    appearance:\"Vzhled widgetu\", appearanceSub:\"Jednotný CaseyCZ vzhled, barvy a viditelnost.\", customColors:\"Vlastní barvy\", useCustomColors:\"Použít vlastní barvy\", backgroundColor:\"Pozadí\", panelColor:\"Karty\", textColor:\"Text\", mutedColor:\"Vedlejší text\", accentColor:\"Akcent\", okColor:\"OK\", warningColor:\"Varování\", failColor:\"Chyba\", resetAppearance:\"Obnovit vzhled\",\n    behavior:\"Chování\", behaviorSub:\"Obnova widgetu a jazyk.\", refresh:\"Obnova widgetu\", minutes:\"min\", language:\"Jazyk\",\n    api:\"API a zdroje\", apiSub:\"Volitelný endpoint a citlivý API klíč uložený pouze v Keychain.\", endpoint:\"Endpoint\", apiKey:\"API klíč\", apiKeyHint:\"Nech prázdné pro zachování uloženého klíče.\", secretStored:\"Klíč je uložen v Keychain.\", secretMissing:\"Klíč není uložen.\", saveSecret:\"Uložit klíč\", removeSecret:\"Smazat klíč\",\n    diagnostics:\"Diagnostika\", diagnosticsSub:\"Společný renderer stavů checking / ok / warning / error / off.\", runDiagnostics:\"Spustit diagnostiku\", storage:\"Úložiště\", settingsSchema:\"Settings schema\", updater:\"Updater\", endpointCheck:\"Endpoint\",\n    maintenance:\"Záloha a údržba\", maintenanceSub:\"Záloha do skutečného JSON souboru. Citlivá data se neexportují.\", export:\"Uložit zálohu\", import:\"Importovat zálohu\", clearCache:\"Vymazat cache\", resetAll:\"Obnovit vše\", exported:\"Záloha byla uložena.\", imported:\"Nastavení importováno.\", invalid:\"Neplatná záloha.\", cacheCleared:\"Cache byla vymazána.\", resetDone:\"Nastavení obnoveno.\",\n    help:\"Nápověda\", helpSub:\"Co změnit při vytváření nové aplikace.\", help1:\"1. Změň APP_NAME, APP_SLUG a URL aktualizace.\", help2:\"2. Uprav FEATURES a DEFAULTS podle aplikace.\", help3:\"3. Citlivé hodnoty přidej do SECRET_KEYS a ukládej je přes Keychain.\", help4:\"4. Vlastní obrazovky přidej do části Aplikace; společné obrazovky zachovej.\", help5:\"5. APP_VERSION a SETTINGS_VERSION jsou dvě různé verze.\",\n    back:\"Zpět\", on:\"Zapnuto\", off:\"Vypnuto\", notSet:\"Nenastaveno\", ok:\"V pořádku\", warning:\"Varování\", error:\"Chyba\", firstRun:\"Vyber jazyk\"\n  },\n  en: {\n    settings:\"Settings\", subtitle:\"Shared foundation for new CaseyCZ Scriptable apps.\", saved:\"Changes save automatically.\",\n    update:\"Update\", checking:\"Checking…\", current:\"You are using the latest version.\", available:\"Version available\", apply:\"Update\", cancel:\"Cancel\", updated:\"Update installed. Run the script again.\", updateFail:\"Update check failed.\",\n    preview:\"Widget preview\", small:\"Small\", medium:\"Medium\", large:\"Large\",\n    app:\"App\", appSub:\"Put app-specific settings here.\", example:\"Example setting\", widgetTitle:\"Widget title\", subtitleLabel:\"Subtitle\", showSubtitle:\"Show subtitle\",\n    appearance:\"Widget appearance\", appearanceSub:\"Shared CaseyCZ appearance, colors and visibility.\", customColors:\"Custom colors\", useCustomColors:\"Use custom colors\", backgroundColor:\"Background\", panelColor:\"Cards\", textColor:\"Text\", mutedColor:\"Secondary text\", accentColor:\"Accent\", okColor:\"OK\", warningColor:\"Warning\", failColor:\"Error\", resetAppearance:\"Reset appearance\",\n    behavior:\"Behavior\", behaviorSub:\"Widget refresh and language.\", refresh:\"Widget refresh\", minutes:\"min\", language:\"Language\",\n    api:\"APIs & sources\", apiSub:\"Optional endpoint and sensitive API key stored only in Keychain.\", endpoint:\"Endpoint\", apiKey:\"API key\", apiKeyHint:\"Leave blank to keep the stored key.\", secretStored:\"Key is stored in Keychain.\", secretMissing:\"No key is stored.\", saveSecret:\"Save key\", removeSecret:\"Remove key\",\n    diagnostics:\"Diagnostics\", diagnosticsSub:\"Shared renderer for checking / ok / warning / error / off states.\", runDiagnostics:\"Run diagnostics\", storage:\"Storage\", settingsSchema:\"Settings schema\", updater:\"Updater\", endpointCheck:\"Endpoint\",\n    maintenance:\"Backup & maintenance\", maintenanceSub:\"Backup to a real JSON file. Secrets are never exported.\", export:\"Save backup\", import:\"Import backup\", clearCache:\"Clear cache\", resetAll:\"Reset everything\", exported:\"Backup saved.\", imported:\"Settings imported.\", invalid:\"Invalid backup.\", cacheCleared:\"Cache cleared.\", resetDone:\"Settings reset.\",\n    help:\"Help\", helpSub:\"What to change when creating a new app.\", help1:\"1. Change APP_NAME, APP_SLUG and update URLs.\", help2:\"2. Adjust FEATURES and DEFAULTS for the app.\", help3:\"3. Add sensitive values to SECRET_KEYS and keep them in Keychain.\", help4:\"4. Add custom screens under App; keep shared screens consistent.\", help5:\"5. APP_VERSION and SETTINGS_VERSION are separate versions.\",\n    back:\"Back\", on:\"On\", off:\"Off\", notSet:\"Not set\", ok:\"OK\", warning:\"Warning\", error:\"Error\", firstRun:\"Choose language\"\n  },\n  de: {\n    settings:\"Einstellungen\", subtitle:\"Gemeinsame Basis für neue CaseyCZ-Scriptable-Apps.\", saved:\"Änderungen werden automatisch gespeichert.\", update:\"Aktualisierung\", checking:\"Prüfe…\", current:\"Aktuelle Version wird verwendet.\", available:\"Verfügbare Version\", apply:\"Aktualisieren\", cancel:\"Abbrechen\", updated:\"Aktualisierung installiert. Skript neu starten.\", updateFail:\"Update-Prüfung fehlgeschlagen.\", preview:\"Widget-Vorschau\", small:\"Small\", medium:\"Medium\", large:\"Large\", app:\"App\", appSub:\"Hier gehören app-spezifische Einstellungen hin.\", example:\"Beispieleinstellung\", widgetTitle:\"Widget-Titel\", subtitleLabel:\"Untertitel\", showSubtitle:\"Untertitel anzeigen\", appearance:\"Widget-Design\", appearanceSub:\"Gemeinsames CaseyCZ-Design, Farben und Sichtbarkeit.\", customColors:\"Eigene Farben\", useCustomColors:\"Eigene Farben verwenden\", backgroundColor:\"Hintergrund\", panelColor:\"Karten\", textColor:\"Text\", mutedColor:\"Sekundärtext\", accentColor:\"Akzent\", okColor:\"OK\", warningColor:\"Warnung\", failColor:\"Fehler\", resetAppearance:\"Design zurücksetzen\", behavior:\"Verhalten\", behaviorSub:\"Widget-Aktualisierung und Sprache.\", refresh:\"Widget-Aktualisierung\", minutes:\"Min\", language:\"Sprache\", api:\"APIs & Quellen\", apiSub:\"Optionaler Endpunkt und API-Schlüssel nur im Schlüsselbund.\", endpoint:\"Endpunkt\", apiKey:\"API-Schlüssel\", apiKeyHint:\"Leer lassen, um den gespeicherten Schlüssel zu behalten.\", secretStored:\"Schlüssel ist im Schlüsselbund gespeichert.\", secretMissing:\"Kein Schlüssel gespeichert.\", saveSecret:\"Schlüssel speichern\", removeSecret:\"Schlüssel löschen\", diagnostics:\"Diagnose\", diagnosticsSub:\"Gemeinsame Statusanzeige für checking / ok / warning / error / off.\", runDiagnostics:\"Diagnose starten\", storage:\"Speicher\", settingsSchema:\"Settings-Schema\", updater:\"Updater\", endpointCheck:\"Endpunkt\", maintenance:\"Sicherung & Wartung\", maintenanceSub:\"Sicherung als echte JSON-Datei. Geheimnisse werden nie exportiert.\", export:\"Sicherung speichern\", import:\"Sicherung importieren\", clearCache:\"Cache leeren\", resetAll:\"Alles zurücksetzen\", exported:\"Sicherung gespeichert.\", imported:\"Einstellungen importiert.\", invalid:\"Ungültige Sicherung.\", cacheCleared:\"Cache geleert.\", resetDone:\"Einstellungen zurückgesetzt.\", help:\"Hilfe\", helpSub:\"Was beim Erstellen einer neuen App geändert wird.\", help1:\"1. APP_NAME, APP_SLUG und Update-URLs ändern.\", help2:\"2. FEATURES und DEFAULTS anpassen.\", help3:\"3. Geheimnisse in SECRET_KEYS aufnehmen und im Schlüsselbund speichern.\", help4:\"4. Eigene Bildschirme unter App ergänzen; gemeinsame Bildschirme beibehalten.\", help5:\"5. APP_VERSION und SETTINGS_VERSION sind getrennt.\", back:\"Zurück\", on:\"Ein\", off:\"Aus\", notSet:\"Nicht gesetzt\", ok:\"OK\", warning:\"Warnung\", error:\"Fehler\", firstRun:\"Sprache wählen\"\n  },\n  es: {\n    settings:\"Ajustes\", subtitle:\"Base compartida para nuevas apps CaseyCZ de Scriptable.\", saved:\"Los cambios se guardan automáticamente.\", update:\"Actualizar\", checking:\"Comprobando…\", current:\"Ya usas la versión actual.\", available:\"Versión disponible\", apply:\"Actualizar\", cancel:\"Cancelar\", updated:\"Actualización instalada. Ejecuta el script otra vez.\", updateFail:\"Falló la comprobación de actualización.\", preview:\"Vista previa\", small:\"Small\", medium:\"Medium\", large:\"Large\", app:\"App\", appSub:\"Aquí van los ajustes específicos de la app.\", example:\"Ajuste de ejemplo\", widgetTitle:\"Título del widget\", subtitleLabel:\"Subtítulo\", showSubtitle:\"Mostrar subtítulo\", appearance:\"Apariencia del widget\", appearanceSub:\"Apariencia CaseyCZ compartida, colores y visibilidad.\", customColors:\"Colores personalizados\", useCustomColors:\"Usar colores personalizados\", backgroundColor:\"Fondo\", panelColor:\"Tarjetas\", textColor:\"Texto\", mutedColor:\"Texto secundario\", accentColor:\"Acento\", okColor:\"OK\", warningColor:\"Aviso\", failColor:\"Error\", resetAppearance:\"Restablecer apariencia\", behavior:\"Comportamiento\", behaviorSub:\"Actualización e idioma.\", refresh:\"Actualización del widget\", minutes:\"min\", language:\"Idioma\", api:\"APIs y fuentes\", apiSub:\"Endpoint opcional y clave API sensible guardada solo en Keychain.\", endpoint:\"Endpoint\", apiKey:\"Clave API\", apiKeyHint:\"Déjalo vacío para conservar la clave guardada.\", secretStored:\"La clave está guardada en Keychain.\", secretMissing:\"No hay clave guardada.\", saveSecret:\"Guardar clave\", removeSecret:\"Eliminar clave\", diagnostics:\"Diagnóstico\", diagnosticsSub:\"Render común para checking / ok / warning / error / off.\", runDiagnostics:\"Ejecutar diagnóstico\", storage:\"Almacenamiento\", settingsSchema:\"Schema de ajustes\", updater:\"Updater\", endpointCheck:\"Endpoint\", maintenance:\"Copia y mantenimiento\", maintenanceSub:\"Copia a un archivo JSON real. Los secretos nunca se exportan.\", export:\"Guardar copia\", import:\"Importar copia\", clearCache:\"Borrar caché\", resetAll:\"Restablecer todo\", exported:\"Copia guardada.\", imported:\"Ajustes importados.\", invalid:\"Copia no válida.\", cacheCleared:\"Caché borrada.\", resetDone:\"Ajustes restablecidos.\", help:\"Ayuda\", helpSub:\"Qué cambiar al crear una app nueva.\", help1:\"1. Cambia APP_NAME, APP_SLUG y las URL de actualización.\", help2:\"2. Ajusta FEATURES y DEFAULTS para la app.\", help3:\"3. Añade valores sensibles a SECRET_KEYS y guárdalos en Keychain.\", help4:\"4. Añade pantallas propias en App y conserva las pantallas compartidas.\", help5:\"5. APP_VERSION y SETTINGS_VERSION son versiones separadas.\", back:\"Atrás\", on:\"Sí\", off:\"No\", notSet:\"Sin configurar\", ok:\"OK\", warning:\"Aviso\", error:\"Error\", firstRun:\"Elige idioma\"\n  }\n};\n\nfunction clone(v){ return JSON.parse(JSON.stringify(v)); }\nfunction esc(v){ return String(v ?? \"\").replace(/[&<>\"']/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c])); }\nfunction lang(){ const l=(Device.language()||\"en\").slice(0,2).toLowerCase(); return [\"cs\",\"en\",\"de\",\"es\"].includes(l)?l:\"en\"; }\nfunction tx(s,k){ const L=T[s.language||lang()]||T.en; return L[k] ?? T.en[k] ?? k; }\nfunction store(){ return STORAGE === \"icloud\" ? FileManager.iCloud() : FileManager.local(); }\nfunction settingsPath(){ const fm=store(); return fm.joinPath(fm.documentsDirectory(), SETTINGS_FILE); }\nfunction cachePath(){ const fm=store(); return fm.joinPath(fm.cacheDirectory(), CACHE_FILE); }\nfunction secretKey(key){ return `${APP_SLUG}_${key}`; }\nfunction hasSecret(key){ try{return Keychain.contains(secretKey(key));}catch(_){return false;} }\nfunction getSecret(key){ try{return hasSecret(key)?Keychain.get(secretKey(key)):\"\";}catch(_){return \"\";} }\nfunction setSecret(key,value){ const v=String(value||\"\").trim(); if(v)Keychain.set(secretKey(key),v); }\nfunction removeSecret(key){ try{if(hasSecret(key))Keychain.remove(secretKey(key));}catch(_){} }\nfunction validHex(v){ return /^#[0-9a-fA-F]{6}$/.test(String(v||\"\")); }\n\nfunction migrate(raw){\n  const s={...clone(DEFAULTS), ...(raw&&typeof raw===\"object\"?raw:{})};\n  const old=Number(s.settingsVersion)||0;\n  if(old < 1){ /* future migrations go here */ }\n  s.settingsVersion=SETTINGS_VERSION;\n  if(![\"cs\",\"en\",\"de\",\"es\"].includes(s.language))s.language=null;\n  s.refreshMinutes=Math.max(5,Math.min(180,Number(s.refreshMinutes)||DEFAULTS.refreshMinutes));\n  for(const k of [\"backgroundColor\",\"panelColor\",\"textColor\",\"mutedColor\",\"accentColor\",\"okColor\",\"warningColor\",\"failColor\"]){ if(!validHex(s[k]))s[k]=DEFAULTS[k]; }\n  for(const key of SECRET_KEYS)delete s[key];\n  return s;\n}\n\nfunction loadSettings(){\n  const fm=store(), p=settingsPath();\n  try{ if(fm.fileExists(p)){ if(STORAGE===\"icloud\"&&!fm.isFileDownloaded(p))fm.downloadFileFromiCloud(p); return migrate(JSON.parse(fm.readString(p))); } }catch(e){ console.log(e); }\n  return migrate({});\n}\nfunction saveSettings(s){ const fm=store(); fm.writeString(settingsPath(),JSON.stringify(migrate(s),null,2)); }\n\nasync function firstLanguage(s){\n  if(s.language)return s;\n  const a=new Alert(); a.title=APP_NAME; a.message=T.en.firstRun;\n  const items=[[\"cs\",\"Čeština\"],[\"en\",\"English\"],[\"de\",\"Deutsch\"],[\"es\",\"Español\"]]; items.forEach(x=>a.addAction(x[1]));\n  const i=await a.presentAlert(); s.language=items[Math.max(0,i)]?.[0]||\"en\"; saveSettings(s); return s;\n}\n\nfunction colors(s){\n  if(s.useCustomColors)return {bg:new Color(s.backgroundColor),panel:new Color(s.panelColor),text:new Color(s.textColor),muted:new Color(s.mutedColor),accent:new Color(s.accentColor),ok:new Color(s.okColor),warn:new Color(s.warningColor),fail:new Color(s.failColor)};\n  return {bg:Color.dynamic(new Color(\"F4F7FB\"),new Color(\"0B1020\")),panel:Color.dynamic(new Color(\"FFFFFF\"),new Color(\"111827\")),text:Color.dynamic(new Color(\"0F172A\"),new Color(\"F8FAFC\")),muted:Color.dynamic(new Color(\"64748B\"),new Color(\"94A3B8\")),accent:new Color(\"38BDF8\"),ok:new Color(\"34C759\"),warn:new Color(\"FF9F0A\"),fail:new Color(\"FF453A\")};\n}\n\nasync function buildWidget(s,family=\"medium\"){\n  const c=colors(s), w=new ListWidget(); w.backgroundColor=c.bg; w.setPadding(14,14,14,14);\n  const top=w.addStack(); top.centerAlignContent();\n  const dot=top.addText(\"●\"); dot.textColor=c.ok; dot.font=Font.boldSystemFont(12); top.addSpacer(7);\n  const title=top.addText(s.widgetTitle||APP_NAME); title.textColor=c.text; title.font=Font.boldSystemFont(family===\"small\"?14:16); title.lineLimit=1;\n  w.addSpacer(10);\n  if(s.showSubtitle){ const sub=w.addText(s.subtitle||tx(s,\"saved\")); sub.textColor=c.muted; sub.font=Font.systemFont(family===\"small\"?11:12); sub.lineLimit=family===\"small\"?2:3; }\n  w.addSpacer();\n  const bottom=w.addStack(); bottom.centerAlignContent(); const badge=bottom.addText(`v${APP_VERSION}`); badge.textColor=c.accent; badge.font=Font.semiboldSystemFont(10); bottom.addSpacer();\n  const stamp=bottom.addText(new Date().toLocaleTimeString([], {hour:\"2-digit\",minute:\"2-digit\"})); stamp.textColor=c.muted; stamp.font=Font.systemFont(9);\n  w.refreshAfterDate=new Date(Date.now()+s.refreshMinutes*60*1000); return w;\n}\nasync function presentWidget(w,family){ if(family===\"small\")await w.presentSmall(); else if(family===\"large\")await w.presentLarge(); else await w.presentMedium(); }\n\nfunction cmp(a,b){ const A=String(a).split(\".\").map(Number),B=String(b).split(\".\").map(Number); for(let i=0;i<Math.max(A.length,B.length);i++){if((A[i]||0)>(B[i]||0))return 1;if((A[i]||0)<(B[i]||0))return-1;} return 0; }\nasync function checkUpdate(s){\n  try{\n    const vr=new Request(UPDATE.versionUrl+(UPDATE.versionUrl.includes(\"?\")?\"&\":\"?\")+\"_=\"+Date.now()); vr.timeoutInterval=7; vr.headers={\"Cache-Control\":\"no-cache\",\"Pragma\":\"no-cache\"}; const meta=await vr.loadJSON(); const v=String(meta?.version||\"\"); if(!v)throw new Error(\"version.json\");\n    if(cmp(v,APP_VERSION)<=0)return {ok:true,text:`${tx(s,\"current\")} v${APP_VERSION}`};\n    const a=new Alert(); a.title=APP_NAME; a.message=`${tx(s,\"available\")}: v${v}`; a.addAction(tx(s,\"apply\")); a.addCancelAction(tx(s,\"cancel\")); if(await a.presentAlert()!==0)return {ok:true,text:`v${APP_VERSION} → v${v}`};\n    const sr=new Request(UPDATE.sourceUrl+(UPDATE.sourceUrl.includes(\"?\")?\"&\":\"?\")+\"_=\"+Date.now()); sr.timeoutInterval=10; sr.headers={\"Cache-Control\":\"no-cache\",\"Pragma\":\"no-cache\"}; const src=await sr.loadString();\n    if(!src||src.length<UPDATE.minBytes||!src.includes(UPDATE.fingerprint))throw new Error(\"Invalid source\"); const m=src.match(/const APP_VERSION\\s*=\\s*\"([^\"]+)\"/); if(!m||m[1]!==v)throw new Error(\"Version mismatch\");\n    const target=module.filename; if(!target)throw new Error(\"Current script path unavailable\"); const cloud=FileManager.iCloud(),local=FileManager.local(); let fm=local; if(cloud.fileExists(target)){fm=cloud;if(!cloud.isFileDownloaded(target))await cloud.downloadFileFromiCloud(target);} else if(!local.fileExists(target))throw new Error(\"Current script file not found\");\n    const backup=/\\.js$/i.test(target)?target.replace(/\\.js$/i,`_backup_v${APP_VERSION}.js`):target+`_backup_v${APP_VERSION}.js`; try{fm.writeString(backup,fm.readString(target));}catch(_){} fm.writeString(target,src); return {ok:true,text:`${tx(s,\"updated\")} v${v}`};\n  }catch(e){return {ok:false,text:`${tx(s,\"updateFail\")} ${String(e?.message||e)}`};}\n}\n\nfunction diagRow(label,detail,state){ return {label,detail,state}; }\nasync function diagnostics(s,progress){\n  const rows=[diagRow(tx(s,\"settingsSchema\"),`${s.settingsVersion} / ${SETTINGS_VERSION}`,s.settingsVersion===SETTINGS_VERSION?\"ok\":\"warning\"),diagRow(tx(s,\"storage\"),STORAGE,\"ok\"),diagRow(tx(s,\"updater\"),\"version.json + no-cache\",\"ok\")];\n  if(FEATURES.api){\n    if(!s.endpoint)rows.push(diagRow(tx(s,\"endpointCheck\"),tx(s,\"notSet\"),\"off\"));\n    else{ const pending=[...rows,diagRow(tx(s,\"endpointCheck\"),s.endpoint,\"checking\")]; if(progress)await progress(pending); try{const r=new Request(s.endpoint);r.timeoutInterval=5;await r.load();rows.push(diagRow(tx(s,\"endpointCheck\"),`${r.response?.statusCode||\"OK\"}`,\"ok\"));}catch(e){rows.push(diagRow(tx(s,\"endpointCheck\"),String(e?.message||e),\"error\"));} }\n  }\n  return rows;\n}\n\nasync function exportBackup(s){ const now=new Date(),pad=n=>String(n).padStart(2,\"0\"),stamp=`${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}_${pad(now.getHours())}-${pad(now.getMinutes())}`; const clean=migrate(s); const backup={format:\"CaseyCZ.Scriptable.Backup\",schema:1,app:APP_NAME,appVersion:APP_VERSION,settingsVersion:SETTINGS_VERSION,exportedAt:now.toISOString(),settings:clean}; await DocumentPicker.exportString(JSON.stringify(backup,null,2),`${APP_NAME} backup ${stamp}.json`); }\nasync function importBackup(){ const path=await DocumentPicker.openFile(); if(!path)throw new Error(\"No file\"); const raw=FileManager.local().readString(path),parsed=JSON.parse(raw||\"\"); const incoming=parsed?.format===\"CaseyCZ.Scriptable.Backup\"&&parsed.settings?parsed.settings:parsed; if(!incoming||typeof incoming!==\"object\"||Array.isArray(incoming))throw new Error(\"Invalid backup\"); return migrate(incoming); }\nfunction clearCache(){ try{const fm=store(),p=cachePath();if(fm.fileExists(p))fm.remove(p);}catch(_){} }\n\nfunction nav(id,icon,title,detail=\"\"){ return `<div class=\"navRow\" onclick=\"showScreen('${id}')\"><div class=\"navLeft\"><span class=\"navIcon\">${icon}</span><div><div class=\"rowTitle\">${esc(title)}</div>${detail?`<div class=\"rowDetail\">${esc(detail)}</div>`:\"\"}</div></div><span class=\"chevron\">›</span></div>`; }\nfunction field(id,label,value,type=\"text\",extra=\"\"){ return `<div class=\"field\"><label for=\"${id}\">${esc(label)}</label><input id=\"${id}\" type=\"${type}\" value=\"${esc(value)}\" ${extra}></div>`; }\nfunction sw(id,label,value){ return `<label class=\"settingRow\"><div class=\"rowTitle\">${esc(label)}</div><span class=\"switch\"><input id=\"${id}\" type=\"checkbox\" ${value?\"checked\":\"\"}><span class=\"slider\"></span></span></label>`; }\nfunction colorField(id,label,value){ return `<div class=\"field\"><label>${esc(label)}</label><div class=\"colorControl\"><input id=\"${id}Picker\" class=\"colorPicker\" type=\"color\" value=\"${esc(value)}\"><input id=\"${id}\" class=\"colorCode\" type=\"text\" maxlength=\"7\" value=\"${esc(value)}\"></div></div>`; }\nfunction renderDiag(rows,s){ return (rows||[]).map(r=>`<div class=\"diagRow\"><div><div class=\"diagTitle\">${esc(r.label)}</div><div class=\"diagDetail\">${esc(r.detail)}</div></div><span class=\"diagState ${esc(r.state)}\">${r.state===\"checking\"?\"⏳\":r.state===\"ok\"?\"● \"+esc(tx(s,\"ok\")):r.state===\"warning\"?\"● \"+esc(tx(s,\"warning\")):r.state===\"off\"?\"● OFF\":\"● \"+esc(tx(s,\"error\"))}</span></div>`).join(\"\"); }\n\nfunction settingsHTML(s){\n  const L=T[s.language]||T.en, back=`<div class=\"topbar\"><button class=\"back\" onclick=\"showScreen('home')\">‹ ${esc(L.back)}</button></div>`;\n  const previewButtons=(FEATURES.preview||[]).map(f=>`<button class=\"previewBtn\" onclick=\"preview('${f}')\">${f===\"small\"?\"▣\":f===\"large\"?\"▦\":\"▰\"} ${esc(L[f]||f)}</button>`).join(\"\");\n  const featureNav=[nav(\"app\",\"⚙️\",L.app,L.appSub),FEATURES.appearance?nav(\"appearance\",\"🎨\",L.appearance,L.appearanceSub):\"\",FEATURES.behavior?nav(\"behavior\",\"⏱\",L.behavior,L.behaviorSub):\"\"].join(\"\");\n  const toolNav=[FEATURES.api?nav(\"api\",\"🔑\",L.api):\"\",FEATURES.diagnostics?nav(\"diagnostics\",\"🧪\",L.diagnostics):\"\",FEATURES.backup?nav(\"maintenance\",\"💾\",L.maintenance):\"\",FEATURES.help?nav(\"help\",\"❓\",L.help):\"\"].join(\"\");\n  const colorKeys=[[\"backgroundColor\",L.backgroundColor],[\"panelColor\",L.panelColor],[\"textColor\",L.textColor],[\"mutedColor\",L.mutedColor],[\"accentColor\",L.accentColor],[\"okColor\",L.okColor],[\"warningColor\",L.warningColor],[\"failColor\",L.failColor]];\n  return `<!doctype html><html lang=\"${s.language}\"><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>\n:root{color-scheme:dark;--bg:#0b1020;--panel:#111827;--panel2:#172033;--border:#2a3850;--text:#f8fafc;--muted:#94a3b8;--accent:#38bdf8;--ok:#34c759;--warn:#ff9f0a;--danger:#ff453a}*{box-sizing:border-box}html{background:#070b14}body{margin:0;min-height:100%;padding:calc(14px + env(safe-area-inset-top)) 14px calc(36px + env(safe-area-inset-bottom));max-width:680px;margin:auto;color:var(--text);font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;background:radial-gradient(circle at top,#172554 0,#0b1020 42%,#070b14 100%);background-attachment:fixed}.screen{display:none}.screen.active{display:block}.hero{background:rgba(17,24,39,.96);border:1px solid var(--border);border-radius:22px;padding:22px;margin-bottom:14px;box-shadow:0 24px 70px rgba(0,0,0,.45)}.heroTop,.topbar{display:flex;align-items:center;justify-content:space-between}.eyebrow{display:inline-flex;padding:6px 10px;border:1px solid #1d4ed8;border-radius:999px;background:#0f1f46;color:#bfdbfe;font-size:12px;font-weight:800}.updateBtn,.back{border:0;background:transparent;color:var(--accent);font:inherit;font-weight:800}.updateBtn{border:1px solid #1d4ed8;border-radius:999px;background:#0f1f46;color:#bfdbfe;padding:6px 10px}.hero h1,.screenTitle{font-size:27px;line-height:1.15;margin:14px 0 6px;font-weight:800}.hero p,.screenSub{color:var(--muted);font-size:14px;line-height:1.5;margin:0}.screenTitle{margin:5px 2px 6px}.screenSub{margin:0 2px 14px}.sectionTitle{font-size:11px;color:#9fb3ce;text-transform:uppercase;letter-spacing:.1em;font-weight:800;margin:19px 9px 8px}.card{background:rgba(17,24,39,.96);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:13px}.navRow,.settingRow{min-height:56px;display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.navRow:last-child,.settingRow:last-child{border-bottom:0}.navLeft{display:flex;align-items:center;gap:11px}.navIcon{width:26px;text-align:center}.rowTitle{font-size:15px;font-weight:700}.rowDetail{font-size:12px;color:var(--muted);margin-top:3px}.chevron{font-size:23px;color:#64748b}.field{padding:12px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.field:last-child{border-bottom:0}.field label{display:block;margin-bottom:7px;color:#dbeafe;font-size:13px;font-weight:700}input[type=text],input[type=password],input[type=number],select{width:100%;min-height:46px;border:1px solid var(--border);border-radius:12px;background:#0b1220;color:var(--text);padding:0 13px;font:inherit;font-size:15px;outline:none}.switch{position:relative;width:50px;height:30px;flex:0 0 50px}.switch input{display:none}.slider{position:absolute;inset:0;background:#243149;border:1px solid var(--border);border-radius:999px}.slider:before{content:\"\";position:absolute;width:24px;height:24px;left:2px;top:2px;background:#fff;border-radius:50%;transition:.18s}.switch input:checked+.slider{background:#0284c7;border-color:var(--accent)}.switch input:checked+.slider:before{transform:translateX(20px)}.previewGrid,.actionGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:13px}.actionGrid{grid-template-columns:1fr 1fr;padding:12px}.previewBtn,.actionBtn{min-height:48px;border:1px solid #1d4ed8;border-radius:13px;background:linear-gradient(135deg,#0369a1,#0284c7);color:#fff;font:inherit;font-weight:800}.actionBtn.secondary{background:#243149;border-color:var(--border)}.actionBtn.danger{background:#3a1720;border-color:#6b2738;color:#fecdd3}.info{margin:12px 0;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--panel2);color:#cbd5e1;font-size:13px;line-height:1.45}.status{min-height:20px;color:var(--muted);font-size:12px;margin:7px 2px}.status.ok{color:var(--ok)}.status.error{color:var(--danger)}.colorControl{display:flex;align-items:center;gap:10px}.colorPicker{width:58px;height:40px;padding:0;border:0;background:transparent}.colorCode{flex:1}.diagRow{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:10px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.diagRow:last-child{border-bottom:0}.diagTitle{font-size:14px;font-weight:700}.diagDetail{font-size:11px;color:var(--muted);margin-top:3px}.diagState{font-size:11px;font-weight:800;white-space:nowrap}.diagState.ok{color:var(--ok)}.diagState.warning,.diagState.checking{color:var(--warn)}.diagState.error{color:var(--danger)}.diagState.off{color:#64748b}.footer{text-align:center;color:#64748b;font-size:12px;margin:18px 0}.helpLine{padding:12px 14px;border-bottom:1px solid rgba(42,56,80,.85);font-size:14px;line-height:1.45}.helpLine:last-child{border-bottom:0}@media(max-width:520px){.previewGrid{grid-template-columns:1fr}.hero h1,.screenTitle{font-size:25px}.rowDetail{display:none}}@media(max-width:360px){.actionGrid{grid-template-columns:1fr}}\n</style></head><body>\n<div class=\"screen active\" id=\"home\"><div class=\"hero\"><div class=\"heroTop\"><span class=\"eyebrow\">✨ Scriptable · v${APP_VERSION}</span><button class=\"updateBtn\" onclick=\"requestUpdate()\">↻ ${esc(L.update)}</button></div><div id=\"updateStatus\" class=\"status\"></div><h1>${esc(APP_NAME)}</h1><p>${esc(L.subtitle)}</p></div><div class=\"sectionTitle\">${esc(L.preview)}</div><div class=\"previewGrid\">${previewButtons}</div><div class=\"info\">✓ ${esc(L.saved)}</div><div class=\"sectionTitle\">${esc(L.settings)}</div><div class=\"card\">${featureNav}</div><div class=\"sectionTitle\">Nástroje / Tools</div><div class=\"card\">${toolNav}</div><div class=\"footer\">${s.language.toUpperCase()} · ${esc(APP_NAME)} ${APP_VERSION} · schema ${SETTINGS_VERSION}</div></div>\n<div class=\"screen\" id=\"app\">${back}<div class=\"screenTitle\">⚙️ ${esc(L.app)}</div><div class=\"screenSub\">${esc(L.appSub)}</div><div class=\"card\">${field(\"widgetTitle\",L.widgetTitle,s.widgetTitle)}${field(\"subtitle\",L.subtitleLabel,s.subtitle)}${sw(\"showSubtitle\",L.showSubtitle,s.showSubtitle)}</div></div>\n<div class=\"screen\" id=\"appearance\">${back}<div class=\"screenTitle\">🎨 ${esc(L.appearance)}</div><div class=\"screenSub\">${esc(L.appearanceSub)}</div><div class=\"sectionTitle\">${esc(L.customColors)}</div><div class=\"card\">${sw(\"useCustomColors\",L.useCustomColors,s.useCustomColors)}${colorKeys.map(([id,label])=>colorField(id,label,s[id])).join(\"\")}</div><div class=\"actionGrid\"><button class=\"actionBtn secondary\" onclick=\"resetAppearance()\">↺ ${esc(L.resetAppearance)}</button></div></div>\n<div class=\"screen\" id=\"behavior\">${back}<div class=\"screenTitle\">⏱ ${esc(L.behavior)}</div><div class=\"screenSub\">${esc(L.behaviorSub)}</div><div class=\"card\"><div class=\"field\"><label>${esc(L.refresh)}</label><select id=\"refreshMinutes\">${[5,15,30,60,120,180].map(v=>`<option value=\"${v}\" ${s.refreshMinutes===v?\"selected\":\"\"}>${v} ${esc(L.minutes)}</option>`).join(\"\")}</select></div><div class=\"field\"><label>${esc(L.language)}</label><select id=\"language\">${[[\"cs\",\"Čeština\"],[\"en\",\"English\"],[\"de\",\"Deutsch\"],[\"es\",\"Español\"]].map(([v,n])=>`<option value=\"${v}\" ${s.language===v?\"selected\":\"\"}>${n}</option>`).join(\"\")}</select></div></div></div>\n<div class=\"screen\" id=\"api\">${back}<div class=\"screenTitle\">🔑 ${esc(L.api)}</div><div class=\"screenSub\">${esc(L.apiSub)}</div><div class=\"card\">${field(\"endpoint\",L.endpoint,s.endpoint)}<div class=\"field\"><label>${esc(L.apiKey)}</label><input id=\"apiKey\" type=\"password\" value=\"\" placeholder=\"••••••••\"><div class=\"rowDetail\">${esc(L.apiKeyHint)}</div></div></div><div class=\"info\" id=\"secretStatus\">${esc(hasSecret(\"apiKey\")?L.secretStored:L.secretMissing)}</div><div class=\"actionGrid\"><button class=\"actionBtn\" onclick=\"saveSecretValue()\">${esc(L.saveSecret)}</button><button class=\"actionBtn secondary\" onclick=\"removeSecretValue()\">${esc(L.removeSecret)}</button></div></div>\n<div class=\"screen\" id=\"diagnostics\">${back}<div class=\"screenTitle\">🧪 ${esc(L.diagnostics)}</div><div class=\"screenSub\">${esc(L.diagnosticsSub)}</div><button class=\"previewBtn\" style=\"width:100%;margin-bottom:12px\" onclick=\"runDiagnostics()\">🧪 ${esc(L.runDiagnostics)}</button><div class=\"card\" id=\"diagList\">${renderDiag([diagRow(L.settingsSchema,`${s.settingsVersion} / ${SETTINGS_VERSION}`,\"ok\"),diagRow(L.storage,STORAGE,\"ok\"),diagRow(L.updater,\"version.json + no-cache\",\"ok\")],s)}</div></div>\n<div class=\"screen\" id=\"maintenance\">${back}<div class=\"screenTitle\">💾 ${esc(L.maintenance)}</div><div class=\"screenSub\">${esc(L.maintenanceSub)}</div><div class=\"card\"><div class=\"actionGrid\"><button class=\"actionBtn\" onclick=\"emit('export',{settings:collect()})\">💾 ${esc(L.export)}</button><button class=\"actionBtn secondary\" onclick=\"emit('importFile')\">📥 ${esc(L.import)}</button><button class=\"actionBtn secondary\" onclick=\"emit('clearCache')\">🧹 ${esc(L.clearCache)}</button><button class=\"actionBtn danger\" onclick=\"emit('resetAll')\">↺ ${esc(L.resetAll)}</button></div><div id=\"toolStatus\" class=\"status\" style=\"padding:0 14px 12px\"></div></div></div>\n<div class=\"screen\" id=\"help\">${back}<div class=\"screenTitle\">❓ ${esc(L.help)}</div><div class=\"screenSub\">${esc(L.helpSub)}</div><div class=\"card\">${[L.help1,L.help2,L.help3,L.help4,L.help5].map(x=>`<div class=\"helpLine\">${esc(x)}</div>`).join(\"\")}</div></div>\n<script>\nconst initial=${JSON.stringify(s)},DEFAULTS=${JSON.stringify(DEFAULTS)},UI=${JSON.stringify(L)};let state={...initial};window.__nativeQueue=[];function emit(action,p={}){window.__nativeQueue.push({action,...p,nonce:Date.now()+Math.random()})}function showScreen(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}function value(id){return document.getElementById(id)?.value}function checked(id){return !!document.getElementById(id)?.checked}function collect(){const z={...state};for(const id of ['widgetTitle','subtitle','endpoint','backgroundColor','panelColor','textColor','mutedColor','accentColor','okColor','warningColor','failColor']){const e=document.getElementById(id);if(e)z[id]=e.value}for(const id of ['showSubtitle','useCustomColors']){const e=document.getElementById(id);if(e)z[id]=e.checked}const r=document.getElementById('refreshMinutes');if(r)z.refreshMinutes=Number(r.value);const l=document.getElementById('language');if(l)z.language=l.value;z.settingsVersion=${SETTINGS_VERSION};return z}let timer;function commit(){clearTimeout(timer);state=collect();emit('save',{settings:state});return state}function saveSoon(){clearTimeout(timer);timer=setTimeout(commit,180)}document.querySelectorAll('input,select').forEach(e=>{if(e.id==='apiKey')return;e.addEventListener('change',commit);if(e.type==='text'||e.type==='color')e.addEventListener('input',saveSoon)});for(const id of ${JSON.stringify(colorKeys.map(x=>x[0]))}){const p=document.getElementById(id+'Picker'),t=document.getElementById(id);if(p&&t){p.addEventListener('input',()=>{t.value=p.value.toUpperCase();const u=document.getElementById('useCustomColors');if(u)u.checked=true;commit()});t.addEventListener('input',()=>{let v=t.value.trim();if(v&&!v.startsWith('#'))v='#'+v;if(/^#[0-9A-Fa-f]{6}$/.test(v)){p.value=v;const u=document.getElementById('useCustomColors');if(u)u.checked=true}})}}function preview(f){emit('preview',{family:f,settings:collect()})}function requestUpdate(){document.getElementById('updateStatus').textContent=UI.checking;emit('update',{settings:collect()})}function runDiagnostics(){const root=document.getElementById('diagList');root.replaceChildren();const row=document.createElement('div'),title=document.createElement('div'),status=document.createElement('span');row.className='diagRow';title.className='diagTitle';title.textContent=UI.checking||'';status.className='diagState checking';status.textContent='⏳';row.append(title,status);root.appendChild(row);emit('diagnostics',{settings:collect()})}function saveSecretValue(){const v=value('apiKey')||'';emit('saveSecret',{key:'apiKey',value:v})}function removeSecretValue(){emit('removeSecret',{key:'apiKey'})}function resetAppearance(){Object.assign(state,{useCustomColors:false,backgroundColor:DEFAULTS.backgroundColor,panelColor:DEFAULTS.panelColor,textColor:DEFAULTS.textColor,mutedColor:DEFAULTS.mutedColor,accentColor:DEFAULTS.accentColor,okColor:DEFAULTS.okColor,warningColor:DEFAULTS.warningColor,failColor:DEFAULTS.failColor});emit('replace',{settings:state})}function renderDiagnostics(rows){const root=document.getElementById('diagList');root.replaceChildren();(rows||[]).forEach(r=>{const row=document.createElement('div');row.className='diagRow';const left=document.createElement('div'),title=document.createElement('div'),detail=document.createElement('div'),status=document.createElement('span');title.className='diagTitle';title.textContent=r.label||'';detail.className='diagDetail';detail.textContent=r.detail||'';left.append(title,detail);status.className='diagState '+(r.state||'error');status.textContent=r.state==='checking'?'⏳':r.state==='ok'?'● '+UI.ok:r.state==='warning'?'● '+UI.warning:r.state==='off'?'● OFF':'● '+UI.error;row.append(left,status);root.appendChild(row)})}window.__native=function(m){if(!m)return;if(m.action==='update'){const e=document.getElementById('updateStatus');e.textContent=m.text||'';e.className='status '+(m.ok?'ok':'error')}if(m.action==='diagnostics')renderDiagnostics(m.rows);if(m.action==='status'){const e=document.getElementById('toolStatus');if(e){e.textContent=m.text||'';e.className='status '+(m.ok?'ok':'error')}}if(m.action==='secret'){const e=document.getElementById('secretStatus');if(e)e.textContent=m.stored?UI.secretStored:UI.secretMissing;const k=document.getElementById('apiKey');if(k)k.value=''}if(m.action==='replace'){state=m.settings;location.reload()}};\n</script></body></html>`;\n}\n\nasync function send(web,o){ try{await web.evaluateJavaScript(`window.__native(${JSON.stringify(o)})`,false);}catch(_){} }\nasync function settingsUI(s){\n  const web=new WebView(); await web.loadHTML(settingsHTML(s)); let dismissed=false,cur=migrate(s); const presented=web.present(false).then(()=>dismissed=true); const sleep=ms=>new Promise(resolve=>Timer.schedule(ms,false,resolve));\n  while(!dismissed){ await sleep(150); if(dismissed)break; let raw=null; try{raw=await web.evaluateJavaScript(\"JSON.stringify(window.__nativeQueue.shift()||null)\");}catch(_){continue;} if(!raw||raw===\"null\")continue; let m;try{m=JSON.parse(raw);}catch(_){continue;} try{\n    if(m.action===\"save\"){cur=migrate(m.settings||cur);saveSettings(cur);}\n    else if(m.action===\"preview\"){cur=migrate(m.settings||cur);saveSettings(cur);const fam=(FEATURES.preview||[]).includes(m.family)?m.family:\"medium\";await presentWidget(await buildWidget(cur,fam),fam);}\n    else if(m.action===\"update\"){const r=await checkUpdate(cur);await send(web,{action:\"update\",...r});}\n    else if(m.action===\"diagnostics\"){cur=migrate(m.settings||cur);saveSettings(cur);const rows=await diagnostics(cur,async x=>send(web,{action:\"diagnostics\",rows:x}));await send(web,{action:\"diagnostics\",rows});}\n    else if(m.action===\"saveSecret\"){if(SECRET_KEYS.includes(m.key)&&String(m.value||\"\").trim())setSecret(m.key,m.value);await send(web,{action:\"secret\",stored:hasSecret(m.key)});}\n    else if(m.action===\"removeSecret\"){if(SECRET_KEYS.includes(m.key))removeSecret(m.key);await send(web,{action:\"secret\",stored:false});}\n    else if(m.action===\"export\"){cur=migrate(m.settings||cur);saveSettings(cur);await exportBackup(cur);await send(web,{action:\"status\",ok:true,text:tx(cur,\"exported\")});}\n    else if(m.action===\"importFile\"){try{const incoming=await importBackup();if(!incoming.language)incoming.language=cur.language||lang();cur=incoming;saveSettings(cur);await web.loadHTML(settingsHTML(cur));}catch(_){await send(web,{action:\"status\",ok:false,text:tx(cur,\"invalid\")});}}\n    else if(m.action===\"clearCache\"){clearCache();await send(web,{action:\"status\",ok:true,text:tx(cur,\"cacheCleared\")});}\n    else if(m.action===\"resetAll\"){const keepLang=cur.language;cur=migrate({...clone(DEFAULTS),language:keepLang});saveSettings(cur);clearCache();await web.loadHTML(settingsHTML(cur));}\n    else if(m.action===\"replace\"){cur=migrate(m.settings||cur);saveSettings(cur);await web.loadHTML(settingsHTML(cur));}\n  }catch(e){console.log(e);await send(web,{action:\"status\",ok:false,text:String(e?.message||e)});}}\n  try{await presented;}catch(_){} return cur;\n}\n\nlet SETTINGS=await firstLanguage(loadSettings());\nif(config.runsInWidget){const family=(FEATURES.preview||[]).includes(config.widgetFamily)?config.widgetFamily:\"medium\";Script.setWidget(await buildWidget(SETTINGS,family));}\nelse SETTINGS=await settingsUI(SETTINGS);\nScript.complete();",
  "share_sheet_inputs": []
}
