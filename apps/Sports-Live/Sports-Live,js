async function send(web,o){try{await web.evaluateJavaScript(`window.__native(${JSON.stringify(o)})`,false)}catch(_){}}
async function diagnostics(s){const rows=[];try{const a=await teamsFor(s);rows.push({label:`👥 ${tx(s,"team")}`,ok:a.length>0,detail:`${a.length} teams`})}catch(e){rows.push({label:`👥 ${tx(s,"team")}`,ok:false,detail:String(e).slice(0,100)})}try{const a=await eventsFor(s);rows.push({label:`🏟️ ${tx(s,"competition")}`,ok:a.length>0,detail:`${a.length} events · ${sourceName(s)}`})}catch(e){rows.push({label:`🏟️ ${tx(s,"competition")}`,ok:false,detail:String(e).slice(0,100)})}try{const d=await prepareData(s);rows.push({label:`⭐ ${tx(s,"team")}`,ok:!!d.current,detail:d.current?matchLabel(s,d.current):(d.reason||tx(s,"noGame"))})}catch(e){rows.push({label:`⭐ ${tx(s,"team")}`,ok:false,detail:String(e).slice(0,100)})}return rows}
async function settings(s){const web=new WebView();await web.loadHTML(html(s));let dismissed=false;const p=web.present(false).then(()=>dismissed=true);let cur=merge(s);const sleep=ms=>new Promise(r=>Timer.schedule(ms,false,r));while(!dismissed){await sleep(160);let raw=null;try{raw=await web.evaluateJavaScript("JSON.stringify(window.__nativeQueue.shift()||null)")}catch(_){continue}if(!raw||raw==="null")continue;let m;try{m=JSON.parse(raw)}catch(_){continue}try{if(m.action==="save"){cur=merge(m.settings);saveSettings(cur)}else if(m.action==="teams"){cur=merge(m.settings||cur);saveSettings(cur);const a=await teamsFor(cur);await send(web,{action:"teams",ok:!!a.length,teams:a})}else if(m.action==="preview"){cur=merge(m.settings||cur);saveSettings(cur);const f=m.family==="small"?"small":"medium";try{const w=await widget(cur,f);if(f==="small")await w.presentSmall();else await w.presentMedium()}finally{await send(web,{action:"previewDone"})}}else if(m.action==="diagnostics"){cur=merge(m.settings||cur);saveSettings(cur);await send(web,{action:"diagnostics",rows:await diagnostics(cur)})}else if(m.action==="export"){cur=merge(m.settings||cur);saveSettings(cur);Pasteboard.copyString(JSON.stringify(cur,null,2));await send(web,{action:"status",ok:true,text:tx(cur,"copied")})}else if(m.action==="import"){try{cur=merge(JSON.parse(m.raw||""));if(!cur.language)cur.language=s.language||lang();saveSettings(cur);await send(web,{action:"status",ok:true,text:tx(cur,"imported")});await send(web,{action:"replace",settings:cur})}catch(_){await send(web,{action:"status",ok:false,text:tx(cur,"invalid")})}}else if(m.action==="clearCache"){clearSportsLiveCache();await send(web,{action:"status",ok:true,text:tx(cur,"cacheCleared")})}else if(m.action==="pickImage"){try{const img=await Photos.fromLibrary();fm.writeImage(backgroundPath,img);cur=merge(Object.assign({},m.settings||cur,{backgroundMode:"image"}));saveSettings(cur);await send(web,{action:"status",target:"appearanceStatus",ok:true,text:tx(cur,"imageSaved")})}catch(e){await send(web,{action:"status",target:"appearanceStatus",ok:false,text:String(e)})}}else if(m.action==="clearImage"){try{if(fm.fileExists(backgroundPath))fm.remove(backgroundPath)}catch(_){}cur=merge(Object.assign({},m.settings||cur,{backgroundMode:"theme"}));saveSettings(cur);await send(web,{action:"status",target:"appearanceStatus",ok:true,text:tx(cur,"imageCleared")})}else if(m.action==="reset"){const base=merge(m.settings||cur),l=base.language||lang();if(m.part==="appearance")cur=Object.assign({},base,{theme:DEFAULTS.theme,accent:DEFAULTS.accent,backgroundMode:DEFAULTS.backgroundMode,backgroundColor:DEFAULTS.backgroundColor});else if(m.part==="team")cur=Object.assign({},base,{sportId:DEFAULTS.sportId,leagueId:DEFAULTS.leagueId,teamId:"",teamName:""});else{cur=clone(DEFAULTS);cur.language=l}saveSettings(cur);await send(web,{action:"status",ok:true,text:tx(cur,"resetDone")});await send(web,{action:"replace",settings:cur})}else if(m.action==="language"){cur=merge(Object.assign({},m.settings||cur,{language:m.language}));saveSettings(cur);await send(web,{action:"replace",settings:cur})}else if(m.action==="update"){cur=merge(m.settings||cur);saveSettings(cur);const r=await updater(cur);await send(web,{action:"update",ok:r.ok,text:r.text})}}catch(e){await send(web,{action:"status",ok:false,text:String(e)})}}try{await p}catch(_){}return cur}
function clearSportsLiveCache(){try{if(fm.fileExists(cachePath))fm.remove(cachePath);for(const n of fm.listContents(fm.cacheDirectory()))if(n.startsWith("SportsLive_")&&n.endsWith(".png"))try{fm.remove(fm.joinPath(fm.cacheDirectory(),n))}catch(_){}}catch(_){}}
function cmp(a,b){const A=String(a).split('.').map(Number),B=String(b).split('.').map(Number);for(let i=0;i<Math.max(A.length,B.length);i++){if((A[i]||0)>(B[i]||0))return 1;if((A[i]||0)<(B[i]||0))return-1}return 0}
async function updater(s){try{const src=await getString(UPDATE_SOURCE_URL);if(!src||src.length<UPDATE_MIN_BYTES)throw new Error("Bad source");const m=src.match(/const APP_VERSION\s*=\s*"([^"]+)"/);if(!m)throw new Error("No version");const v=m[1];if(cmp(v,APP_VERSION)<=0)return{ok:true,text:`${tx(s,"current")} v${APP_VERSION}`};const a=new Alert();a.title=APP_NAME;a.message=`${tx(s,"available")}: v${v}`;a.addAction(tx(s,"apply"));a.addCancelAction(tx(s,"cancel"));if(await a.presentAlert()!==0)return{ok:true,text:`v${APP_VERSION} → v${v}`};const target=module.filename;if(!target)throw new Error("Current script path unavailable");const cloud=FileManager.iCloud(),local=FileManager.local();let targetFm=local;if(cloud.fileExists(target)){targetFm=cloud;if(!cloud.isFileDownloaded(target))await cloud.downloadFileFromiCloud(target)}else if(!local.fileExists(target))throw new Error("Current script file not found");const backup=target.replace(/(\.js|,js)$/i,`_backup_v${APP_VERSION}.js`);try{targetFm.writeString(backup,targetFm.readString(target))}catch(_){}targetFm.writeString(target,src);return{ok:true,text:`${tx(s,"updated")} v${v}`}}catch(e){return{ok:false,text:`${tx(s,"updateFailed")} ${String(e?.message||e)}`}}}

