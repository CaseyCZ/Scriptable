me:x.name,short:x.short,logo:`https://api.sofascore.com/api/v1/team/${x.id}/image`});for(const e of d.events||[])for(const t of[e.home,e.away])if(t.id)map.set(t.id,{id:t.id,name:t.name,short:t.short,logo:t.logo});return[...map.values()].sort((a,b)=>a.name.localeCompare(b.name))}if(m.provider===\"sofa\"){const d=await sofaBundle(s),map=new Map();for(const x of d.table)map.set(x.id,{id:x.id,name:x.name,short:x.short,logo:`https://api.sofascore.com/api/v1/team/${x.id}/image`});for(const e of d.events)for(const t of[e.home,e.away])if(t.id)map.set(t.id,{id:t.id,name:t.name,short:t.short,logo:t.logo});return[...map.values()].sort((a,b)=>a.name.localeCompare(b.name))}return await espnTeams(s)}\nasync function standingsFor(s){const m=league(s);if(m.provider===\"soccer\"){try{const a=(await oneFootballMeta(s)).table;if(a.length)return a}catch(_){}try{const a=await espnStandings(s);if(a.length)return a}catch(_){}return fotmobRows(await fotmobLeague(s))}if(m.provider===\"livesport\")return(await livesportBundle(s)).table;if(m.provider===\"floorball\")return(await floorballBundle(s)).table;if(m.provider===\"sofa\")return(await sofaBundle(s)).table;return await espnStandings(s)}\nfunction unique(a){const m=new Map();for(const e of a||[])if(e?.id)m.set(e.id,e);return[...m.values()].sort((x,y)=>new Date(x.date)-new Date(y.date))}\nfunction sportsLiveEventWindow(s,needs,level=0){\n  const slow=s.sportId===\"football\"||s.sportId===\"floorball\",past=Math.max(slow?14:7,needs.recent*(slow?10:4)),baseFuture=Math.max(slow?28:10,needs.upcoming*(slow?14:7));\n  const future=level<=0?baseFuture:level===1?Math.max(baseFuture,30):Math.max(baseFuture,60);\n  return range(-past,future)\n}\nasync function espnTeamSchedule(s){\n  const m=league(s),base=s.apiEspnBase||DEFAULTS.apiEspnBase;\n  let teamId=String(s.teamId||\"\");\n  if(!teamId&&s.teamName){\n    const wanted=norm(s.teamName),teams=await espnTeams(s);\n    const hit=teams.find(t=>{const n=norm(t.name||t.short);return n===wanted||n.includes(wanted)||wanted.includes(n)});\n    teamId=String(hit?.id||\"\")\n  }\n  if(!teamId)return[];\n  const d=await requestJSON(`${base}/apis/site/v2/sports/${encodeURIComponent(m.espnSport)}/${encodeURIComponent(m.espnLeague)}/teams/${encodeURIComponent(teamId)}/schedule`);\n  return unique((d.events||[]).map(normEvent).filter(Boolean))\n}\nasync function eventsFor(s){\n  const m=league(s);\n  if(m.provider===\"espn\")return await espnTeamSchedule(s);\n  const needs={recent:5,upcoming:clamp(Number(s.nextCount)||4,1,8)};\n  let all=unique(await scoreboardFor(s,sportsLiveEventWindow(s,needs,0),needs));\n  for(let level=1;level<=2;level++){\n    const scoped=all.filter(e=>eventMatchesTeam(e,s)),now=Date.now();\n    const upcoming=scoped.filter(e=>e.state!==\"in\"&&!e.completed&&e.state!==\"post\"&&new Date(e.date).getTime()>now-4*3600000).length;\n    if(scoped.length&&upcoming>=needs.upcoming)break;\n    try{all=unique([...all,...await scoreboardFor(s,sportsLiveEventWindow(s,needs,level),needs)])}catch(_){break}\n  }\n  return all\n}\nasync function tableFor(s){return await standingsFor(s)}\n\nfunction norm(v){try{return String(v||\"\").normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g,\"\").toLowerCase().replace(/[^a-z0-9]+/g,\" \").trim()}catch(_){return String(v||\"\").trim().toLowerCase()}}\nfunction eventMatchesTeam(e,s){if(!s.teamId&&!s.teamName)return false;const wanted=norm(s.teamName);for(const t of[e.home,e.away]){const name=norm(t?.name||t?.short);if((s.teamId&&String(t?.id||\"\")===String(s.teamId))||(wanted&&(name===wanted||name.includes(wanted)||wanted.includes(name))))return true}return false}\nfunction teamIs(t,s){const a=norm(t?.name||t?.short),b=norm(s.teamName);return (s.teamId&&String(t?.id||\"\")===String(s.teamId))||(b&&(a===b||a.includes(b)||b.includes(a)))}\nfunction tableRow(t,rows=[]){const n=norm(t?.name||t?.short);return rows.find(x=>String(x.id)===String(t?.id))||rows.find(x=>{const q=norm(x.name||x.short);return n&&(q===n||q.includes(n)||n.includes(q))})||null}\nfunction emptyRecord(){return{wins:\"\",draws:\"\",losses:\"\",rank:\"\"}}\nfunction recOf(t,rows){const x=tableRow(t,rows);return x?{wins:String(x.wins??\"\"),draws:String(x.draws??\"\"),losses:String(x.losses??\"\"),rank:String(x.rank??\"\")}:emptyRecord()}\nfunction cacheKey(s){return `${s.sportId}|${s.leagueId}|${s.teamId||s.teamName}`}\nfunction readCache(){try{return fm.fileExists(cachePath)?JSON.parse(fm.readString(cachePath)):{} }catch(_){return{}}}\nfunction writeCache(key,data){try{const all=readCache();all[key]={ts:Date.now(),data};fm.writeString(cachePath,JSON.stringify(all))}catch(e){console.log(e)}}\nfunction cached(key){const all=readCache(),x=all[key];return x?.data?Object.assign({},x.data,{source:\"cache\"}):null}\nasync function prepareData(s){\n  if(!s.teamId&&!s.teamName)return{source:\"error\",reason:\"team\",current:null,nextGames:[]};\n  const key=cacheKey(s);\n  try{\n    const events=await eventsFor(s);\n    let rows=[];try{rows=await tableFor(s)}catch(e){console.log(e)}\n    const all=events.filter(e=>eventMatchesTeam(e,s)).sort((a,b)=>new Date(a.date)-new Date(b.date)),now=Date.now();\n    if(!all.length)throw new Error(`No team events · ${leagueName(s)} · ${sourceName(s)}`);\n    const live=all.filter(e=>e.state===\"in\"),future=all.filter(e=>e.state!==\"in\"&&!e.completed&&e.state!==\"post\"&&new Date(e.date).getTime()>now-4*3600000),done=all.filter(e=>e.completed||e.state===\"post\").sort((a,b)=>new Date(b.date)-new Date(a.date));\n    const current=live[0]||future[0]||done[0]||null;\n    if(!current)throw new Error(`No current event · ${leagueName(s)}`);\n    const my=teamIs(current.home,s)?current.home:current.away,op=teamIs(current.home,s)?current.away:current.home;\n    const nextGames=future.filter(e=>e.id!==current.id).slice(0,s.nextCount).map(e=>{const opponent=teamIs(e.home,s)?e.away:e.home;return{gameDate:e.date,opponent}});\n    const data={source:\"online\",current:{id:current.id,gameDate:current.date,gameStatus:current.status||\"\",state:current.state,venue:current.venue||\"\",homeTeam:Object.assign({},current.home,{record:recOf(current.home,rows)}),awayTeam:Object.assign({},current.away,{record:recOf(current.away,rows)}),myTeam:my,opponent:op,nextGames},nextGames};\n    writeCache(key,data);return data\n  }catch(e){console.log(e);return cached(key)||{source:\"error\",reason:String(e?.message||e),current:null,nextGames:[]}}\n}\n\nfunction widgetColors(s){\n  if(s.useCustomColors)return{bg:new Color(s.backgroundColor),card:new Color(s.panelColor),text:new Color(s.textColor),muted:new Color(s.mutedColor),accent:new Color(s.accentColor),ok:new Color(s.liveColor),warn:new Color(\"FF9F0A\"),fail:new Color(s.failColor)};\n  return{bg:Color.dynamic(new Color(\"F5F7FB\"),new Color(\"0B1020\")),card:Color.dynamic(new Color(\"FFFFFF\"),new Color(\"141B2D\")),text:Color.dynamic(new Color(\"111827\"),new Color(\"F8FAFC\")),muted:Color.dynamic(new Color(\"6B7280\"),new Color(\"94A3B8\")),accent:new Color(\"38BDF8\"),ok:new Color(\"34C759\"),warn:new Color(\"FF9F0A\"),fail:new Color(\"FF453A\")}\n}\nfunction textColor(s){return widgetColors(s).text}\nfunction mutedColor(s){return widgetColors(s).muted}\nasync function applyBackground(w,s,c=widgetColors(s)){w.backgroundColor=c.bg}\nfunction addText(st,v,size,s,bold=false,color=null){const t=st.addText(String(v??\"\"));t.font=bold?Font.boldSystemFont(size):Font.systemFont(size);t.textColor=color||textColor(s);t.lineLimit=1;t.minimumScaleFactor=.65;return t}\nfunction addSemiText(st,v,size,s,color=null){const t=st.addText(String(v??\"\"));t.font=Font.semiboldSystemFont(size);t.textColor=color||textColor(s);t.lineLimit=1;t.minimumScaleFactor=.65;return t}\nfunction addSymbol(st,name,size,color){try{const sf=SFSymbol.named(name);sf.applyFont(Font.semiboldSystemFont(size));const im=st.addImage(sf.image);im.imageSize=new Size(size,size);im.tintColor=color;return im}catch(_){return null}}\nfunction logoCachePath(url,key){const safe=String(key||\"logo\").replace(/[^a-zA-Z0-9_-]/g,\"_\").slice(0,48)||\"logo\";let h=2166136261;for(const ch of String(url||\"\")){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return fm.joinPath(fm.cacheDirectory(),`SportsLive_${safe}_${(h>>>0).toString(36)}.png`)}\nasync function loadLogo(url,key){if(!url)return null;const p=logoCachePath(url,key);try{if(fm.fileExists(p))return fm.readImage(p);const r=new Request(url);r.timeoutInterval=API_TIMEOUT;const i=await r.loadImage();fm.writeImage(p,i);return i}catch(_){return null}}\nfunction fmtDate(s,iso,withYear=false){const d=new Date(iso);return d.toLocaleDateString(s.language||\"en\",{day:\"2-digit\",month:\"2-digit\",...(withYear?{year:\"numeric\"}:{})})}\nfunction fmtTime(s,iso){return new Date(iso).toLocaleTimeString(s.language||\"en\",{hour:\"2-digit\",minute:\"2-digit\"})}\nfunction matchLabel(s,e){if(e.state===\"in\")return `${tx(s,\"liveNow\")} · ${e.gameStatus||\"\"}`.trim();const d=new Date(e.gameDate),n=new Date(),tm=new Date(n);tm.setDate(n.getDate()+1);if(d.toDateString()===n.toDateString())return `${tx(s,\"today\")} · ${fmtTime(s,e.gameDate)}`;if(d.toDateString()===tm.toDateString())return `${tx(s,\"tomorrow\")} · ${fmtTime(s,e.gameDate)}`;return `${fmtDate(s,e.gameDate,true)} · ${fmtTime(s,e.gameDate)}`}\nfunction recordLine(s,r){const bits=[];if(r?.wins!==\"\")bits.push(`${tx(s,\"wins\")}: ${r.wins}`);if((s.sportId===\"football\"||s.sportId===\"floorball\")&&r?.draws!==\"\")bits.push(`${tx(s,\"draws\")}: ${r.draws}`);if(r?.losses!==\"\")bits.push(`${tx(s,\"losses\")}: ${r.losses}`);return bits.join(\" · \")||\"–\"}\nfunction rankLine(s,r){return r?.rank?`${tx(s,\"rank\")}: ${r.rank}`:\"\"}\nfunction displayPair(g,s){return s.homeFirst?[g.homeTeam,g.awayTeam]:[g.awayTeam,g.homeTeam]}\nfunction scoreText(g,s){if(!s.showLive)return\"VS\";const [a,b]=displayPair(g,s),sa=a?.score,sb=b?.score;if((sa===\"\"||sa==null)&&(sb===\"\"||sb==null))return\"VS\";return `${sa===\"\"||sa==null?\"–\":sa} : ${sb===\"\"||sb==null?\"–\":sb}`}\nfunction sportsHeader(w,s,d,c,size=15){const h=w.addStack();h.centerAlignContent();addSymbol(h,\"trophy.fill\",size,c.accent);h.addSpacer(6);addText(h,s.widgetTitle||s.teamName||APP_NAME,size,s,true,c.text);h.addSpacer();const right=d?.current?.state===\"in\"?tx(s,\"liveNow\"):leagueName(s);addSemiText(h,right,8,s,d?.current?.state===\"in\"?c.ok:c.muted);return h}\nfunction noGameCard(w,s,d,c){w.addSpacer(7);const card=w.addStack();card.layoutVertically();card.backgroundColor=c.card;card.cornerRadius=12;card.setPadding(12,9,12,9);const r=card.addStack();r.addSpacer();addSymbol(r,d.reason===\"team\"?\"person.crop.circle\":\"calendar.badge.exclamationmark\",24,d.reason===\"team\"?c.accent:c.warn);r.addSpacer();card.addSpacer(7);const t=addText(card,d.reason===\"team\"?tx(s,\"noTeam\"):tx(s,\"noGame\"),10,s,true,c.text);t.centerAlignText();return card}\nasync function sportTeamCard(parent,t,s,c,wide=false){const card=parent.addStack();card.layoutVertically();card.backgroundColor=c.card;card.cornerRadius=12;card.setPadding(wide?8:7,wide?9:7,wide?8:7,wide?9:7);if(wide)card.size=new Size(136,0);const nameRow=card.addStack();nameRow.addSpacer();addSemiText(nameRow,t.short||t.name,wide?9:8,s,c.muted);nameRow.addSpacer();card.addSpacer(wide?5:4);const core=card.addStack();core.centerAlignContent();core.addSpacer();const img=await loadLogo(t.logo,t.id||t.abbr||t.name);if(img){const v=core.addImage(img);v.imageSize=new Size(wide?36:29,wide?36:29)}else addSymbol(core,\"sportscourt.fill\",wide?28:23,c.muted);if(s.showLive){core.addSpacer(wide?8:6);addText(core,(t.score===\"\"||t.score==null)?\"–\":String(t.score),wide?24:18,s,true,c.text)}core.addSpacer();if(s.showStats){card.addSpacer(wide?5:3);const rr=card.addStack();rr.addSpacer();addText(rr,recordLine(s,t.record),wide?8:7,s,false,c.muted);rr.addSpacer();const rank=rankLine(s,t.record);if(rank){card.addSpacer(2);const qr=card.addStack();qr.addSpacer();addText(qr,rank,7,s,false,c.muted);qr.addSpacer()}}return card}\nasync function addSmallWidgetData(w,s,d,c){sportsHeader(w,s,d,c,13);if(!d.current){noGameCard(w,s,d,c);return}const g=d.current,[left,right]=displayPair(g,s);w.addSpacer(7);const card=w.addStack();card.layoutVertically();card.backgroundColor=c.card;card.cornerRadius=12;card.setPadding(7,7,7,7);const status=card.addStack();status.addSpacer();addSemiText(status,matchLabel(s,g),8,s,g.state===\"in\"?c.ok:c.muted);status.addSpacer();card.addSpacer(5);const row=card.addStack();row.centerAlignContent();const li=await loadLogo(left.logo,left.id||left.abbr||left.name);if(li){const v=row.addImage(li);v.imageSize=new Size(32,32)}else addSymbol(row,\"sportscourt.fill\",27,c.muted);row.addSpacer();const mid=row.addStack();mid.layoutVertically();mid.centerAlignContent();const sc=addText(mid,scoreText(g,s),17,s,true,g.state===\"in\"?c.ok:c.text);sc.centerAlignText();mid.addSpacer(2);const versus=addText(mid,`${left.short||left.name} · ${right.short||right.name}`,7,s,false,c.muted);versus.centerAlignText();row.addSpacer();const ri=await loadLogo(right.logo,right.id||right.abbr||right.name);if(ri){const v=row.addImage(ri);v.imageSize=new Size(32,32)}else addSymbol(row,\"sportscourt.fill\",27,c.muted);if(s.showStats){card.addSpacer(5);const mine=teamIs(left,s)?left:right;const rr=card.addStack();rr.addSpacer();addText(rr,recordLine(s,mine.record),8,s,false,c.muted);rr.addSpacer()}if(s.showNext&&g.nextGames?.length){w.addSpacer();const n=g.nextGames[0],foot=w.addStack();foot.centerAlignContent();addSemiText(foot,tx(s,\"nextGames\"),7,s,c.muted);foot.addSpacer(5);const im=await loadLogo(n.opponent.logo,n.opponent.id||n.opponent.name);if(im){const v=foot.addImage(im);v.imageSize=new Size(13,13)}foot.addSpacer(4);addText(foot,`${fmtDate(s,n.gameDate)} · ${n.opponent.short||n.opponent.name}`,7,s,false,c.muted)}}\nasync function addMediumWidgetData(w,s,d,c){sportsHeader(w,s,d,c,15);if(!d.current){noGameCard(w,s,d,c);return}const g=d.current,[left,right]=displayPair(g,s);w.addSpacer(8);const meta=w.addStack();meta.centerAlignContent();meta.addSpacer();addSemiText(meta,matchLabel(s,g),9,s,g.state===\"in\"?c.ok:c.muted);if(g.venue){meta.addSpacer(7);addText(meta,`· ${g.venue}`,8,s,false,c.muted)}meta.addSpacer();w.addSpacer(6);const teams=w.addStack();teams.addSpacer();await sportTeamCard(teams,left,s,c,true);teams.addSpacer(7);await sportTeamCard(teams,right,s,c,true);teams.addSpacer();w.addSpacer();const footer=w.addStack();footer.centerAlignContent();footer.addSpacer();const score=scoreText(g,s);if(score!==\"VS\"){addSemiText(footer,score,9,s,g.state===\"in\"?c.ok:c.text);footer.addSpacer(8)}if(s.showNext&&g.nextGames?.length){addText(footer,tx(s,\"nextGames\"),8,s,false,c.muted);for(const n of g.nextGames.slice(0,Math.min(3,s.nextCount))){footer.addSpacer(7);const im=await loadLogo(n.opponent.logo,n.opponent.id||n.opponent.name);if(im){const v=footer.addImage(im);v.imageSize=new Size(13,13)}footer.addSpacer(3);addText(footer,fmtDate(s,n.gameDate),8,s,false,c.muted)}}footer.addSpacer();return w}\nasync function widget(s,family){const d=await prepareData(s),c=widgetColors(s),w=new ListWidget();await applyBackground(w,s,c);w.setPadding(family===\"small\"?14:11,10,family===\"small\"?11:9,10);w.refreshAfterDate=new Date(Date.now()+s.refreshMinutes*60000);try{const u=URLScheme.forRunningScript();w.url=u+(u.includes(\"?\")?\"&\":\"?\")+`sportsLiveFamily=${encodeURIComponent(family)}`}catch(_){}if(family===\"small\")await addSmallWidgetData(w,s,d,c);else if(family===\"medium\")await addMediumWidgetData(w,s,d,c);else{sportsHeader(w,s,d,c,16);w.addSpacer();const card=w.addStack();card.backgroundColor=c.card;card.cornerRadius=12;card.setPadding(12,12,12,12);const t=addText(card,tx(s,\"widgetHelp\"),13,s,true,c.text);t.centerAlignText();w.addSpacer()}Script.setWidget(w);return w}\n\nfunction esc(v){return String(v??\"\").replace(/[&<>\"']/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c]))}\nfunction inputField(id,label,value,type=\"text\",extra=\"\",detail=\"\"){return `<div class=\"field\"><label for=\"${id}\">${esc(label)}</label>${detail?`<div class=\"rowDetail\" style=\"margin:-2px 0 9px\">${esc(detail)}</div>`:\"\"}<input id=\"${id}\" type=\"${type}\" value=\"${esc(value)}\" ${extra}></div>`}\nfunction selectField(id,label,value,items,detail=\"\"){return `<div class=\"field\"><label for=\"${id}\">${esc(label)}</label>${detail?`<div class=\"rowDetail\" style=\"margin:-2px 0 9px\">${esc(detail)}</div>`:\"\"}<select id=\"${id}\">${items.map(([v,t])=>`<option value=\"${esc(v)}\" ${String(v)===String(value)?\"selected\":\"\"}>${esc(t)}</option>`).join(\"\")}</select></div>`}\nfunction sw(id,label,on,detail=\"\"){return `<label class=\"settingRow\"><div class=\"rowText\"><div class=\"rowTitle\">${esc(label)}</div>${detail?`<div class=\"rowDetail\">${esc(detail)}</div>`:\"\"}</div><span class=\"switch\"><input id=\"${id}\" type=\"checkbox\" ${on?\"checked\":\"\"}><span class=\"slider\"></span></span></label>`}\nfunction nav(screen,icon,title,detail=\"\"){return `<div class=\"navRow\" onclick=\"showScreen('${screen}')\"><div class=\"navLeft\"><span class=\"navIcon\">${icon}</span><span>${esc(title)}</span></div><div class=\"navRight\"><span class=\"navDetail\">${esc(detail)}</span><span class=\"chevron\">›</span></div></div>`}\nfunction colorField(id,label,value){return `<div class=\"field\"><label>${esc(label)}</label><div class=\"colorControl\"><input id=\"${id}Picker\" class=\"colorPicker\" type=\"color\" value=\"${esc(value)}\" oninput=\"syncColorFromPicker('${id}')\"><input id=\"${id}\" class=\"colorCode\" type=\"text\" maxlength=\"7\" value=\"${esc(value)}\" oninput=\"syncColorFromText('${id}')\"></div></div>`}\nfunction html(s){\n  const L=Object.assign({},T[s.language||\"en\"]||T.en,UX[s.language||\"en\"]||UX.en),sp=sport(s),sportLabel=sp?.[s.language]||sp?.en||sp?.id||\"\",\n    sportOpts=SPORTS.map(x=>[x.id,`${x.icon} ${x[s.language]||x.en}`]),leagueOpts=leaguesForSport(s.sportId).map(x=>[x.id,`${x.flag||\"\"} ${x[s.language]||x.en}`]),\n    teamOpts=s.teamId?[[s.teamId,s.teamName||s.teamId]]:[[\"\",L.chooseTeam]],teamDetail=s.teamName?`${sp.icon} ${s.teamName}`:`${sp.icon} ${sportLabel} · ${leagueName(s)}`,\n    back=`<div class=\"topbar\"><button class=\"back\" onclick=\"showScreen('home')\">‹ ${esc(L.back)}</button><span></span></div>`;\n  return `<!doctype html><html lang=\"${s.language}\"><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>\n:root{color-scheme:dark;--bg:#0b1020;--panel:#111827;--panel2:#172033;--border:#2a3850;--text:#f8fafc;--muted:#94a3b8;--accent:#38bdf8;--ok:#86efac;--danger:#fb7185;--shadow:0 24px 70px rgba(0,0,0,.45)}\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;color:var(--text);font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;-webkit-tap-highlight-color:transparent}html{background:#070b14}body{padding:calc(14px + env(safe-area-inset-top)) 14px calc(36px + env(safe-area-inset-bottom));max-width:680px;margin:auto;background:radial-gradient(circle at top,#172554 0,#0b1020 42%,#070b14 100%);background-attachment:fixed}.screen{display:none}.screen.active{display:block}.topbar{display:flex;align-items:center;justify-content:space-between;min-height:42px;margin:0 2px 8px}.back{border:0;background:transparent;color:var(--accent);font:inherit;font-size:16px;font-weight:750;padding:7px 0}.hero{background:rgba(17,24,39,.96);border:1px solid var(--border);border-radius:22px;padding:22px;margin-bottom:14px;box-shadow:var(--shadow)}.heroTop{display:flex;align-items:center;justify-content:space-between;gap:10px}.eyebrow,.langBadge{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid #1d4ed8;border-radius:999px;background:#0f1f46;color:#bfdbfe;font-size:.78rem;font-weight:700}.updateBtn{border:1px solid #1d4ed8;border-radius:999px;background:#0f1f46;color:#bfdbfe;padding:6px 10px;font:inherit;font-size:.78rem;font-weight:800}.hero h1,.screenTitle{font-size:27px;line-height:1.15;margin:14px 0 6px;font-weight:800;letter-spacing:-.45px}.screenTitle{margin:5px 2px 6px}.hero p,.screenSub{color:var(--muted);font-size:14px;line-height:1.5;margin:0}.screenSub{margin:0 2px 14px}.sectionTitle{font-size:11px;color:#9fb3ce;text-transform:uppercase;letter-spacing:.1em;font-weight:800;margin:19px 9px 8px}.card{background:rgba(17,24,39,.96);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:13px;box-shadow:0 12px 34px rgba(0,0,0,.24)}.navRow,.settingRow{min-height:54px;display:flex;align-items:center;justify-content:space-between;padding:9px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.navRow:last-child,.settingRow:last-child{border-bottom:0}.navRow:active{background:var(--panel2)}.navLeft{display:flex;gap:11px;align-items:center;font-size:15px;font-weight:700;min-width:0}.navIcon{width:26px;text-align:center}.navRight{display:flex;align-items:center;gap:8px;min-width:0}.navDetail,.rowDetail{font-size:12px;color:var(--muted);line-height:1.35}.navDetail{max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rowText{min-width:0;padding-right:11px}.rowTitle{font-size:15px;font-weight:650}.chevron{font-size:23px;color:#64748b}.info{margin:14px 0;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--panel2);color:#cbd5e1;font-size:.86rem;line-height:1.45}.field{padding:12px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.field:last-child{border-bottom:0}.field label{display:block;margin-bottom:7px;color:#dbeafe;font-size:.82rem;font-weight:650}input[type=text],input[type=password],input[type=number],select,textarea{width:100%;min-height:46px;border:1px solid var(--border);border-radius:12px;background:#0b1220;color:var(--text);padding:0 13px;font:inherit;font-size:15px;outline:none}textarea{min-height:165px;padding:12px;resize:vertical;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(56,189,248,.12)}.switch{position:relative;width:50px;height:30px;flex:0 0 50px}.switch input{display:none}.slider{position:absolute;inset:0;background:#243149;border:1px solid var(--border);border-radius:999px}.slider:before{content:\"\";position:absolute;width:24px;height:24px;left:2px;top:2px;background:#fff;border-radius:50%;transition:.18s}.switch input:checked+.slider{background:#0284c7;border-color:#38bdf8}.switch input:checked+.slider:before{transform:translateX(20px)}.previewGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:10px}.previewBtn,.actionBtn{min-height:48px;border:1px solid #1d4ed8;border-radius:13px;background:linear-gradient(135deg,#0369a1,#0284c7);color:#fff;font:inherit;font-weight:800;font-size:13px}.previewBtn:disabled,.actionBtn:disabled{opacity:.55}.actionGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px}.actionBtn.secondary{background:#243149;border-color:var(--border)}.actionBtn.danger{background:#3a1720;border-color:#6b2738;color:#fecdd3}.full{grid-column:1/-1}.status{min-height:18px;color:var(--muted);font-size:12px;padding:0 14px 12px}.footer{color:#64748b;text-align:center;font-size:.76rem;margin:16px 4px 0}.sourcePill{display:inline-flex;padding:5px 8px;border:1px solid var(--border);border-radius:999px;background:#0b1220;color:var(--muted);font-size:11px;font-weight:700;margin:5px 4px 0 0}.colorControl{display:flex;align-items:center;gap:12px}.colorPicker{width:100px;height:62px;padding:5px;border:1px solid var(--border);border-radius:12px;background:#0b1220;flex:0 0 100px}.colorCode{flex:1}.diagRow{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:54px;padding:9px 14px;border-bottom:1px solid rgba(42,56,80,.85)}.diagRow:last-child{border-bottom:0}.diagTitle{font-size:14px;font-weight:650}.diagDetail{font-size:11px;color:var(--muted);margin-top:3px;max-width:330px}.diagState{font-size:11px;font-weight:800;white-space:nowrap}.diagState.ok{color:var(--ok)}.diagState.error{color:var(--danger)}.diagState.idle{color:#64748b}@media(max-width:520px){.hero{padding:20px}.hero h1,.screenTitle{font-size:25px}.navDetail{max-width:135px}.colorPicker{width:90px;flex-basis:90px}}@media(max-width:360px){.actionGrid{grid-template-columns:1fr}.full{grid-column:auto}.colorPicker{width:74px;flex-basis:74px}}\n</style></head><body>\n<div class=\"screen active\" id=\"home\"><div class=\"hero\"><div class=\"heroTop\"><span class=\"eyebrow\">🏆 ${APP_NAME} · v${APP_VERSION}</span><button class=\"updateBtn\" onclick=\"requestUpdate()\">↻ ${esc(L.update)}</button></div><h1>${APP_NAME}</h1><p>${esc(L.subtitle)}</p><div id=\"updateStatus\" class=\"status\" style=\"padding:8px 0 0\"></div></div><div class=\"sectionTitle\">${esc(L.preview)}</div><div class=\"previewGrid\"><button class=\"previewBtn previewAction\" onclick=\"preview('small')\">▣ ${esc(L.small)}</button><button class=\"previewBtn previewAction\" onclick=\"preview('medium')\">▰ ${esc(L.medium)}</button></div><div class=\"info\">${esc(L.saved)}</div><div class=\"sectionTitle\">${esc(L.sport)}</div><div class=\"card\">${nav(\"sport\",\"🏆\",L.sport,teamDetail)}</div><div class=\"sectionTitle\">${esc(L.widget)}</div><div class=\"card\">${nav(\"widget\",\"▦\",L.widget,L.widgetSub)}</div><div class=\"sectionTitle\">${esc(L.appearanceTitle)}</div><div class=\"card\">${nav(\"appearance\",\"🎨\",L.appearanceTitle,s.useCustomColors?L.customColors:\"\")}</div><div class=\"sectionTitle\">${esc(L.tools)}</div><div class=\"card\">${nav(\"behavior\",\"⚙️\",L.behavior,L.language)}${nav(\"api\",\"🔑\",L.api,sourceLabel(s))}${nav(\"diagnostics\",\"🧪\",L.diagnostics)}${nav(\"maintenance\",\"💾\",L.maintenance)}</div><div class=\"footer\"><span class=\"langBadge\">${s.language.toUpperCase()} • Sports Live ${APP_VERSION}</span></div></div>\n<div class=\"screen\" id=\"sport\">${back}<div class=\"screenTitle\">🏆 ${esc(L.sport)}</div><div class=\"screenSub\">${esc(L.sportSub)}</div><div class=\"card\">${selectField(\"sportId\",L.sport,s.sportId,sportOpts)}${selectField(\"leagueId\",L.competition,s.leagueId,leagueOpts)}${selectField(\"teamId\",L.team,s.teamId,teamOpts)}<div class=\"actionGrid\"><button class=\"actionBtn full\" onclick=\"loadTeams()\">↻ ${esc(L.loadTeams)}</button></div><div id=\"sourceStatus\" class=\"status\">${esc(sourceLabel(s))}</div></div><div class=\"info\">${esc(L.dataHelp)}</div></div>\n<div class=\"screen\" id=\"widget\">${back}<div class=\"screenTitle\">▦ ${esc(L.widget)}</div><div class=\"screenSub\">${esc(L.widgetSub)}</div><div class=\"card\">${sw(\"showLive\",L.live,s.showLive)}${sw(\"showStats\",L.stats,s.showStats)}${sw(\"showNext\",L.next,s.showNext)}${sw(\"homeFirst\",L.homeFirst,s.homeFirst)}${inputField(\"nextCount\",L.nextCount,s.nextCount,\"number\",'min=\"1\" max=\"4\"')}</div></div>\n<div class=\"screen\" id=\"appearance\">${back}<div class=\"screenTitle\">🎨 ${esc(L.appearanceTitle)}</div><div class=\"screenSub\">${esc(L.appearanceSub)}</div><div class=\"card\">${inputField(\"widgetTitle\",L.widgetTitle,s.widgetTitle,\"text\",'maxlength=\"48\"')}</div><div class=\"sectionTitle\">${esc(L.visibility)}</div><div class=\"card\">${sw(\"showLive\",L.live,s.showLive)}${sw(\"showStats\",L.stats,s.showStats)}${sw(\"showNext\",L.next,s.showNext)}</div><div class=\"sectionTitle\">${esc(L.customColors)}</div><div class=\"card\">${sw(\"useCustomColors\",L.useCustomColors,s.useCustomColors)}${colorField(\"backgroundColor\",L.backgroundColor,s.backgroundColor)}${colorField(\"panelColor\",L.panelColor,s.panelColor)}${colorField(\"textColor\",L.textColor,s.textColor)}${colorField(\"mutedColor\",L.mutedColor,s.mutedColor)}${colorField(\"accentColor\",L.accentColor,s.accentColor)}${colorField(\"liveColor\",L.liveColor,s.liveColor)}${colorField(\"failColor\",L.failColor,s.failColor)}</div><div class=\"actionGrid\"><button class=\"actionBtn secondary full\" onclick=\"resetPart('appearance')\">↺ ${esc(L.resetAppearance)}</button></div><div id=\"appearanceStatus\" class=\"status\"></div></div>\n<div class=\"screen\" id=\"behavior\">${back}<div class=\"screenTitle\">⚙️ ${esc(L.behavior)}</div><div class=\"screenSub\">${esc(L.behaviorSub)}</div><div class=\"card\"><div class=\"field\"><label>${esc(L.refresh)}</label><select id=\"refreshMinutes\">${[5,10,15,30,60,120,180].map(v=>`<option value=\"${v}\" ${s.refreshMinutes===v?\"selected\":\"\"}>${v} ${esc(L.minutes)}</option>`).join(\"\")}</select></div><div class=\"field\"><label>${esc(L.language)}</label><select id=\"languageSelect\"><option value=\"cs\" ${s.language===\"cs\"?\"selected\":\"\"}>🇨🇿 Čeština</option><option value=\"en\" ${s.language===\"en\"?\"selected\":\"\"}>🇬🇧 English</option><option value=\"de\" ${s.language===\"de\"?\"selected\":\"\"}>🇩🇪 Deutsch</option><option value=\"es\" ${s.language===\"es\"?\"selected\":\"\"}>🇪🇸 Español</option></select></div></div></div>\n<div class=\"screen\" id=\"api\">${back}<div class=\"screenTitle\">🔑 ${esc(L.api)}</div><div class=\"screenSub\">${esc(L.apiSub)}</div><div class=\"info\">✓ ${esc(L.provider)}: <b>${esc(sourceLabel(s))}</b><br>${esc(L.apiHint)}</div><div class=\"sectionTitle\">${esc(L.customEndpoints)}</div><div class=\"card\">${inputField(\"apiEspnBase\",\"ESPN\",s.apiEspnBase)}${inputField(\"apiFotmobBase\",\"FotMob\",s.apiFotmobBase)}${inputField(\"apiOneFootballFeedBase\",\"OneFootball Feed\",s.apiOneFootballFeedBase)}${inputField(\"apiOneFootballScoresBase\",\"OneFootball Scores\",s.apiOneFootballScoresBase)}${inputField(\"apiSofaBase\",\"SofaScore\",s.apiSofaBase)}${inputField(\"apiSportsApiBase\",\"SportsAPI Pro Floorball\",s.apiSportsApiBase)}${inputField(\"sportsApiKey\",\"SportsAPI Pro API key\",s.sportsApiKey,\"password\",'autocomplete=\"off\"')}</div></div>\n<div class=\"screen\" id=\"diagnostics\">${back}<div class=\"screenTitle\">🧪 ${esc(L.diagnostics)}</div><div class=\"screenSub\">${esc(L.diagnosticsSub)}</div><button class=\"previewBtn\" style=\"width:100%;margin-bottom:12px\" onclick=\"runDiagnostics()\">🧪 ${esc(L.runDiagnostics)}</button><div class=\"card\" id=\"diagList\"><div class=\"diagRow\"><div><div class=\"diagTitle\">👥 ${esc(L.team)}</div><div class=\"diagDetail\">${esc(L.runDiagnostics)}</div></div><span class=\"diagState idle\">●</span></div><div class=\"diagRow\"><div><div class=\"diagTitle\">🏟️ ${esc(L.competition)}</div><div class=\"diagDetail\">${esc(sourceLabel(s))}</div></div><span class=\"diagState idle\">●</span></div><div class=\"diagRow\"><div><div class=\"diagTitle\">⭐ ${esc(L.team)}</div><div class=\"diagDetail\">${esc(s.teamName||L.chooseTeam)}</div></div><span class=\"diagState idle\">●</span></div></div></div>\n<div class=\"screen\" id=\"maintenance\">${back}<div class=\"screenTitle\">💾 ${esc(L.maintenance)}</div><div class=\"card\"><div class=\"actionGrid\"><button class=\"actionBtn full\" onclick=\"exportJSON()\">💾 ${esc(L.export)}</button><button class=\"actionBtn secondary full\" onclick=\"importJSON()\">📥 ${esc(L.import)}</button><button class=\"actionBtn secondary\" onclick=\"clearCache()\">🧹 ${esc(L.clearCache)}</button><button class=\"actionBtn secondary\" onclick=\"resetPart('appearance')\">🎨 ${esc(L.resetAppearance)}</button><button class=\"actionBtn secondary\" onclick=\"resetPart('team')\">🏆 ${esc(L.resetTeam)}</button><button class=\"actionBtn danger\" onclick=\"resetPart('all')\">↺ ${esc(L.resetAll)}</button></div><div id=\"toolStatus\" class=\"status\"></div></div></div>\n\n<script>\nconst UI=Object.assign({},${JSON.stringify(L)}),CATALOG=${JSON.stringify(SPORTS)},initial=${JSON.stringify(s)};let state={...initial},timer;window.__nativeQueue=[];\nfunction emit(action,p={}){window.__nativeQueue.push({action,...p,nonce:Date.now()+Math.random()})}\nfunction showScreen(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}\nfunction leagues(id){return(CATALOG.find(x=>x.id===id)||CATALOG[0]).leagues||[]}\nfunction collect(){const z={...state};for(const k of['sportId','leagueId','teamId','widgetTitle','backgroundColor','panelColor','textColor','mutedColor','accentColor','liveColor','failColor','apiEspnBase','apiFotmobBase','apiOneFootballFeedBase','apiOneFootballScoresBase','apiSofaBase','apiSportsApiBase','sportsApiKey']){const e=document.getElementById(k);if(e)z[k]=e.value}const langEl=document.getElementById('languageSelect');if(langEl)z.language=langEl.value;const t=document.getElementById('teamId');if(t)z.teamName=t.value?(t.options[t.selectedIndex]?.text||''):'';for(const k of['showLive','showStats','showNext','homeFirst','useCustomColors']){const e=document.getElementById(k);if(e)z[k]=e.checked}const n=document.getElementById('nextCount');if(n)z.nextCount=Number(n.value);const r=document.getElementById('refreshMinutes');if(r)z.refreshMinutes=Number(r.value);return z}\nfunction commitNow(){clearTimeout(timer);state=collect();emit('save',{settings:state});const b=document.getElementById('jsonBox');if(b)b.value=JSON.stringify(state,null,2);return state}\nfunction saveSoon(){clearTimeout(timer);timer=setTimeout(commitNow,220)}\nfunction resetTeamSelect(){const t=document.getElementById('teamId');if(t)t.innerHTML='<option value=\"\">'+UI.chooseTeam+'</option>';state.teamId='';state.teamName=''}\nfunction fillLeagues(){const sid=document.getElementById('sportId').value,l=document.getElementById('leagueId');l.innerHTML='';leagues(sid).forEach(x=>{const o=document.createElement('option');o.value=x.id;o.textContent=(x.flag||'')+' '+(x[initial.language]||x.en||x.id);l.appendChild(o)});resetTeamSelect();commitNow()}\ndocument.getElementById('sportId')?.addEventListener('change',fillLeagues);document.getElementById('leagueId')?.addEventListener('change',()=>{resetTeamSelect();commitNow()});document.getElementById('teamId')?.addEventListener('change',commitNow);document.getElementById('languageSelect')?.addEventListener('change',e=>emit('language',{language:e.target.value,settings:{...collect(),language:e.target.value}}));\ndocument.querySelectorAll('input,select').forEach(x=>{if(['sportId','leagueId','teamId','languageSelect'].includes(x.id)||x.id.endsWith('Picker'))return;x.addEventListener('change',commitNow);if(['text','password','number'].includes(x.type))x.addEventListener('input',saveSoon)});\nfunction goodHex(v){return /^#[0-9A-Fa-f]{6}$/.test(String(v||''))}\nfunction syncColorFromPicker(id){const p=document.getElementById(id+'Picker'),t=document.getElementById(id);if(!p||!t)return;t.value=p.value.toUpperCase();commitNow()}\nfunction syncColorFromText(id){const p=document.getElementById(id+'Picker'),t=document.getElementById(id);if(!p||!t)return;const v=t.value.trim();if(goodHex(v)){p.value=v;saveSoon()}}\nfunction loadTeams(){const e=document.getElementById('sourceStatus');if(e)e.textContent=UI.loading;emit('teams',{settings:collect()})}\nfunction preview(f){state=commitNow();document.querySelectorAll('.previewAction').forEach(b=>b.disabled=true);emit('preview',{family:f,settings:state})}\nfunction runDiagnostics(){document.getElementById('diagList').innerHTML='<div class=\"diagRow\"><div class=\"diagTitle\">'+UI.checking+'</div><span class=\"diagState idle\">⏳</span></div>';emit('diagnostics',{settings:collect()})}\nfunction exportJSON(){emit('export',{settings:collect()})}function importJSON(){emit('importFile',{settings:collect()})}function clearCache(){emit('clearCache',{})}function resetPart(part){emit('reset',{part,settings:collect()})}function requestUpdate(){document.getElementById('updateStatus').textContent=UI.checking;emit('update',{settings:collect()})}\nfunction renderDiag(rows){const e=document.getElementById('diagList');e.innerHTML='';(rows||[]).forEach(d=>{const r=document.createElement('div');r.className='diagRow';const l=document.createElement('div'),a=document.createElement('div'),b=document.createElement('div'),st=document.createElement('span');a.className='diagTitle';a.textContent=d.label||'';b.className='diagDetail';b.textContent=d.detail||'';l.append(a,b);st.className='diagState '+(d.ok?'ok':'error');st.textContent=d.ok?'● '+UI.ok:'● '+UI.error;r.append(l,st);e.appendChild(r)})}\nwindow.__native=function(m){if(!m)return;if(m.action==='teams'){const sel=document.getElementById('teamId'),old=state.teamId||'';sel.innerHTML='<option value=\"\">'+UI.chooseTeam+'</option>';let matched=null;(m.teams||[]).forEach(t=>{const o=document.createElement('option');o.value=t.id;o.textContent=t.name;if(t.id===old||state.teamName===t.name){o.selected=true;matched=t}sel.appendChild(o)});if(matched){state.teamId=matched.id;state.teamName=matched.name}const e=document.getElementById('sourceStatus');e.textContent=m.ok?UI.teamsLoaded:UI.teamsFail;e.style.color=m.ok?'var(--ok)':'var(--danger)'}if(m.action==='previewDone')document.querySelectorAll('.previewAction').forEach(b=>b.disabled=false);if(m.action==='diagnostics')renderDiag(m.rows);if(m.action==='status'){const e=document.getElementById(m.target||'toolStatus');if(e){e.textContent=m.text||'';e.style.color=m.ok?'var(--ok)':'var(--danger)'}}if(m.action==='update'){const e=document.getElementById('updateStatus');e.textContent=m.text||'';e.style.color=m.ok?'var(--ok)':'var(--danger)'}if(m.action==='replace'){state=m.settings;location.reload()}};\n</script></body></html>`}\nasync function send(web,o){try{await web.evaluateJavaScript(`window.__native(${JSON.stringify(o)})`,false)}catch(_){}}\nasync function diagnostics(s){const rows=[];try{const a=await teamsFor(s);rows.push({label:`👥 ${tx(s,\"team\")}`,ok:a.length>0,detail:`${a.length} teams`})}catch(e){rows.push({label:`👥 ${tx(s,\"team\")}`,ok:false,detail:String(e).slice(0,100)})}try{const a=await eventsFor(s);rows.push({label:`🏟️ ${tx(s,\"competition\")}`,ok:a.length>0,detail:`${a.length} events · ${sourceName(s)}`})}catch(e){rows.push({label:`🏟️ ${tx(s,\"competition\")}`,ok:false,detail:String(e).slice(0,100)})}try{const d=await prepareData(s);rows.push({label:`⭐ ${tx(s,\"team\")}`,ok:!!d.current,detail:d.current?matchLabel(s,d.current):(d.reason||tx(s,\"noGame\"))})}catch(e){rows.push({label:`⭐ ${tx(s,\"team\")}`,ok:false,detail:String(e).slice(0,100)})}return rows}\nasync function settings(s){\n  const web=new WebView();await web.loadHTML(html(s));let dismissed=false;const p=web.present(false).then(()=>dismissed=true);let cur=merge(s);const sleep=ms=>new Promise(r=>Timer.schedule(ms,false,r));\n  while(!dismissed){await sleep(160);let raw=null;try{raw=await web.evaluateJavaScript(\"JSON.stringify(window.__nativeQueue.shift()||null)\")}catch(_){continue}if(!raw||raw===\"null\")continue;let m;try{m=JSON.parse(raw)}catch(_){continue}\n    try{\n      if(m.action===\"save\"){cur=merge(m.settings);saveSettings(cur)}\n      else if(m.action===\"teams\"){cur=merge(m.settings||cur);saveSettings(cur);const a=await teamsFor(cur);await send(web,{action:\"teams\",ok:!!a.length,teams:a})}\n      else if(m.action===\"preview\"){cur=merge(m.settings||cur);saveSettings(cur);const f=m.family===\"small\"?\"small\":\"medium\";try{const w=await widget(cur,f);if(f===\"small\")await w.presentSmall();else await w.presentMedium()}finally{await send(web,{action:\"previewDone\"})}}\n      else if(m.action===\"diagnostics\"){cur=merge(m.settings||cur);saveSettings(cur);await send(web,{action:\"diagnostics\",rows:await diagnostics(cur)})}\n      else if(m.action===\"export\"){\n        cur=merge(m.settings||cur);saveSettings(cur);\n        const now=new Date(),pad=n=>String(n).padStart(2,\"0\");\n        const stamp=now.getFullYear()+\"-\"+pad(now.getMonth()+1)+\"-\"+pad(now.getDate())+\"_\"+pad(now.getHours())+\"-\"+pad(now.getMinutes());\n        const backup={app:APP_NAME,version:APP_VERSION,exportedAt:now.toISOString(),settings:cur};\n        await DocumentPicker.exportString(JSON.stringify(backup,null,2),\"Sports Live backup \"+stamp+\".json\");\n        await send(web,{action:\"status\",ok:true,text:tx(cur,\"copied\")})\n      }\n      else if(m.action===\"importFile\"){\n        try{\n          const path=await DocumentPicker.openFile();\n          if(!path)throw new Error(tx(cur,\"invalid\"));\n          const raw=FileManager.local().readString(path);\n          const parsed=JSON.parse(raw||\"\");\n          const incoming=parsed&&parsed.app===APP_NAME&&parsed.settings?parsed.settings:parsed;\n          if(!incoming||typeof incoming!==\"object\"||Array.isArray(incoming))throw new Error(tx(cur,\"invalid\"));\n          cur=merge(incoming);if(!cur.language)cur.language=s.language||lang();saveSettings(cur);\n          await send(web,{action:\"status\",ok:true,text:tx(cur,\"imported\")});await send(web,{action:\"replace\",settings:cur})\n        }catch(_){await send(web,{action:\"status\",ok:false,text:tx(cur,\"invalid\")})}\n      }\n      else if(m.action===\"clearCache\"){clearSportsLiveCache();await send(web,{action:\"status\",ok:true,text:tx(cur,\"cacheCleared\")})}\n      else if(m.action===\"reset\"){const base=merge(m.settings||cur),l=base.language||lang();if(m.part===\"appearance\")cur=Object.assign({},base,{widgetTitle:DEFAULTS.widgetTitle,useCustomColors:DEFAULTS.useCustomColors,backgroundColor:DEFAULTS.backgroundColor,panelColor:DEFAULTS.panelColor,textColor:DEFAULTS.textColor,mutedColor:DEFAULTS.mutedColor,accentColor:DEFAULTS.accentColor,liveColor:DEFAULTS.liveColor,failColor:DEFAULTS.failColor});else if(m.part===\"team\")cur=Object.assign({},base,{sportId:DEFAULTS.sportId,leagueId:DEFAULTS.leagueId,teamId:\"\",teamName:\"\"});else{cur=clone(DEFAULTS);cur.language=l}saveSettings(cur);await send(web,{action:\"status\",target:m.part===\"appearance\"?\"appearanceStatus\":\"toolStatus\",ok:true,text:tx(cur,\"resetDone\")});await send(web,{action:\"replace\",settings:cur})}\n      else if(m.action===\"language\"){cur=merge(Object.assign({},m.settings||cur,{language:m.language}));saveSettings(cur);await send(web,{action:\"replace\",settings:cur})}\n      else if(m.action===\"update\"){cur=merge(m.settings||cur);saveSettings(cur);const r=await updater(cur);await send(web,{action:\"update\",ok:r.ok,text:r.text})}\n    }catch(e){await send(web,{action:\"status\",ok:false,text:String(e)})}\n  }\n  try{await p}catch(_){}return cur\n}\nfunction clearSportsLiveCache(){try{if(fm.fileExists(cachePath))fm.remove(cachePath);for(const n of fm.listContents(fm.cacheDirectory()))if(n.startsWith(\"SportsLive_\")&&n.endsWith(\".png\"))try{fm.remove(fm.joinPath(fm.cacheDirectory(),n))}catch(_){}}catch(_){}}\nfunction cmp(a,b){const A=String(a).split('.').map(Number),B=String(b).split('.').map(Number);for(let i=0;i<Math.max(A.length,B.length);i++){if((A[i]||0)>(B[i]||0))return 1;if((A[i]||0)<(B[i]||0))return-1}return 0}\nasync function updater(s){try{const updateUrl=UPDATE_SOURCE_URL+(UPDATE_SOURCE_URL.includes(\"?\")?\"&\":\"?\")+\"_=\"+Date.now();const req=new Request(updateUrl);req.timeoutInterval=API_TIMEOUT;req.headers={\"Cache-Control\":\"no-cache\",\"Pragma\":\"no-cache\"};const src=await req.loadString();if(!src||src.length<UPDATE_MIN_BYTES)throw new Error(\"Bad source\");const m=src.match(/const APP_VERSION\\s*=\\s*\"([^\"]+)\"/);if(!m)throw new Error(\"No version\");const v=m[1];if(cmp(v,APP_VERSION)<=0)return{ok:true,text:`${tx(s,\"current\")} v${APP_VERSION}`};const a=new Alert();a.title=APP_NAME;a.message=`${tx(s,\"available\")}: v${v}`;a.addAction(tx(s,\"apply\"));a.addCancelAction(tx(s,\"cancel\"));if(await a.presentAlert()!==0)return{ok:true,text:`v${APP_VERSION} → v${v}`};const target=module.filename;if(!target)throw new Error(\"Current script path unavailable\");const cloud=FileManager.iCloud(),local=FileManager.local();let targetFm=local;if(cloud.fileExists(target)){targetFm=cloud;if(!cloud.isFileDownloaded(target))await cloud.downloadFileFromiCloud(target)}else if(!local.fileExists(target))throw new Error(\"Current script file not found\");const backup=target.replace(/(\\.js|,js)$/i,`_backup_v${APP_VERSION}.js`);try{targetFm.writeString(backup,targetFm.readString(target))}catch(_){}targetFm.writeString(target,src);return{ok:true,text:`${tx(s,\"updated\")} v${v}`}}catch(e){return{ok:false,text:`${tx(s,\"updateFailed\")} ${String(e?.message||e)}`}}}\n\nlet SETTINGS=await firstLanguage(loadSettings());\nconst TAP_FAMILY=[\"small\",\"medium\"].includes(String(args.queryParameters?.sportsLiveFamily||\"\"))?String(args.queryParameters.sportsLiveFamily):\"medium\";\nif(config.runsInWidget){await widget(SETTINGS,config.widgetFamily||\"medium\")}else{try{await widget(SETTINGS,TAP_FAMILY)}catch(e){console.log(e)}await settings(SETTINGS)}\nScript.complete();\n",
  "share_sheet_inputs": []
}