  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: deep-blue; icon-glyph: trophy;\n// ============================================================\n// Sports Info v2.4.0\n// CaseyCZ Scriptable Apps\n// Own implementation inspired by the LockScreen Generator template.\n// One runtime JS file. Public multi-sport data. No personal API key required.\n// ============================================================\n\nconst APP_NAME = \"Sports Info\";\nconst APP_VERSION = \"2.4.0\";\nconst SETTINGS_FILE = \"SportsInfo_settings.json\";\nconst LEGACY_SETTINGS_FILE = \"FootballInfo_settings.json\";\nconst CACHE_FILE = \"SportsInfo_cache.json\";\nconst API_TIMEOUT = 7;\nconst UPDATE_SOURCE_URL = \"https://raw.githubusercontent.com/CaseyCZ/Scriptable/Master/apps/Sports-Info/Sports%20Info.js\";\nconst UPDATE_MIN_BYTES = 24000;\n\nconst SPORTS = [\n  {id:\"football\",icon:\"⚽\",cs:\"Fotbal\",en:\"Football\",de:\"Fußball\",es:\"Fútbol\",leagues:[\n    {id:\"cze.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"cze.1\",fm:122,ccode:\"CZE\",flag:\"🇨🇿\",cs:\"Chance Liga\",en:\"Czech First League\",de:\"Tschechische Liga\",es:\"Liga Checa\"},\n    {id:\"eng.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"eng.1\",fm:47,ccode:\"ENG\",flag:\"🇬🇧\",cs:\"Premier League\",en:\"Premier League\",de:\"Premier League\",es:\"Premier League\"},\n    {id:\"esp.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"esp.1\",fm:87,ccode:\"ESP\",flag:\"🇪🇸\",cs:\"LaLiga\",en:\"LaLiga\",de:\"LaLiga\",es:\"LaLiga\"},\n    {id:\"ger.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"ger.1\",fm:54,ccode:\"GER\",flag:\"🇩🇪\",cs:\"Bundesliga\",en:\"Bundesliga\",de:\"Bundesliga\",es:\"Bundesliga\"},\n    {id:\"ita.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"ita.1\",fm:55,ccode:\"ITA\",flag:\"🇮🇹\",cs:\"Serie A\",en:\"Serie A\",de:\"Serie A\",es:\"Serie A\"},\n    {id:\"fra.1\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"fra.1\",fm:53,ccode:\"FRA\",flag:\"🇫🇷\",cs:\"Ligue 1\",en:\"Ligue 1\",de:\"Ligue 1\",es:\"Ligue 1\"},\n    {id:\"uefa.champions\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"uefa.champions\",fm:42,ccode:\"INT\",flag:\"🇪🇺\",cs:\"Liga mistrů\",en:\"Champions League\",de:\"Champions League\",es:\"Champions League\"},\n    {id:\"uefa.europa\",provider:\"soccer\",espnSport:\"soccer\",espnLeague:\"uefa.europa\",fm:73,ccode:\"INT\",flag:\"🇪🇺\",cs:\"Evropská liga\",en:\"Europa League\",de:\"Europa League\",es:\"Europa League\"}\n  ]},\n  {id:\"hockey\",icon:\"🏒\",cs:\"Hokej\",en:\"Hockey\",de:\"Eishockey\",es:\"Hockey\",leagues:[\n    {id:\"nhl\",provider:\"espn\",espnSport:\"hockey\",espnLeague:\"nhl\",flag:\"🇺🇸\",cs:\"NHL\",en:\"NHL\",de:\"NHL\",es:\"NHL\"},\n    {id:\"hockey.cz\",provider:\"livesport\",lsPath:\"/hockey/czech-republic/extraliga/\",flag:\"🇨🇿\",cs:\"Tipsport Extraliga\",en:\"Czech Extraliga\",de:\"Tschechische Extraliga\",es:\"Extraliga Checa\"},\n    {id:\"hockey.se\",provider:\"livesport\",lsPath:\"/hockey/sweden/shl/\",flag:\"🇸🇪\",cs:\"SHL\",en:\"SHL\",de:\"SHL\",es:\"SHL\"},\n    {id:\"hockey.fi\",provider:\"livesport\",lsPath:\"/hockey/finland/liiga/\",flag:\"🇫🇮\",cs:\"Liiga\",en:\"Liiga\",de:\"Liiga\",es:\"Liiga\"},\n    {id:\"hockey.ch\",provider:\"livesport\",lsPath:\"/hockey/switzerland/national-league/\",flag:\"🇨🇭\",cs:\"National League\",en:\"National League\",de:\"National League\",es:\"National League\"},\n    {id:\"hockey.chl\",provider:\"livesport\",lsPath:\"/hockey/europe/champions-league/\",flag:\"🇪🇺\",cs:\"Champions Hockey League\",en:\"Champions Hockey League\",de:\"Champions Hockey League\",es:\"Champions Hockey League\"},\n    {id:\"hockey.wc\",provider:\"livesport\",lsPath:\"/hockey/world/world-championship/\",flag:\"🌍\",cs:\"Mistrovství světa\",en:\"World Championship\",de:\"Weltmeisterschaft\",es:\"Mundial\"},\n    {id:\"ncaa-hockey-men\",provider:\"espn\",espnSport:\"hockey\",espnLeague:\"mens-college-hockey\",flag:\"🇺🇸\",cs:\"NCAA muži\",en:\"NCAA Men\",de:\"NCAA Männer\",es:\"NCAA Hombres\"},\n    {id:\"ncaa-hockey-women\",provider:\"espn\",espnSport:\"hockey\",espnLeague:\"womens-college-hockey\",flag:\"🇺🇸\",cs:\"NCAA ženy\",en:\"NCAA Women\",de:\"NCAA Frauen\",es:\"NCAA Mujeres\"}\n  ]},\n  {id:\"basketball\",icon:\"🏀\",cs:\"Basketbal\",en:\"Basketball\",de:\"Basketball\",es:\"Baloncesto\",leagues:[\n    {id:\"nba\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"nba\",flag:\"🇺🇸\",cs:\"NBA\",en:\"NBA\",de:\"NBA\",es:\"NBA\"},\n    {id:\"wnba\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"wnba\",flag:\"🇺🇸\",cs:\"WNBA\",en:\"WNBA\",de:\"WNBA\",es:\"WNBA\"},\n    {id:\"basketball.euroleague\",provider:\"livesport\",lsPath:\"/basketball/europe/euroleague/\",flag:\"🇪🇺\",cs:\"EuroLeague\",en:\"EuroLeague\",de:\"EuroLeague\",es:\"EuroLeague\"},\n    {id:\"basketball.eurocup\",provider:\"livesport\",lsPath:\"/basketball/europe/eurocup/\",flag:\"🇪🇺\",cs:\"EuroCup\",en:\"EuroCup\",de:\"EuroCup\",es:\"EuroCup\"},\n    {id:\"basketball.cz\",provider:\"livesport\",lsPath:\"/basketball/czech-republic/nbl/\",flag:\"🇨🇿\",cs:\"NBL\",en:\"Czech NBL\",de:\"Tschechische NBL\",es:\"NBL Checa\"},\n    {id:\"basketball.es\",provider:\"livesport\",lsPath:\"/basketball/spain/acb/\",flag:\"🇪🇸\",cs:\"ACB\",en:\"ACB\",de:\"ACB\",es:\"ACB\"},\n    {id:\"basketball.de\",provider:\"livesport\",lsPath:\"/basketball/germany/bbl/\",flag:\"🇩🇪\",cs:\"BBL\",en:\"BBL\",de:\"BBL\",es:\"BBL\"},\n    {id:\"basketball.fr\",provider:\"livesport\",lsPath:\"/basketball/france/lnb/\",flag:\"🇫🇷\",cs:\"LNB\",en:\"LNB\",de:\"LNB\",es:\"LNB\"},\n    {id:\"ncaa-basketball-men\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"mens-college-basketball\",flag:\"🇺🇸\",cs:\"NCAA muži\",en:\"NCAA Men\",de:\"NCAA Männer\",es:\"NCAA Hombres\"},\n    {id:\"ncaa-basketball-women\",provider:\"espn\",espnSport:\"basketball\",espnLeague:\"womens-college-basketball\",flag:\"🇺🇸\",cs:\"NCAA ženy\",en:\"NCAA Women\",de:\"NCAA Frauen\",es:\"NCAA Mujeres\"}\n  ]},\n  {id:\"floorball\",icon:\"🥅\",cs:\"Florbal\",en:\"Floorball\",de:\"Floorball\",es:\"Floorball\",leagues:[\n    {id:\"floorball.cz\",provider:\"livesport\",lsPath:\"/floorball/czech-republic/livesport-superliga/\",flag:\"🇨🇿\",cs:\"Livesport Superliga\",en:\"Czech Livesport Superliga\",de:\"Tschechische Livesport Superliga\",es:\"Livesport Superliga Checa\"},\n    {id:\"floorball.se\",provider:\"livesport\",lsPath:\"/floorball/sweden/svenska-superligan/\",flag:\"🇸🇪\",cs:\"Svenska Superligan\",en:\"Swedish SSL\",de:\"Swedish SSL\",es:\"Swedish SSL\"},\n    {id:\"floorball.fi\",provider:\"livesport\",lsPath:\"/floorball/finland/f-liiga/\",flag:\"🇫🇮\",cs:\"F-liiga\",en:\"F-liiga\",de:\"F-liiga\",es:\"F-liiga\"},\n    {id:\"floorball.ch\",provider:\"livesport\",lsPath:\"/floorball/switzerland/prime-league/\",flag:\"🇨🇭\",cs:\"Swiss Prime League\",en:\"Swiss Prime League\",de:\"Swiss Prime League\",es:\"Swiss Prime League\"},\n    {id:\"floorball.wfc\",provider:\"livesport\",lsPath:\"/floorball/world/world-championship/\",flag:\"🌍\",cs:\"Mistrovství světa IFF\",en:\"IFF World Championship\",de:\"IFF Weltmeisterschaft\",es:\"Mundial IFF\"}\n  ]},\n  {id:\"baseball\",icon:\"⚾\",cs:\"Baseball\",en:\"Baseball\",de:\"Baseball\",es:\"Béisbol\",leagues:[\n    {id:\"mlb\",provider:\"espn\",espnSport:\"baseball\",espnLeague:\"mlb\",flag:\"🇺🇸\",cs:\"MLB\",en:\"MLB\",de:\"MLB\",es:\"MLB\"},\n    {id:\"baseball.cz\",provider:\"livesport\",lsPath:\"/baseball/czech-republic/extraliga/\",flag:\"🇨🇿\",cs:\"Extraliga\",en:\"Czech Extraliga\",de:\"Tschechische Extraliga\",es:\"Extraliga Checa\"},\n    {id:\"baseball.jp\",provider:\"livesport\",lsPath:\"/baseball/japan/npb/\",flag:\"🇯🇵\",cs:\"NPB\",en:\"NPB\",de:\"NPB\",es:\"NPB\"},\n    {id:\"baseball.kr\",provider:\"livesport\",lsPath:\"/baseball/south-korea/kbo/\",flag:\"🇰🇷\",cs:\"KBO\",en:\"KBO\",de:\"KBO\",es:\"KBO\"},\n    {id:\"baseball.mx\",provider:\"livesport\",lsPath:\"/baseball/mexico/lmb/\",flag:\"🇲🇽\",cs:\"LMB\",en:\"LMB\",de:\"LMB\",es:\"LMB\"},\n    {id:\"ncaa-baseball\",provider:\"espn\",espnSport:\"baseball\",espnLeague:\"college-baseball\",flag:\"🇺🇸\",cs:\"NCAA Baseball\",en:\"NCAA Baseball\",de:\"NCAA Baseball\",es:\"NCAA Baseball\"}\n  ]}\n];\n\nconst T = {\n  cs:{settings:\"Nastavení\",subtitle:\"Jeden widget pro více sportů – tým, live stav, výsledky, program, tabulka a forma.\",saved:\"Nastavení se ukládá automaticky.\",preview:\"Náhled widgetu\",previewHint:\"Tlačítka otevřou skutečný náhled Small / Medium / Large. Velikost widgetu na ploše určuje iOS při přidání widgetu.\",small:\"Small\",medium:\"Medium\",large:\"Large\",sport:\"Sport\",competition:\"Soutěž\",team:\"Oblíbený tým\",allTeams:\"Celá soutěž\",loadTeams:\"Načíst týmy\",content:\"Obsah\",live:\"Live stav\",last:\"Poslední zápasy\",next:\"Příští zápasy\",table:\"Tabulka\",form:\"Forma\",logos:\"Loga týmů\",count:\"Počet zápasů\",appearance:\"Vzhled\",theme:\"Motiv\",auto:\"Automatický\",dark:\"Tmavý\",light:\"Světlý\",accent:\"Akcent\",compact:\"Kompaktní režim\",refresh:\"Obnova widgetu\",tools:\"Nástroje\",api:\"API a zdroje\",apiSub:\"Výchozí zdroje fungují bez vlastního API klíče. Endpointy můžeš změnit pro testování nebo vlastní proxy.\",noKey:\"Bez vlastního API klíče\",diagnostics:\"Diagnostika\",diagnosticsSub:\"Kontrola vybraného zdroje, týmů, tabulky a lokální cache. Nastavení se otevře i když API nefunguje.\",maintenance:\"Záloha a údržba\",source:\"Zdroj dat\",sourceInfo:\"ESPN + FotMob pro fotbal, ESPN pro hokej/basketbal/baseball a Livesport pro florbal. SportsAPI Pro je jen volitelná záloha. Vše fail-open s cache.\",loading:\"Načítám…\",checking:\"Kontroluji…\",ok:\"V pořádku\",error:\"Chyba\",cache:\"CACHE\",liveNow:\"ŽIVĚ\",today:\"DNES\",tomorrow:\"ZÍTRA\",yesterday:\"VČERA\",lastTitle:\"Poslední\",nextTitle:\"Příští\",standings:\"Tabulka\",formTitle:\"Forma\",played:\"Z\",points:\"B\",updated:\"Aktualizováno\",noData:\"Pro zvolený výběr nejsou aktuálně zápasy.\",apiWorks:\"Zdroj odpovídá.\",apiFails:\"Zdroj momentálně neodpovídá. Nastavení funguje dál.\",teamsLoaded:\"Týmy načteny.\",teamsFail:\"Týmy se nepodařilo načíst.\",export:\"Exportovat\",import:\"Importovat\",clearCache:\"Vymazat cache\",resetAppearance:\"Obnovit vzhled\",resetSport:\"Obnovit sport a tým\",resetAll:\"Obnovit vše\",copied:\"Nastavení bylo zkopírováno.\",imported:\"Nastavení importováno.\",invalid:\"Neplatný JSON.\",resetDone:\"Nastavení obnoveno.\",cacheCleared:\"Cache byla vymazána.\",current:\"Používáš aktuální verzi.\",available:\"Je dostupná verze\",apply:\"Aktualizovat\",cancel:\"Zrušit\",updatedOk:\"Aktualizováno. Spusť skript znovu.\",updateFail:\"Aktualizace se nepodařila.\",noTeam:\"Bez vybraného týmu\",back:\"Zpět\",provider:\"Poskytovatel\",customEndpoints:\"Pokročilé endpointy\",espn:\"ESPN\",fotmob:\"FotMob\",sofascore:\"SofaScore\",runDiagnostics:\"Spustit diagnostiku\",diagSource:\"Vybraný zdroj\",diagTeams:\"Načtení týmů\",diagTable:\"Načtení tabulky\",diagCache:\"Lokální cache\",selectHint:\"Po změně sportu nebo soutěže se seznam týmů načte až na vyžádání.\"},\n  en:{settings:\"Settings\",subtitle:\"One widget for multiple sports – team, live state, results, fixtures, standings and form.\",saved:\"Settings save automatically.\",preview:\"Widget preview\",previewHint:\"Buttons open the real Small / Medium / Large preview. The Home Screen widget size is chosen by iOS when adding the widget.\",small:\"Small\",medium:\"Medium\",large:\"Large\",sport:\"Sport\",competition:\"Competition\",team:\"Favorite team\",allTeams:\"Whole competition\",loadTeams:\"Load teams\",content:\"Content\",live:\"Live state\",last:\"Previous matches\",next:\"Upcoming matches\",table:\"Standings\",form:\"Form\",logos:\"Team logos\",count:\"Matches to show\",appearance:\"Appearance\",theme:\"Theme\",auto:\"Automatic\",dark:\"Dark\",light:\"Light\",accent:\"Accent\",compact:\"Compact mode\",refresh:\"Widget refresh\",tools:\"Tools\",api:\"APIs & sources\",apiSub:\"Default sources work without personal API keys. Endpoints can be changed for testing or a personal proxy.\",noKey:\"No personal API key\",diagnostics:\"Diagnostics\",diagnosticsSub:\"Checks the selected source, team loading, standings and local cache. Settings still open when an API is down.\",maintenance:\"Backup & maintenance\",source:\"Data source\",sourceInfo:\"ESPN + FotMob for football, ESPN for hockey/basketball/baseball and Livesport for floorball. SportsAPI Pro is an optional fallback. Fail-open with cache.\",loading:\"Loading…\",checking:\"Checking…\",ok:\"OK\",error:\"Error\",cache:\"CACHE\",liveNow:\"LIVE\",today:\"TODAY\",tomorrow:\"TOMORROW\",yesterday:\"YESTERDAY\",lastTitle:\"Previous\",nextTitle:\"Upcoming\",standings:\"Standings\",formTitle:\"Form\",played:\"P\",points:\"PTS\",updated:\"Updated\",noData:\"There are currently no matches for this selection.\",apiWorks:\"Data source is responding.\",apiFails:\"Data source is currently unavailable. Settings still work.\",teamsLoaded:\"Teams loaded.\",teamsFail:\"Could not load teams.\",export:\"Export\",import:\"Import\",clearCache:\"Clear cache\",resetAppearance:\"Reset appearance\",resetSport:\"Reset sport & team\",resetAll:\"Reset everything\",copied:\"Settings copied.\",imported:\"Settings imported.\",invalid:\"Invalid JSON.\",resetDone:\"Settings reset.\",cacheCleared:\"Cache cleared.\",current:\"You are using the latest version.\",available:\"Version available\",apply:\"Update\",cancel:\"Cancel\",updatedOk:\"Updated. Run the script again.\",updateFail:\"Update failed.\",noTeam:\"No favorite team\",back:\"Back\",provider:\"Provider\",customEndpoints:\"Advanced endpoints\",espn:\"ESPN\",fotmob:\"FotMob\",sofascore:\"SofaScore\",runDiagnostics:\"Run diagnostics\",diagSource:\"Selected source\",diagTeams:\"Team loading\",diagTable:\"Standings loading\",diagCache:\"Local cache\",selectHint:\"After changing sport or competition, load the team list on demand.\"},\n  de:{settings:\"Einstellungen\",subtitle:\"Ein Widget für mehrere Sportarten – Team, Live-Status, Ergebnisse, Spiele, Tabelle und Form.\",saved:\"Einstellungen werden automatisch gespeichert.\",preview:\"Widget-Vorschau\",previewHint:\"Die Tasten öffnen echte Small / Medium / Large Vorschauen. Die Größe auf dem Home-Bildschirm wird beim Hinzufügen in iOS gewählt.\",small:\"Small\",medium:\"Medium\",large:\"Large\",sport:\"Sport\",competition:\"Wettbewerb\",team:\"Lieblingsteam\",allTeams:\"Gesamter Wettbewerb\",loadTeams:\"Teams laden\",content:\"Inhalt\",live:\"Live-Status\",last:\"Letzte Spiele\",next:\"Nächste Spiele\",table:\"Tabelle\",form:\"Form\",logos:\"Teamlogos\",count:\"Anzahl Spiele\",appearance:\"Darstellung\",theme:\"Design\",auto:\"Automatisch\",dark:\"Dunkel\",light:\"Hell\",accent:\"Akzent\",compact:\"Kompaktmodus\",refresh:\"Widget-Aktualisierung\",tools:\"Werkzeuge\",api:\"APIs & Quellen\",apiSub:\"Standardquellen funktionieren ohne eigenen API-Schlüssel.\",noKey:\"Kein eigener API-Schlüssel\",diagnostics:\"Diagnose\",diagnosticsSub:\"Prüft Quelle, Teams, Tabelle und Cache. Einstellungen öffnen auch bei API-Ausfall.\",maintenance:\"Sicherung & Wartung\",source:\"Datenquelle\",sourceInfo:\"ESPN + FotMob für Fußball, ESPN für Hockey/Basketball/Baseball und Livesport für Floorball. SportsAPI Pro ist optionaler Fallback.\",loading:\"Lade…\",checking:\"Prüfe…\",ok:\"OK\",error:\"Fehler\",cache:\"CACHE\",liveNow:\"LIVE\",today:\"HEUTE\",tomorrow:\"MORGEN\",yesterday:\"GESTERN\",lastTitle:\"Letzte\",nextTitle:\"Nächste\",standings:\"Tabelle\",formTitle:\"Form\",played:\"Sp\",points:\"Pkt\",updated:\"Aktualisiert\",noData:\"Für diese Auswahl gibt es aktuell keine Spiele.\",apiWorks:\"Datenquelle antwortet.\",apiFails:\"Datenquelle ist momentan nicht erreichbar. Einstellungen funktionieren weiter.\",teamsLoaded:\"Teams geladen.\",teamsFail:\"Teams konnten nicht geladen werden.\",export:\"Exportieren\",import:\"Importieren\",clearCache:\"Cache leeren\",resetAppearance:\"Darstellung zurücksetzen\",resetSport:\"Sport & Team zurücksetzen\",resetAll:\"Alles zurücksetzen\",copied:\"Einstellungen kopiert.\",imported:\"Einstellungen importiert.\",invalid:\"Ungültiges JSON.\",resetDone:\"Einstellungen zurückgesetzt.\",cacheCleared:\"Cache geleert.\",current:\"Aktuelle Version wird verwendet.\",available:\"Verfügbare Version\",apply:\"Aktualisieren\",cancel:\"Abbrechen\",updatedOk:\"Aktualisiert. Skript neu starten.\",updateFail:\"Aktualisierung fehlgeschlagen.\",noTeam:\"Kein Lieblingsteam\",back:\"Zurück\",provider:\"Anbieter\",customEndpoints:\"Erweiterte Endpunkte\",espn:\"ESPN\",fotmob:\"FotMob\",sofascore:\"SofaScore\",runDiagnostics:\"Diagnose starten\",diagSource:\"Ausgewählte Quelle\",diagTeams:\"Teams laden\",diagTable:\"Tabelle laden\",diagCache:\"Lokaler Cache\",selectHint:\"Nach Sport- oder Wettbewerbswechsel Teams bei Bedarf laden.\"},\n  es:{settings:\"Ajustes\",subtitle:\"Un widget para varios deportes: equipo, directo, resultados, próximos partidos, clasificación y forma.\",saved:\"Los ajustes se guardan automáticamente.\",preview:\"Vista previa\",previewHint:\"Los botones abren vistas previas Small / Medium / Large reales. El tamaño en la pantalla de inicio se elige al añadir el widget en iOS.\",small:\"Small\",medium:\"Medium\",large:\"Large\",sport:\"Deporte\",competition:\"Competición\",team:\"Equipo favorito\",allTeams:\"Toda la competición\",loadTeams:\"Cargar equipos\",content:\"Contenido\",live:\"Estado en directo\",last:\"Últimos partidos\",next:\"Próximos partidos\",table:\"Clasificación\",form:\"Forma\",logos:\"Logos de equipos\",count:\"Partidos a mostrar\",appearance:\"Apariencia\",theme:\"Tema\",auto:\"Automático\",dark:\"Oscuro\",light:\"Claro\",accent:\"Acento\",compact:\"Modo compacto\",refresh:\"Actualización\",tools:\"Herramientas\",api:\"APIs y fuentes\",apiSub:\"Las fuentes predeterminadas funcionan sin claves API personales.\",noKey:\"Sin clave API personal\",diagnostics:\"Diagnóstico\",diagnosticsSub:\"Comprueba la fuente, equipos, clasificación y caché. Los ajustes siguen abriendo si falla una API.\",maintenance:\"Copia y mantenimiento\",source:\"Fuente de datos\",sourceInfo:\"ESPN + FotMob para fútbol, ESPN para hockey/baloncesto/béisbol y Livesport para floorball. SportsAPI Pro es un respaldo opcional.\",loading:\"Cargando…\",checking:\"Comprobando…\",ok:\"OK\",error:\"Error\",cache:\"CACHE\",liveNow:\"EN DIRECTO\",today:\"HOY\",tomorrow:\"MAÑANA\",yesterday:\"AYER\",lastTitle:\"Últimos\",nextTitle:\"Próximos\",standings:\"Clasificación\",formTitle:\"Forma\",played:\"PJ\",points:\"PTS\",updated:\"Actualizado\",noData:\"No hay partidos actuales para esta selección.\",apiWorks:\"La fuente responde.\",apiFails:\"La fuente no responde ahora. Los ajustes siguen funcionando.\",teamsLoaded:\"Equipos cargados.\",teamsFail:\"No se pudieron cargar los equipos.\",export:\"Exportar\",import:\"Importar\",clearCache:\"Borrar caché\",resetAppearance:\"Restablecer apariencia\",resetSport:\"Restablecer deporte y equipo\",resetAll:\"Restablecer todo\",copied:\"Ajustes copiados.\",imported:\"Ajustes importados.\",invalid:\"JSON no válido.\",resetDone:\"Ajustes restablecidos.\",cacheCleared:\"Caché borrada.\",current:\"Ya usas la versión más reciente.\",available:\"Versión disponible\",apply:\"Actualizar\",cancel:\"Cancelar\",updatedOk:\"Actualizado. Ejecuta el script de nuevo.\",updateFail:\"Falló la actualización.\",noTeam:\"Sin equipo favorito\",back:\"Atrás\",provider:\"Proveedor\",customEndpoints:\"Endpoints avanzados\",espn:\"ESPN\",fotmob:\"FotMob\",sofascore:\"SofaScore\",runDiagnostics:\"Ejecutar diagnóstico\",diagSource:\"Fuente seleccionada\",diagTeams:\"Carga de equipos\",diagTable:\"Carga de clasificación\",diagCache:\"Caché local\",selectHint:\"Después de cambiar deporte o competición, carga la lista de equipos cuando la necesites.\"}\n };\n\nconst WIDGET_HELP={\n  cs:{widget:\"Nastavení widgetu\",widgetSub:\"Tady nastavíš, co se má ve widgetu zobrazit. Velikost Small / Medium / Large vybírá iOS; Sports Info obsah automaticky přizpůsobí.\",autoSize:\"Automaticky podle velikosti\",sizeGuide:\"Small: hlavní nebo živý zápas + forma. Medium: navíc další program. Large: navíc poslední výsledky a tabulka.\",liveTitle:\"Živé zápasy\",liveDetail:\"Když se právě hraje, zobrazí LIVE a aktuální skóre jako hlavní kartu.\",nextTitle:\"Další program\",nextDetail:\"Medium a Large: zobrazí další budoucí zápasy pod hlavní kartou.\",lastTitle:\"Poslední výsledky\",lastDetail:\"Pouze Large: zobrazí dokončené zápasy.\",tableTitle:\"Ligová tabulka\",tableDetail:\"Pouze Large. Bez oblíbeného týmu ukáže čelo tabulky; s týmem jeho okolí.\",formTitle:\"Forma oblíbeného týmu\",formDetail:\"W = výhra, D = remíza, L = prohra. Zobrazí se jen při výběru konkrétního týmu.\",logosTitle:\"Loga týmů\",logosDetail:\"Zobrazí klubová loga v hlavní kartě, pokud jsou dostupná.\",countTitle:\"Počet zápasů v seznamech\",countDetail:\"Large: maximum řádků programu a výsledků (1–8). Medium zobrazí nejvýše 2.\",recommended:\"Použít doporučené nastavení\",recommendedDone:\"Doporučené nastavení bylo použito.\",sportHelp:\"Nejdřív vyber sport a soutěž. Pokud chceš sledovat konkrétní klub, načti seznam týmů a vyber ho.\",teamHelp:\"Celá soutěž = widget sleduje ligu obecně. Konkrétní tým = zápasy, forma a tabulka se zaměří na něj.\",loadTeams:\"Načíst seznam týmů\",appearanceSub:\"Vzhled mění jen zobrazení widgetu, ne sportovní data.\",themeDetail:\"Automatický respektuje světlý nebo tmavý režim iOS.\",accentDetail:\"Barva zvýraznění oblíbeného týmu a stavů.\",compactDetail:\"Menší mezery a odsazení. Hodí se, když chceš do widgetu dostat více obsahu.\",refreshDetail:\"Za kolik minut má iOS nejdříve požádat o nová data. Doporučeno 15 minut; iOS může obnovit později.\",customTheme:\"Vlastní\",customColors:\"Vlastní barvy widgetu\",customColorsDetail:\"Použijí se pouze při motivu Vlastní.\",bgColor:\"Pozadí widgetu\",panelColor:\"Karta zápasu\",textColor:\"Hlavní text\",mutedColor:\"Vedlejší text\",liveColor:\"LIVE / prohra\",winColor:\"Výhra\",currentData:\"Aktuální\",nextMatch:\"Příští zápas\"},\n  en:{widget:\"Widget settings\",widgetSub:\"Choose what the widget should show. iOS chooses Small / Medium / Large; Sports Info adapts the content automatically.\",autoSize:\"Automatic by widget size\",sizeGuide:\"Small: main or live match + form. Medium: adds upcoming fixtures. Large: also adds previous results and standings.\",liveTitle:\"Live matches\",liveDetail:\"When a match is in progress, show LIVE and the current score as the main card.\",nextTitle:\"Upcoming fixtures\",nextDetail:\"Medium and Large: show more future matches below the main card.\",lastTitle:\"Previous results\",lastDetail:\"Large only: show completed matches.\",tableTitle:\"League standings\",tableDetail:\"Large only. With no favorite team show the top; with a team show rows around its position.\",formTitle:\"Favorite-team form\",formDetail:\"W = win, D = draw, L = loss. Shown only when a specific team is selected.\",logosTitle:\"Team logos\",logosDetail:\"Show club logos in the main match card when available.\",countTitle:\"Matches in lists\",countDetail:\"Large: maximum fixture/result rows (1–8). Medium shows at most 2.\",recommended:\"Use recommended settings\",recommendedDone:\"Recommended widget settings applied.\",sportHelp:\"Choose the sport and competition first. To follow one club, load the team list and select it.\",teamHelp:\"Whole competition = general league view. A specific team focuses matches, form and standings around that team.\",loadTeams:\"Load team list\",appearanceSub:\"Appearance changes how the widget looks, not the sports data.\",themeDetail:\"Automatic follows the iOS light/dark appearance.\",accentDetail:\"Highlight color for the favorite team and statuses.\",compactDetail:\"Smaller spacing and padding to fit more content.\",refreshDetail:\"Earliest requested data refresh interval. 15 minutes is recommended; iOS may refresh later.\",customTheme:\"Custom\",customColors:\"Custom widget colors\",customColorsDetail:\"Used only when Theme is Custom.\",bgColor:\"Widget background\",panelColor:\"Match card\",textColor:\"Primary text\",mutedColor:\"Secondary text\",liveColor:\"LIVE / loss\",winColor:\"Win\",currentData:\"Current\",nextMatch:\"Next match\"},\n  de:{widget:\"Widget-Einstellungen\",widgetSub:\"Lege fest, was das Widget zeigt. Small / Medium / Large wird von iOS gewählt; Sports Info passt den Inhalt automatisch an.\",autoSize:\"Automatisch nach Widget-Größe\",sizeGuide:\"Small: Haupt-/Live-Spiel + Form. Medium: zusätzlich nächste Spiele. Large: zusätzlich letzte Ergebnisse und Tabelle.\",liveTitle:\"Live-Spiele\",liveDetail:\"Bei laufendem Spiel LIVE und aktuellen Spielstand als Hauptkarte anzeigen.\",nextTitle:\"Nächste Spiele\",nextDetail:\"Medium und Large: weitere kommende Spiele unter der Hauptkarte.\",lastTitle:\"Letzte Ergebnisse\",lastDetail:\"Nur Large: abgeschlossene Spiele anzeigen.\",tableTitle:\"Ligatabelle\",tableDetail:\"Nur Large. Ohne Lieblingsteam Tabellenspitze, mit Team dessen Umgebung.\",formTitle:\"Form des Lieblingsteams\",formDetail:\"W = Sieg, D = Unentschieden, L = Niederlage. Nur bei ausgewähltem Team.\",logosTitle:\"Teamlogos\",logosDetail:\"Clublogos in der Hauptkarte anzeigen, wenn verfügbar.\",countTitle:\"Spiele in Listen\",countDetail:\"Large: maximale Zeilen für Spielplan/Ergebnisse (1–8). Medium höchstens 2.\",recommended:\"Empfohlene Einstellungen\",recommendedDone:\"Empfohlene Widget-Einstellungen angewendet.\",sportHelp:\"Zuerst Sport und Wettbewerb wählen. Für einen Club Teamliste laden und Team auswählen.\",teamHelp:\"Gesamter Wettbewerb = allgemeine Ligaansicht. Ein Team fokussiert Spiele, Form und Tabelle auf dieses Team.\",loadTeams:\"Teamliste laden\",appearanceSub:\"Darstellung ändert nur das Aussehen, nicht die Sportdaten.\",themeDetail:\"Automatisch folgt dem hellen/dunklen iOS-Modus.\",accentDetail:\"Akzentfarbe für Lieblingsteam und Status.\",compactDetail:\"Kleinere Abstände, damit mehr Inhalt passt.\",refreshDetail:\"Frühestes gewünschtes Aktualisierungsintervall. 15 Minuten empfohlen; iOS kann später aktualisieren.\",customTheme:\"Benutzerdefiniert\",customColors:\"Eigene Widget-Farben\",customColorsDetail:\"Nur beim Design Benutzerdefiniert verwendet.\",bgColor:\"Widget-Hintergrund\",panelColor:\"Spielkarte\",textColor:\"Haupttext\",mutedColor:\"Sekundärtext\",liveColor:\"LIVE / Niederlage\",winColor:\"Sieg\",currentData:\"Aktuell\",nextMatch:\"Nächstes Spiel\"},\n  es:{widget:\"Ajustes del widget\",widgetSub:\"Elige qué debe mostrar el widget. iOS elige Small / Medium / Large y Sports Info adapta el contenido automáticamente.\",autoSize:\"Automático según el tamaño\",sizeGuide:\"Small: partido principal/en directo + forma. Medium: añade próximos partidos. Large: añade resultados anteriores y clasificación.\",liveTitle:\"Partidos en directo\",liveDetail:\"Si hay un partido en juego, muestra DIRECTO y el marcador actual como tarjeta principal.\",nextTitle:\"Próximos partidos\",nextDetail:\"Medium y Large: muestran más partidos futuros debajo de la tarjeta principal.\",lastTitle:\"Últimos resultados\",lastDetail:\"Solo Large: muestra partidos finalizados.\",tableTitle:\"Clasificación\",tableDetail:\"Solo Large. Sin equipo favorito muestra la parte alta; con equipo muestra su zona.\",formTitle:\"Forma del equipo favorito\",formDetail:\"W = victoria, D = empate, L = derrota. Solo aparece con un equipo seleccionado.\",logosTitle:\"Logos de equipos\",logosDetail:\"Muestra logos en la tarjeta principal cuando estén disponibles.\",countTitle:\"Partidos en las listas\",countDetail:\"Large: máximo de filas de calendario/resultados (1–8). Medium muestra como máximo 2.\",recommended:\"Usar ajustes recomendados\",recommendedDone:\"Ajustes recomendados aplicados.\",sportHelp:\"Primero elige deporte y competición. Para seguir un club, carga la lista y selecciónalo.\",teamHelp:\"Toda la competición = vista general. Un equipo concreto centra partidos, forma y clasificación en él.\",loadTeams:\"Cargar lista de equipos\",appearanceSub:\"La apariencia solo cambia el aspecto, no los datos deportivos.\",themeDetail:\"Automático sigue el modo claro/oscuro de iOS.\",accentDetail:\"Color de resaltado del equipo favorito y estados.\",compactDetail:\"Menos espacio y márgenes para mostrar más contenido.\",refreshDetail:\"Intervalo mínimo solicitado para actualizar datos. Se recomiendan 15 minutos; iOS puede tardar más.\",customTheme:\"Personalizado\",customColors:\"Colores personalizados\",customColorsDetail:\"Solo se usan con el tema Personalizado.\",bgColor:\"Fondo del widget\",panelColor:\"Tarjeta del partido\",textColor:\"Texto principal\",mutedColor:\"Texto secundario\",liveColor:\"DIRECTO / derrota\",winColor:\"Victoria\",currentData:\"Actual\",nextMatch:\"Próximo partido\"}\n};\nfunction wh(s,k){const l=s.language||lang();return(WIDGET_HELP[l]||WIDGET_HELP.en)[k]||WIDGET_HELP.en[k]||k}\n\nconst DEFAULTS={language:null,sportId:\"football\",leagueId:\"cze.1\",teamId:\"\",teamName:\"\",showLive:true,showLast:true,showNext:true,showTable:true,showForm:true,showLogos:true,maxMatches:4,theme:\"auto\",accent:\"#38bdf8\",background:\"#0b1020\",panelColor:\"#111827\",textColor:\"#f8fafc\",mutedColor:\"#94a3b8\",liveColor:\"#f87171\",winColor:\"#86efac\",compact:false,refreshMinutes:15,apiEspnBase:\"https://site.api.espn.com\",apiFotmobBase:\"https://www.fotmob.com/api/data\",apiSofaBase:\"https://api.sofascore.com/api/v1\",apiSportsApiBase:\"https://v2.floorball.sportsapipro.com\",sportsApiKey:\"\"};\nconst fm=FileManager.local();\nconst settingsPath=fm.joinPath(fm.documentsDirectory(),SETTINGS_FILE);\nconst legacySettingsPath=fm.joinPath(fm.documentsDirectory(),LEGACY_SETTINGS_FILE);\nconst cachePath=fm.joinPath(fm.cacheDirectory(),CACHE_FILE);\nconst clone=o=>JSON.parse(JSON.stringify(o));\nconst clamp=(n,a,b)=>Math.max(a,Math.min(b,n));\nfunction lang(){const l=(Device.locale()||\"en\").slice(0,2).toLowerCase();return [\"cs\",\"en\",\"de\",\"es\"].includes(l)?l:\"en\"}\nfunction sport(s){return SPORTS.find(x=>x.id===s.sportId)||SPORTS[0]}\nfunction sportName(s){const x=sport(s),l=s.language||lang();return x[l]||x.en}\nfunction leaguesForSport(id){return(SPORTS.find(x=>x.id===id)||SPORTS[0]).leagues||[]}\nfunction league(s){const list=leaguesForSport(s.sportId);return list.find(x=>x.id===s.leagueId)||list[0]}\nfunction leagueName(s){const x=league(s),l=s.language||lang();return x?.[l]||x?.en||x?.id||\"\"}\nfunction merge(raw){const s=Object.assign(clone(DEFAULTS),raw||{});if(![\"cs\",\"en\",\"de\",\"es\"].includes(s.language))s.language=null;if(!SPORTS.some(x=>x.id===s.sportId))s.sportId=DEFAULTS.sportId;const ls=leaguesForSport(s.sportId);if(!ls.some(x=>x.id===s.leagueId))s.leagueId=ls[0]?.id||DEFAULTS.leagueId;s.maxMatches=clamp(Number(s.maxMatches)||4,1,8);s.refreshMinutes=clamp(Number(s.refreshMinutes)||15,5,60);if(![\"auto\",\"dark\",\"light\",\"custom\"].includes(s.theme))s.theme=\"auto\";for(const k of[\"accent\",\"background\",\"panelColor\",\"textColor\",\"mutedColor\",\"liveColor\",\"winColor\"])if(!/^#[0-9a-fA-F]{6}$/.test(String(s[k]||\"\")))s[k]=DEFAULTS[k];for(const k of[\"apiEspnBase\",\"apiFotmobBase\",\"apiSofaBase\",\"apiSportsApiBase\"])s[k]=String(s[k]||DEFAULTS[k]).replace(/\\/+$/,\"\");s.sportsApiKey=String(s.sportsApiKey||\"\").trim();return s}\nfunction loadSettings(){try{if(fm.fileExists(settingsPath))return merge(JSON.parse(fm.readString(settingsPath)));if(fm.fileExists(legacySettingsPath)){const x=merge(Object.assign({sportId:\"football\"},JSON.parse(fm.readString(legacySettingsPath))));saveSettings(x);return x}}catch(e){console.log(e)}return clone(DEFAULTS)}\nfunction saveSettings(s){try{fm.writeString(settingsPath,JSON.stringify(merge(s),null,2))}catch(e){console.log(e)}}\nfunction tx(s,k){const l=s.language||lang();return(T[l]||T.en)[k]||T.en[k]||k}\nasync function firstLanguage(s){if(s.language)return s;if(config.runsInWidget){s.language=lang();saveSettings(s);return s}const a=new Alert();a.title=APP_NAME;a.message=\"Choose language / Vyber jazyk\";[\"🇨🇿 Čeština\",\"🇬🇧 English\",\"🇩🇪 Deutsch\",\"🇪🇸 Español\"].forEach(x=>a.addAction(x));const i=await a.presentAlert();s.language=[\"cs\",\"en\",\"de\",\"es\"][Math.max(0,i)]||\"en\";saveSettings(s);return s}\n\nfunction dateKey(d){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,\"0\"),z=String(d.getDate()).padStart(2,\"0\");return `${y}${m}${z}`}\nfunction isoKey(d){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,\"0\"),z=String(d.getDate()).padStart(2,\"0\");return `${y}-${m}-${z}`}\nfunction range(a,b){const x=new Date(),y=new Date();x.setDate(x.getDate()+a);y.setDate(y.getDate()+b);return `${dateKey(x)}-${dateKey(y)}`}\nasync function requestJSON(url,headers=null){const r=new Request(url);r.timeoutInterval=API_TIMEOUT;if(headers)r.headers=headers;return await r.loadJSON()}\nasync function getString(url){const r=new Request(url);r.timeoutInterval=API_TIMEOUT;return await r.loadString()}\nconst BROWSER_HEADERS={\"User-Agent\":\"Mozilla/5.0 (iPhone; CPU iPhone OS like Mac OS X) AppleWebKit/605.1.15 Mobile/15E148\",\"Accept\":\"application/json\",\"Accept-Language\":\"en-US,en;q=0.9\"};\nfunction normEvent(e){try{const c=(e.competitions||[])[0]||{},arr=c.competitors||[],h=arr.find(x=>x.homeAway===\"home\")||arr[0]||{},a=arr.find(x=>x.homeAway===\"away\")||arr[1]||{},st=e.status?.type||{};const team=x=>({id:String(x.team?.id||\"\"),name:x.team?.displayName||x.team?.name||\"\",short:x.team?.shortDisplayName||x.team?.abbreviation||x.team?.displayName||\"\",abbr:x.team?.abbreviation||\"\",logo:x.team?.logo||\"\",score:x.score==null?\"\":String(x.score)});return{id:String(e.id||\"\"),date:e.date||c.date||\"\",state:st.state||\"\",completed:!!st.completed,status:st.shortDetail||st.detail||st.description||\"\",home:team(h),away:team(a)}}catch(_){return null}}\nfunction sourceLabel(s){const m=league(s);retur