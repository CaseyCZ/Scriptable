<script>
const UI=${JSON.stringify(L)},CATALOG=${JSON.stringify(SPORTS)},initial=${JSON.stringify(s)};let state={...initial},timer;window.__nativeQueue=[];function emit(action,p={}){window.__nativeQueue.push({action,...p,nonce:Date.now()+Math.random()})}function showScreen(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}function leagues(id){return(CATALOG.find(x=>x.id===id)||CATALOG[0]).leagues||[]}function collect(){const z={...state};const langEl=document.getElementById('languageSelect');if(langEl)z.language=langEl.value;for(const k of['sportId','leagueId','teamId','backgroundMode','backgroundColor','accent']){const e=document.getElementById(k);if(e)z[k]=e.value}const t=document.getElementById('teamId');if(t)z.teamName=t.value?(t.options[t.selectedIndex]?.text||''):'';for(const k of['showLive','showStats','showNext','homeFirst']){const e=document.getElementById(k);if(e)z[k]=e.checked}for(const k of['nextCount','refreshMinutes']){const e=document.getElementById(k);if(e)z[k]=Number(e.value)}return z}function commitNow(){clearTimeout(timer);state=collect();emit('save',{settings:state});return state}function save(){clearTimeout(timer);timer=setTimeout(commitNow,180)}function resetTeamSelect(){const t=document.getElementById('teamId');t.innerHTML='<option value="">'+UI.chooseTeam+'</option>';state.teamId='';state.teamName=''}function fillLeagues(){const sid=document.getElementById('sportId').value,l=document.getElementById('leagueId');l.innerHTML='';leagues(sid).forEach(x=>{const o=document.createElement('option');o.value=x.id;o.textContent=(x.flag||'')+' '+(x[initial.language]||x.en||x.id);l.appendChild(o)});resetTeamSelect();commitNow()}document.getElementById('sportId').addEventListener('change',fillLeagues);document.getElementById('leagueId').addEventListener('change',()=>{resetTeamSelect();commitNow()});document.getElementById('teamId').addEventListener('change',commitNow);document.querySelectorAll('input,select').forEach(x=>{if(['sportId','leagueId','teamId','languageSelect'].includes(x.id))return;x.addEventListener('change',commitNow);if(x.type==='number'||x.type==='color')x.addEventListener('input',save)});document.getElementById('languageSelect')?.addEventListener('change',e=>emit('language',{language:e.target.value,settings:{...collect(),language:e.target.value}}));document.querySelectorAll('#themeSeg button').forEach(b=>{if(b.dataset.v===state.theme)b.classList.add('active');b.addEventListener('click',()=>{document.querySelectorAll('#themeSeg button').forEach(x=>x.classList.remove('active'));b.classList.add('active');state.theme=b.dataset.v;emit('save',{settings:{...collect(),theme:state.theme}})})});function loadTeams(){document.getElementById('sourceStatus').textContent=UI.loading;emit('teams',{settings:collect()})}function preview(f){state=commitNow();document.querySelectorAll('.previewAction').forEach(b=>b.disabled=true);emit('preview',{family:f,settings:state})}function runDiagnostics(){document.getElementById('diagList').innerHTML='<div class="diagRow"><div class="diagTitle">'+UI.checking+'</div><span class="diagState">⏳</span></div>';emit('diagnostics',{settings:collect()})}function exportJSON(){emit('export',{settings:collect()})}function importJSON(){emit('import',{raw:document.getElementById('jsonBox').value})}function clearCache(){emit('clearCache',{})}function resetPart(part){emit('reset',{part,settings:collect()})}function pickImage(){emit('pickImage',{settings:collect()})}function clearImage(){emit('clearImage',{settings:collect()})}function requestUpdate(){document.getElementById('updateStatus').textContent=UI.checking;emit('update',{settings:collect()})}function renderDiag(rows){const e=document.getElementById('diagList');e.innerHTML='';(rows||[]).forEach(d=>{const r=document.createElement('div');r.className='diagRow';const l=document.createElement('div'),a=document.createElement('div'),b=document.createElement('div'),st=document.createElement('span');a.className='diagTitle';a.textContent=d.label||'';b.className='diagDetail';b.textContent=d.detail||'';l.append(a,b);st.className='diagState '+(d.ok?'ok':'error');st.textContent=d.ok?'● '+UI.ok:'● '+UI.error;r.append(l,st);e.appendChild(r)})}window.__native=function(m){if(!m)return;if(m.action==='teams'){const sel=document.getElementById('teamId'),old=state.teamId||'';sel.innerHTML='<option value="">'+UI.chooseTeam+'</option>';let matched=null;(m.teams||[]).forEach(t=>{const o=document.createElement('option');o.value=t.id;o.textContent=t.name;if(t.id===old||state.teamName===t.name){o.selected=true;matched=t}sel.appendChild(o)});if(matched){state.teamId=matched.id;state.teamName=matched.name}const e=document.getElementById('sourceStatus');e.textContent=m.ok?UI.teamsLoaded:UI.teamsFail;e.style.color=m.ok?'var(--ok)':'var(--danger)'}if(m.action==='previewDone')document.querySelectorAll('.previewAction').forEach(b=>b.disabled=false);if(m.action==='diagnostics')renderDiag(m.rows);if(m.action==='status'){const e=document.getElementById(m.target||'toolStatus');if(e){e.textContent=m.text||'';e.style.color=m.ok?'var(--ok)':'var(--danger)'}}if(m.action==='update'){const e=document.getElementById('updateStatus');e.textContent=m.text||'';e.style.color=m.ok?'var(--ok)':'var(--danger)'}if(m.action==='replace'){state=m.settings;location.reload()}};
