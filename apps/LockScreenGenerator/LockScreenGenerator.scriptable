  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: deep-purple; icon-glyph: magic;\n// ============================================================\n// LockScreenGenerator.js\n// Public iPhone Lock Screen wallpaper generator for Scriptable.\n// One-file distribution. Configure in Scriptable, automate with Shortcuts.\n// ============================================================\n\nconst APP_VERSION = \"2.9.5\";\nconst SETTINGS_FILE = \"LockScreenGenerator_settings.json\";\nconst OUTPUT_FILE = \"LockScreenWallpaper.png\";\nconst STEPS_FILE = \"LockScreenGenerator_steps.txt\";\nconst REFERENCE = { width: 1290, height: 2796 };\nconst CONFIG = { latitude: null, longitude: null, width: null, height: null };\nconst API_TIMEOUT = 5;\nconst UPDATE_SOURCE_URL = \"https://raw.githubusercontent.com/CaseyCZ/Scriptable/Master/apps/LockScreenGenerator/LockScreenGenerator.js\";\nconst UPDATE_MIN_BYTES = 20000;\n\nconst MODULES = {\n  events:{icon:\"📅\",showKey:\"showEvents\"}, reminders:{icon:\"✅\",showKey:\"showReminders\"}, weather:{icon:\"🌤\",showKey:\"showWeather\"},\n  weatherForecast:{icon:\"⛅\",showKey:\"showWeatherForecast\"}, nameday:{icon:\"🎂\",showKey:\"showNameDay\"}, f1:{icon:\"🏎\",showKey:\"showF1\"}, sports:{icon:\"🏆\",showKey:\"showSports\"},\n  quotes:{icon:\"💬\",showKey:\"showQuotes\"}, stocks:{icon:\"📈\",showKey:\"showStocks\"}, crypto:{icon:\"🪙\",showKey:\"showCrypto\"}, exchange:{icon:\"💱\",showKey:\"showExchangeRates\"},\n  notes:{icon:\"📝\",showKey:\"showCustomNotes\"}, countdown:{icon:\"⏳\",showKey:\"showCountdowns\"}, fitness:{icon:\"🏃\",showKey:\"showFitness\"}, news:{icon:\"📰\",showKey:\"showNews\"},\n  moon:{icon:\"🌙\",showKey:\"showMoonPhase\"}, worldclock:{icon:\"🌐\",showKey:\"showWorldClocks\"}, battery:{icon:\"🔋\",showKey:\"showBattery\"}, system:{icon:\"⚙️\",showKey:\"showSystemMetrics\"}\n};\n\nconst LOCALIZATION = {\n  cs:{today:\"DNES\",tomorrow:\"ZÍTRA\",noEvents:\"Žádné události\",nameDay:\"Svátek má\",battery:\"Baterie\",events:\"Události\",reminders:\"Připomínky\",weather:\"Počasí\",weatherForecast:\"Předpověď\",nameday:\"Jmeniny\",f1:\"Formula 1\",sports:\"Sport\",quotes:\"Citát\",stocks:\"Akcie\",crypto:\"Kryptoměny\",exchange:\"Kurzy\",notes:\"Poznámka\",countdown:\"Odpočet\",fitness:\"Aktivita\",news:\"Zprávy\",moon:\"Měsíc\",worldclock:\"Světový čas\",system:\"Systém\"},\n  en:{today:\"TODAY\",tomorrow:\"TOMORROW\",noEvents:\"No events\",nameDay:\"Name day\",battery:\"Battery\",events:\"Events\",reminders:\"Reminders\",weather:\"Weather\",weatherForecast:\"Forecast\",nameday:\"Name day\",f1:\"Formula 1\",sports:\"Sports\",quotes:\"Quote\",stocks:\"Stocks\",crypto:\"Crypto\",exchange:\"Exchange\",notes:\"Note\",countdown:\"Countdown\",fitness:\"Fitness\",news:\"News\",moon:\"Moon\",worldclock:\"World clocks\",system:\"System\"},\n  de:{today:\"HEUTE\",tomorrow:\"MORGEN\",noEvents:\"Keine Termine\",nameDay:\"Namenstag\",battery:\"Batterie\",events:\"Termine\",reminders:\"Erinnerungen\",weather:\"Wetter\",weatherForecast:\"Vorhersage\",nameday:\"Namenstag\",f1:\"Formel 1\",sports:\"Sport\",quotes:\"Zitat\",stocks:\"Aktien\",crypto:\"Krypto\",exchange:\"Wechselkurse\",notes:\"Notiz\",countdown:\"Countdown\",fitness:\"Fitness\",news:\"Nachrichten\",moon:\"Mond\",worldclock:\"Weltzeit\",system:\"System\"},\n  es:{today:\"HOY\",tomorrow:\"MAÑANA\",noEvents:\"Sin eventos\",nameDay:\"Santoral\",battery:\"Batería\",events:\"Eventos\",reminders:\"Recordatorios\",weather:\"Tiempo\",weatherForecast:\"Pronóstico\",nameday:\"Santoral\",f1:\"Fórmula 1\",sports:\"Deportes\",quotes:\"Cita\",stocks:\"Acciones\",crypto:\"Cripto\",exchange:\"Cambios\",notes:\"Nota\",countdown:\"Cuenta atrás\",fitness:\"Actividad\",news:\"Noticias\",moon:\"Luna\",worldclock:\"Reloj mundial\",system:\"Sistema\"}\n};\n\nconst UI = {\n  cs:{settings:\"Nastavení\",subtitle:\"Vyber si přesně, co chceš na zamykací obrazovce.\",saveHint:\"Po zavření se nastavení automaticky uloží.\",preview:\"Náhled tapety\",previewWorking:\"Generuji náhled…\",previewHint:\"Náhled používá aktuální změny, i když ještě nejsou uložené.\",closePreview:\"Zavřít náhled\",quick:\"Rychlé nastavení\",minimal:\"Minimal\",minimalD:\"Počasí, kalendář, baterie\",productivity:\"Produktivita\",productivityD:\"Kalendář, úkoly, počasí\",info:\"Informace\",infoD:\"Více dat, finance, zprávy\",all:\"Všechno\",allD:\"Zapne všechny moduly\",content:\"Obsah\",what:\"Co zobrazit\",modules:\"Moduly\",order:\"Pořadí\",calendarReminders:\"Kalendář a připomínky\",appearance:\"Vzhled\",layout:\"Layout\",automatic:\"Automatický\",manual:\"Ruční\",colorsFonts:\"Barvy a písmo\",textsLocalization:\"Texty a lokalizace\",weather:\"Počasí\",sport:\"Sport\",f1:\"Formula 1\",f1Sub:\"Samostatný modul – můžeš ho přesouvat nezávisle na kalendáři.\",f1Practice:\"Tréninky\",f1Qualifying:\"Kvalifikace\",f1Sprint:\"Sprint\",f1Race:\"Závod\",finance:\"Finance\",otherModules:\"Ostatní moduly\",tools:\"Nástroje\",diagnostics:\"Diagnostika\",diagnosticsSub:\"Stav oprávnění a online zdrojů při otevření nastavení.\",maintenance:\"Záloha a údržba\",whatSub:\"Každý modul můžeš zapnout nebo vypnout samostatně.\",orderSub:\"Pořadí určuje, kde se moduly na tapetě objeví.\",display:\"Zobrazení\",days:\"Dnů k zobrazení\",maxItems:\"Maximum položek na den\",hidePast:\"Skrýt ukončené události\",undatedToday:\"Úkoly bez data zobrazit dnes\",calendars:\"Kalendáře\",reminderLists:\"Seznamy připomínek\",noneCalendars:\"Žádné kalendáře nebyly nalezeny.\",noneReminders:\"Žádné seznamy připomínek nebyly nalezeny.\",responsiveInfo:\"Automatický layout přepočítá pozice, písmo, ikony a mezery podle skutečného rozlišení iPhonu.\",automation:\"Automatika\",adapt:\"Přizpůsobit jiným iPhonům\",compact:\"Kompaktní režim\",compactD:\"Menší mezery pro více obsahu\",autoFit:\"Automaticky vměstnat obsah\",autoFitD:\"Pokud obsah přetéká, skript zmenší text a rozestupy.\",minScale:\"Minimální měřítko Auto Fit\",scale:\"Celkové 